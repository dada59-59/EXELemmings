2497   1B80 8C 1B 40            br      @bdr_line
2498   1B83             bdr_newrow:
2499   1B83 B5                  clr     A                       ; rangee suivante : nouvelle tuile
2500   1B84 8B C4 C8            sta     @q_line
2501   1B87 8A C4 C7            lda     @q_row
2502   1B8A B3                  inc     A
2503   1B8B 8B C4 C7            sta     @q_row
2504   1B8E 8E 1B A4            call    @bg_resolve
2505   1B91 8C 1B 40            br      @bdr_line
2506   1B94             bdr_coldone:
2507   1B94 8A C4 0C            lda     @tmp_b
2508   1B97 B3                  inc     A
2509   1B98 8B C4 0C            sta     @tmp_b
2510   1B9B 8D C4 C4            cmpa    @r_wseg
2511   1B9E E2 03               jeq     @bdr_done
2512   1BA0 8C 1B 16            br      @bdr_col
2513   1BA3             bdr_done:
2514   1BA3 0A                  rets
2515   1BA4             
2516   1BA4             ; --- TEMP1 = adresse des octets de la ligne q_line de la tuile de la case
2517   1BA4             ; (colonne r_xseg+tmp_b, rangee q_row), couche creusee et tuiles posees
2518   1BA4             ; comprises. Commun a bg_draw_rect et bg_fill_buf.
2519   1BA4             bg_resolve:
2520   1BA4 8E 1A 24            call    @rect_tilebase
2521   1BA7 8A C4 0C            lda     @tmp_b
2522   1BAA 8E 1A 48            call    @rect_mapptr
2523   1BAD 8E 1A 81            call    @rect_tileptr
2524   1BB0 0A                  rets
2525   1BB1             
2526   1BB1             bg_fill_buf:
2527   1BB1                     ; --- meme principe que bg_draw_rect : par colonne, tuile resolue
2528   1BB1                     ; une fois par rangee, pointeurs en registres. Destination : lem_bg,
2529   1BB1                     ; ligne par ligne (r_wseg x 3 octets par ligne) -- inchange pour
2530   1BB1                     ; lem_draw. Avant : ~100 cycles PAR OCTET rien que pour tenir le
2531   1BB1                     ; pointeur de destination en SRAM.
2532   1BB1 8A C4 0E            lda     @cur_screen             ; idem : on ne compose qu'a l'ecran
2533   1BB4 8B C4 CA            sta     @map_screen
2534   1BB7 B5                  clr     A
2535   1BB8 8B C4 0C            sta     @tmp_b
2536   1BBB             bfb_col:
2537   1BBB 8E 18 11            call    @rect_rowline
2538   1BBE 72 C4 1D            mov     %lem_bg>>8,BG_PTR-1      ; destination = lem_bg + colonne*3
2539   1BC1 8A C4 0C            lda     @tmp_b
2540   1BC4 C0                  mov     A,B
2541   1BC5 68                  add     B,A
2542   1BC6 68                  add     B,A
2543   1BC7 28 D0               add     %lem_bg&$FF,A
2544   1BC9 E7 02               jnc     @bfb_dnc                ; retenue lue AVANT le MOV
2545   1BCB D3 1D               inc     BG_PTR-1
2546   1BCD             bfb_dnc:
2547   1BCD D0 1E               mov     A,BG_PTR
2548   1BCF 8E 1C 40            call    @bfb_resolve
2549   1BD2 8A C4 C6            lda     @r_hlines
2550   1BD5 8B C4 1C            sta     @ll_ctr
2551   1BD8             bfb_line:
2552   1BD8 9A 0E               lda     *TEMP1                  ; 3 plans de la ligne de tuile
2553   1BDA 9B 1E               sta     *BG_PTR
2554   1BDC D3 0E               inc     TEMP1
2555   1BDE 79 00 0D            adc     %0,TEMP1-1
2556   1BE1 D3 1E               inc     BG_PTR
2557   1BE3 79 00 1D            adc     %0,BG_PTR-1
2558   1BE6 9A 0E               lda     *TEMP1
2559   1BE8 9B 1E               sta     *BG_PTR
2560   1BEA D3 0E               inc     TEMP1
2561   1BEC 79 00 0D            adc     %0,TEMP1-1
2562   1BEF D3 1E               inc     BG_PTR
2563   1BF1 79 00 1D            adc     %0,BG_PTR-1
2564   1BF4 9A 0E               lda     *TEMP1
2565   1BF6 9B 1E               sta     *BG_PTR
2566   1BF8 D3 0E               inc     TEMP1
2567   1BFA 79 00 0D            adc     %0,TEMP1-1
2568   1BFD D3 1E               inc     BG_PTR
2569   1BFF 79 00 1D            adc     %0,BG_PTR-1
