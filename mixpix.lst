4205   26C6 8B C4 0D            sta     @tmp_c
4206   26C9             
4207   26C9             lsc_move:
4208   26C9                     ; --- il avance, et monte jusqu'a la hauteur calculee ci-dessus -----
4209   26C9 8A C4 C1            lda     @cur_lem
4210   26CC C0                  mov     A,B
4211   26CD AA C5 20            lda     @lem_xseg(B)
4212   26D0 AB C5 48            sta     @lem_old_xseg(B)
4213   26D3 8A C4 C1            lda     @cur_lem
4214   26D6 C0                  mov     A,B
