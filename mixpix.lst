0122+  6E85~            #IFDEF Fset_25LINE
0123+  6E85~            #DEFINE Fset_CM
0124+  6E85~            ; set the number of diplayed line to 25
0125+  6E85~            ; USED Mem :LINE_NUMBER
0126+  6E85~            ; DEPENDENCIES :set_CM
0127+  6E85~            set_25LINE
