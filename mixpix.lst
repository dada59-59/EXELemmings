0509+  6E85~            	btjo %$08,A,fin_wh
0510+  6E85~            	and %$FD,A
0511+  6E85             #ENDIF
0512+  6E85             
0513+  6E85~            #IFDEF Fset_wh
0514+  6E85~            set_wh	
0515+  6E85~            	sta @ATRCAR
0516+  6E85~            fin_wh
0517+  6E85~            	pop A	
