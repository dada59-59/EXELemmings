0519+  6E85             #ENDIF
0520+  6E85             	
0521+  6E85~            #IFDEF Fset_flash
0522+  6E85~            ; Inverse flash attribute character (XOR the FLASH flag of API)
0523+  6E85~            ; This is a flip-flop function.
0524+  6E85~            ; This function is compatible with alphanumeric generator only.
0525+  6E85~            ; USED Mem :ATRCAR
0526+  6E85~            	.module set_flash
0527+  6E85~            set_flash
0528+  6E85~            	push A
0529+  6E85~            	lda @FLASH
0530+  6E85~            	xor %$80,A
0531+  6E85~            	sta @FLASH
0532+  6E85~            _fin
0533+  6E85~            	pop A	
0534+  6E85~            	rets
0535+  6E85             #ENDIF
