1934   16A0             ; --- variables 16 bits pour draw_all_tiles (ajoutees ici, pas dans le
1935   16A0             ; bloc principal, pour rester pres de leur seul usage) ---------------------
1936   16A0             tv_hi           .equ    $C404
1937   16A0             tv_lo           .equ    $C405
1938   16A0             sv_hi           .equ    $C409           ; pointeur dans cur_save
1939   16A0             sv_lo           .equ    $C40A
