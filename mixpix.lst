1533+  6E85~            #IFDEF Ffill_invideo
1534+  6E85~            #DEFINE Fset_acmpacmpxy
1535+  6E85~            #DEFINE Fcalcul_pointer
1536+  6E85~            #DEFINE Ftest_draw
1537+  6E85~            ; inverse video a rectangular area of the active window
1538+  6E85~            ; The cursor position is not modified.
1539+  6E85~            ; Compatible with alphanumeric and R0lphamosaic generator.
1540+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
1541+  6E85~            ; USED Registers :TEMP2-1,TEMP3-1,TEMP3
1542+  6E85~            ; USED Mem :XSX,YSY
1543+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmacmpxy,test_draw
1544+  6E85~            	.module finvideo
1545+  6E85~            fill_invideo
1546+  6E85~            	push A
1547+  6E85~            	push B
1548+  6E85~            	call @test_draw
1549+  6E85~            	jc _fin
1550+  6E85~            	movd TEMP1,R1
1551+  6E85~            	call @calcul_pointer
1552+  6E85~            _rept1
1553+  6E85~            	movd TEMP3,R1
1554+  6E85~            	call @set_acmpacmpxy
1555+  6E85~            	mov TEMP2,B
1556+  6E85~            _rept2
1557+  6E85~            	lvdp
1558+  6E85~            	btjo %$08,A,_alphamosaic
1559+  6E85~            	xor %$04,A
1560+  6E85~            	jmp _write
1561+  6E85~            _alphamosaic
1562+  6E85~            	push B
1563+  6E85~            	mov A,B
1564+  6E85~            	push A
1565+  6E85~            	and %$18,A
1566+  6E85~            	rr B
1567+  6E85~            	rr B
1568+  6E85~            	rr B
1569+  6E85~            	and %$E0,B
1570+  6E85~            	or B,A
1571+  6E85~            	pop B
1572+  6E85~            	rl B
1573+  6E85~            	rl B
1574+  6E85~            	rl B
1575+  6E85~            	and %$7,B
1576+  6E85~            	or B,A
1577+  6E85~            	pop B	
1578+  6E85~            _write	
1579+  6E85~            	wvdp(A)
1580+  6E85~            	lvdp
1581+  6E85~            	wvdp(A)
1582+  6E85~            	djnz B,_rept2
1583+  6E85~            	add %LENGTHLINE,TEMP3
1584+  6E85~            	adc %0,TEMP3-1
1585+  6E85~            	djnz TEMP2-1,_rept1
1586+  6E85~            _fin
1587+  6E85~            	pop B
1588+  6E85~            	pop A
1589+  6E85~            	rets
1590+  6E85             #ENDIF
