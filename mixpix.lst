1276+  6E85~            ; All characters are displayed.
1277+  6E85~            ; The cursor position is not modified.
1278+  6E85~            ; IN :TEMP1 = string adr (terminated by a NULL value)
1279+  6E85~            ; USED Registers :TEMP1-1,TEMP1,TEMP2-1,TEMP2,TEMP4-1,TEMP4
1280+  6E85~            ; USED Mem :WINDOW_H,WINDOW_W,XSX,YSY,ATRCAR,FLASH
1281+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmpxy
1282+  6E85~            	.MODULE put_text
1283+  6E85~            put_text
1284+  6E85~            	push A
1285+  6E85~            	push B
1286+  6E85~            	lda @XSX
1287+  6E85~            	mov A,B
1288+  6E85~            	mov A,TEMP2
1289+  6E85~            	lda @YSY
1290+  6E85~            	call @calcul_pointer
1291+  6E85~            	call @set_acmpxy
1292+  6E85~            	lda @ATRCAR
1293+  6E85~            	mov A,TEMP4-1
1294+  6E85~            	lda @FLASH
1295+  6E85~            	mov A,TEMP4
1296+  6E85~            _rept1
1297+  6E85~            	lda *TEMP1
1298+  6E85~            	jz _end_string
1299+  6E85~            	cmp %32,A
1300+  6E85~            	jne _printing_car
1301+  6E85~            	clr A
1302+  6E85~            _printing_car
1303+  6E85~            	inc TEMP2
1304+  6E85~            	decd TEMP1
1305+  6E85~            	mov TEMP4-1,B
1306+  6E85~            	wvdp(B)
1307+  6E85~            	or TEMP4,A
1308+  6E85~            	wvdp(A)
1309+  6E85~            	lda @WINDOW_W
1310+  6E85~            	cmp TEMP2,A
1311+  6E85~            	jne _rept1
1312+  6E85~            _end_string
1313+  6E85~            	pop B
1314+  6E85~            	pop A
1315+  6E85~            	rets
1316+  6E85             #ENDIF
1317+  6E85             
1318+  6E85~            #IFDEF Fput_text2
