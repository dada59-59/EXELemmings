3900   2528 8B C4 C5            sta     @r_yline
3901   252B 22 0A               mov     %LEM_HLINES,A
3902   252D 8B C4 C6            sta     @r_hlines
3903   2530 8E 1F 5E            call    @bg_erase_if_visible    ; encore "alive" a cet instant, donc
3904   2533                                                     ; l'effacement a bien lieu
3905   2533 8A C4 C1            lda     @cur_lem
