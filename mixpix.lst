5319   2E5F 23 02               and     %EQUIP_CLIMB,A
5320   2E61 E2 01               jeq     @gc_new
5321   2E63 0A                  rets                            ; deja grimpeur
5322   2E64             gc_new:
5323   2E64 AA C6 BB            lda     @lem_float(B)
5324   2E67 24 02               or      %EQUIP_CLIMB,A
5325   2E69 AB C6 BB            sta     @lem_float(B)
5326   2E6C B5                  clr     A                       ; son sprite de marche change : on
5327   2E6D AB C5 34            sta     @lem_frame(B)           ; repart de la premiere vignette
5328   2E70 22 01               mov     %1,A
5329   2E72 8B C7 FB            sta     @give_ok
5330   2E75 0A                  rets
5331   2E76             
5332   2E76             ; --- un pas d'escalade. Le lemming reste dans son segment, face a la paroi
5333   2E76             ; (qui occupe le segment d'en face) :
5334   2E76             ;   1. plafond sur les CLIMB_STEP lignes au-dessus de sa tete (ou haut de
5335   2E76             ;      l'ecran) : il lache prise et retombe EN ARRIERE (demi-tour, puis la
