2014   16FD             ; ============================================================================
2015   16FD             ; VISEUR -- dessine PAR-DESSUS ce qui est deja a l'ecran
2016   16FD             ;
2017   16FD             ; Plus de fond sauvegarde : le viseur lit l'ecran tel qu'il est (P36), y
2018   16FD             ; ajoute son motif par un OU, et reecrit. Il passe donc toujours au-dessus
2019   16FD             ; du decor ET du lemming, sans avoir a les connaitre.
2020   16FD             ; Pour l'effacer, on regenere le decor puis on redessine le lemming --
2021   16FD             ; l'ancienne version recopiait a la place le fond qu'elle avait memorise,
2022   16FD             ; lequel contenait parfois des pixels de lemming : c'est ce qui laissait
2023   16FD             ; des morceaux de lemming derriere le viseur.
2024   16FD             ; ============================================================================
2025   16FD             
2026   16FD             ; --- efface le viseur : decor regenere, puis lemming par-dessus -----------
2027   16FD             cur_erase:
2028   16FD 8A C4 08            lda     @cur_dirty
2029   1700 E6 01               jne     @ce_go
2030   1702 0A                  rets
2031   1703             ce_go:
2032   1703 8A C4 06            lda     @cur_xseg
2033   1706 8B C4 C3            sta     @r_xseg
2034   1709 22 02               mov     %CUR_W_SEG,A
2035   170B 8B C4 C4            sta     @r_wseg
2036   170E 8A C4 07            lda     @cur_y
2037   1711 8B C4 C5            sta     @r_yline
2038   1714 22 10               mov     %CUR_H_LINES,A
2039   1716 8B C4 C6            sta     @r_hlines
2040   1719 8E 1B 0C            call    @bg_draw_rect
2041   171C             
2042   171C                     ; Chaque lemming n'est redessine que si la zone effacee le touche.
2043   171C                     ; Sans ce test, dix lemmings seraient redessines a chaque
2044   171C                     ; deplacement du viseur, meme a l'autre bout de l'ecran.
2045   171C B5                  clr     A
2046   171D 8B C4 C1            sta     @cur_lem
2047   1720             ce_loop:
2048   1720 8E 17 33            call    @ce_one
2049   1723 8A C4 C1            lda     @cur_lem
2050   1726 B3                  inc     A
2051   1727 8B C4 C1            sta     @cur_lem
2052   172A 2D 0A               cmp     %NUM_LEM,A
2053   172C E6 F2               jne     @ce_loop
2054   172E                     ; le viseur n'est plus a l'ecran : ml_next le redessinera. Evite
2055   172E                     ; aussi un second effacement inutile si la souris ET une fleche
2056   172E                     ; deplacent le viseur dans le meme passage (cur_erase ressort alors
2057   172E                     ; tout de suite, voir son test d'entree).
2058   172E B5                  clr     A
2059   172F 8B C4 08            sta     @cur_dirty
2060   1732 0A                  rets
2061   1733             
2062   1733             ; redessine le lemming cur_lem si son rectangle croise celui du viseur.
2063   1733             ; Deux rectangles se touchent SAUF si l'un est entierement a gauche, a
2064   1733             ; droite, au-dessus ou en dessous de l'autre. cmp/jc : C=1 quand A >= op.
2065   1733             ce_one:
2066   1733 8A C4 C1            lda     @cur_lem
2067   1736 C0                  mov     A,B
2068   1737 AA C5 52            lda     @lem_alive(B)
2069   173A E6 01               jne     @ceo_alive
2070   173C 0A                  rets
2071   173D             ceo_alive:
2072   173D                     ; MANQUAIT : sel_find (sfo_notdead) verifie l'ecran avant de comparer
2073   173D                     ; les coordonnees ; ce_one, lui, comparait directement -- un lemming
2074   173D                     ; sur un AUTRE ecran, mais partageant par coincidence des xseg/y
2075   173D                     ; proches de ceux du viseur, declenchait un redessin superflu (et
2076   173D                     ; potentiellement incorrect, compose contre le mauvais decor).
2077   173D 8A C4 C1            lda     @cur_lem
2078   1740 C0                  mov     A,B
2079   1741 AA C5 3E            lda     @lem_screen(B)
2080   1744 8D C4 0E            cmpa    @cur_screen
2081   1747 E2 01               jeq     @ceo_scr
2082   1749 0A                  rets
2083   174A             ceo_scr:
2084   174A 8A C4 C1            lda     @cur_lem
2085   174D C0                  mov     A,B
2086   174E AA C5 20            lda     @lem_xseg(B)
2087   1751 28 01               add     %LEM_WSEG,A
2088   1753 D0 14               mov     A,TEMP4
2089   1755 8A C4 06            lda     @cur_xseg
2090   1758 1D 14               cmp     TEMP4,A
2091   175A E7 01               jnc     @ceo_x2
2092   175C 0A                  rets                            ; viseur entierement a droite
2093   175D             ceo_x2:
2094   175D 8A C4 06            lda     @cur_xseg
