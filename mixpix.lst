5969   32ED             ; --- avance d'une vignette, sur le nombre REEL de vignettes du type courant
5970   32ED             ; (lem_nframes). Apres la derniere : retour a la premiere si le type BOUCLE,
5971   32ED             ; sinon on RESTE sur la derniere -- reglage "boucle / une seule fois"
5972   32ED             ; d'EXELLEM, jusqu'ici ignore (la gerbe d'explosion repassait par sa
5973   32ED             ; vignette 0 juste avant de disparaitre, et la mort se jouait deux fois).
5974   32ED             ; Ce reglage est le 3e octet de chaque definition lem_defN, emises a la
5975   32ED             ; suite l'une de l'autre par EXELLEM (nb vignettes, vitesse, boucle) :
5976   32ED             ; celle du type T commence donc a lem_def0 + 3*T.
5977   32ED             lem_anim_next:
5978   32ED 8E 33 27            call    @lem_sprite_type        ; le type DESSINE (variante comprise)
5979   32F0 C0                  mov     A,B
5980   32F1 AA 6E 4D            lda     @lem_nframes(B)
5981   32F4 D0 14               mov     A,TEMP4                 ; nb de vignettes de ce type
5982   32F6 62                  mov     B,A                     ; 3 * type : sa definition
5983   32F7 68                  add     B,A
5984   32F8 68                  add     B,A
5985   32F9 C0                  mov     A,B
5986   32FA AA 6C 54            lda     @lem_def0+2(B)          ; 1 = boucle, 0 = une seule fois
5987   32FD E6 0D               jne     @lan_loop
5988   32FF 8A C4 C1            lda     @cur_lem                ; une seule fois : avance tant qu'il
5989   3302 C0                  mov     A,B                     ; reste des vignettes...
5990   3303 AA C5 34            lda     @lem_frame(B)
5991   3306 B3                  inc     A
5992   3307 1D 14               cmp     TEMP4,A
5993   3309 E7 0E               jnc     @lan_ok                 ; jnc : encore dans la plage
5994   330B 0A                  rets                            ; ...puis reste sur la derniere
5995   330C             lan_loop:
5996   330C 8A C4 C1            lda     @cur_lem
5997   330F C0                  mov     A,B
5998   3310 AA C5 34            lda     @lem_frame(B)
5999   3313 B3                  inc     A
6000   3314 1D 14               cmp     TEMP4,A
6001   3316 E7 01               jnc     @lan_ok                 ; jnc : encore dans la plage
6002   3318 B5                  clr     A
6003   3319             lan_ok:
6004   3319 8B C4 0D            sta     @tmp_c
6005   331C 8A C4 C1            lda     @cur_lem
