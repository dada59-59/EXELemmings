1868+  6E85~            #IFDEF Freplace_car
1869+  6E85~            #DEFINE Fset_acmpacmpxy
1870+  6E85~            #DEFINE Fcalcul_pointer
1871+  6E85~            #DEFINE Ftest_draw
1872+  6E85~            ; replace in a rectangular area of the active window a character by another one
1873+  6E85~            ; The cursor position is not modified.
1874+  6E85~            ; Compatible with alphanumeric and R0lphamosaic generator.
1875+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
1876+  6E85~            ;			TEMP4-1 = old character (0-127), TEMP4 = new character (0 to 127)
1877+  6E85~            ; USED Registers :TEMP2-1,TEMP3-1,TEMP3
1878+  6E85~            ; USED Mem :XSX,YSY
1879+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmacmpxy,test_draw
1880+  6E85~            	.module rfcar
1881+  6E85~            replace_car
1882+  6E85~            	push A
1883+  6E85~            	push B
1884+  6E85~            	call @test_draw
1885+  6E85~            	jc _fin
1886+  6E85~            	movd TEMP1,R1
1887+  6E85~            	call @calcul_pointer
1888+  6E85~            _rept1
1889+  6E85~            	movd TEMP3,R1
1890+  6E85~            	call @set_acmpacmpxy
1891+  6E85~            	mov TEMP2,B
1892+  6E85~            _rept2
1893+  6E85~            	lvdp
1894+  6E85~            	wvdp(A)
1895+  6E85~            	lvdp
1896+  6E85~            	cmp TEMP4-1,A
1897+  6E85~            	jne _noreplace
1898+  6E85~            	mov TEMP4,A
1899+  6E85~            _noreplace	
1900+  6E85~            	wvdp(A)
1901+  6E85~            	djnz B,_rept2
1902+  6E85~            	add %LENGTHLINE,TEMP3
1903+  6E85~            	adc %0,TEMP3-1
1904+  6E85~            	djnz TEMP2-1,_rept1
1905+  6E85~            _fin
1906+  6E85~            	pop B
1907+  6E85~            	pop A
1908+  6E85~            	rets
1909+  6E85             #ENDIF
