5210   2DB6             ; sel_find -- cherche un lemming sous le viseur. Sortie : sel_lem = son
5211   2DB6             ; indice, ou $FF si aucun. On prend le PREMIER trouve ; deux lemmings
5212   2DB6             ; superposes ne sont pas departages.
5213   2DB6             ; ============================================================================
5214   2DB6             sel_find:
5215   2DB6 22 FF               mov     %$FF,A
5216   2DB8 8B C4 CF            sta     @sel_lem
5217   2DBB B5                  clr     A
