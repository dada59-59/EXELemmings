1175   128A             ml_chk_mouse:
1176   128A                     ; S : bascule la souris (comme dans exelnoid). Pas de repetition --
1177   128A                     ; maintenir la touche ne doit pas allumer/eteindre a chaque tick.
1178   128A 2D 53               cmp     %KEY_MOUSE,A
1179   128C E2 04               jeq     @ml_mouse_rpt
1180   128E 2D 73               cmp     %KEY_MOUSE_LC,A
1181   1290 E6 10               jne     @ml_chk_r
1182   1292             ml_mouse_rpt:
1183   1292 8A C5 17            lda     @rpt_flag
1184   1295 E6 38               jne     @ml_next
1185   1297 8A C7 E3            lda     @mouse_enabled
1186   129A 25 01               xor     %1,A
1187   129C 8B C7 E3            sta     @mouse_enabled
1188   129F 8C 12 CF            br      @ml_next
1189   12A2             
1190   12A2             ml_chk_r:
1191   12A2 8A C4 02            lda     @key_cur
1192   12A5                     ; R (ou espace) : passe a l'ecran SUIVANT de la carte et le redessine
1193   12A5                     ; entierement. Remplace l'ancien basculement de couleurs, qui n'a
1194   12A5                     ; plus lieu d'etre maintenant que le decor vient de la carte : le
1195   12A5                     ; changement d'ecran est a la fois visible et representatif du cas
1196   12A5                     ; reel qu'on veut chronometrer.
1197   12A5 2D 52               cmp     %KEY_REDRAW,A
1198   12A7 E2 04               jeq     @ml_chk_rpt
1199   12A9 2D 72               cmp     %KEY_REDRAW_LC,A
1200   12AB E6 22               jne     @ml_next                ; (Espace ne sert plus ici)
1201   12AD             ml_chk_rpt:
1202   12AD                     ; le changement d'ecran ne se repete pas : maintenir la touche
1203   12AD                     ; ferait defiler les ecrans sans qu'on puisse s'arreter
1204   12AD 8A C5 17            lda     @rpt_flag
1205   12B0 E2 03               jeq     @ml_redraw
1206   12B2 8C 12 CF            br      @ml_next
1207   12B5             ml_redraw:
1208   12B5 8A C4 0E            lda     @cur_screen
1209   12B8 B3                  inc     A
1210   12B9 8D C7 B0            cmpa    @cur_nscr               ; ecrans de CE niveau
1211   12BC E7 01               jnc     @ml_scr_ok              ; jnc : encore dans la carte
1212   12BE B5                  clr     A                       ; sinon on revient au premier ecran
1213   12BF             ml_scr_ok:
1214   12BF 8B C4 0E            sta     @cur_screen
1215   12C2 8E 15 A1            call    @draw_all_tiles
1216   12C5                     ; Le decor entier vient d'etre redessine : il a donc efface le
1217   12C5                     ; lemming et le viseur. On les remet, dans l'ordre voulu.
1218   12C5                     ; cur_dirty repasse a 0 : il n'y a plus de viseur a effacer a
1219   12C5                     ; l'ancienne position, elle a disparu avec le decor.
1220   12C5 B5                  clr     A
1221   12C6 8B C4 08            sta     @cur_dirty
1222   12C9 8E 33 74            call    @lem_draw_all
1223   12CC             ml_cur_redraw:
1224   12CC 8E 17 9A            call    @cur_draw               ; le viseur toujours en dernier
1225   12CF             ml_next:
1226   12CF                     ; --- pas des lemmings, PUIS viseur -- dans cet ordre, et une seule
1227   12CF                     ; fois. Avant, lem_step_all passait AVANT le clavier : il
1228   12CF                     ; redessinait le viseur, que la fleche effacait aussitot pour le
1229   12CF                     ; deplacer -- un cur_draw complet (16 lignes lues et reecrites)
1230   12CF                     ; jete a chaque pas de viseur ou un lemming bougeait aussi, c'est-
1231   12CF                     ; a-dire presque tout le temps avec du monde a l'ecran.
1232   12CF                     ; Desormais une fleche (ou la souris) ne fait qu'EFFACER le viseur a
1233   12CF                     ; l'ancienne position ; lem_step_all le redessine a la nouvelle s'il
1234   12CF                     ; a fait marcher quelqu'un, sinon on le redessine ci-dessous.
1235   12CF                     ; lem_step_all ne fait vraiment marcher que les lemmings dont le
1236   12CF                     ; compteur individuel vient d'atteindre LEM_STEP_DELAY -- la boucle
1237   12CF                     ; de verification reste bon marche meme quand personne n'est du.
1238   12CF 8E 33 4C            call    @lem_step_all           ; ne dessine plus le viseur
1239   12D2 8E 36 C1            call    @level_check            ; tout le monde sorti et plus
1240   12D5                                                     ; personne en jeu : GAGNE / PERDU
1241   12D5 8A C7 F9            lda     @cur_pending            ; deplacement demande (souris ou
1242   12D8 E2 07               jeq     @ml_nx_chk              ; fleche) : on l'applique MAINTENANT,
1243   12DA B5                  clr     A                       ; juste avant de redessiner -- le
1244   12DB 8B C7 F9            sta     @cur_pending            ; viseur n'est invisible que le temps
1245   12DE 8E 13 FE            call    @cur_apply              ; de cet effacement
1246   12E1             ml_nx_chk:
1247   12E1 8A C4 08            lda     @cur_dirty              ; efface (deplacement, ou redessin
1248   12E4 E2 05               jeq     @ml_nx_draw             ; d'ecran) : a redessiner
1249   12E6 8A C7 CE            lda     @any_stepped            ; pas efface, mais des lemmings ont pu
1250   12E9 E2 03               jeq     @ml_next2               ; passer par-dessus : a remettre
1251   12EB             ml_nx_draw:
1252   12EB 8E 17 9A            call    @cur_draw
1253   12EE             ml_next2:
1254   12EE B5                  clr     A
1255   12EF 8B C7 E7            sta     @pass_ticks             ; un nouveau passage commence
1256   12F2 8A C4 02            lda     @key_cur
1257   12F5 8B C4 03            sta     @key_last
1258   12F8 8C 11 5B            br      @main_loop
1259   12FB             
1260   12FB             halt:
1261   12FB 06                  dint
1262   12FC 8C 12 FB            br      @halt
1263   12FF             
1264   12FF             ; ============================================================================
1265   12FF             ; SOURIS EXELMOUSE -- lecteur autonome, protocole P49/P50 en 4 passes,
1266   12FF             ; repris d'exelnoid (memes ports, meme sequence) : AUCUNE dependance a une
1267   12FF             ; routine ROM, donc valable sur EXL100 comme sur EXELTEL (contrairement a
1268   12FF             ; une premiere tentative via $F03A, qui n'existe que sur EXELTEL et
1269   12FF             ; planterait ici). Voir la documentation du projet exelnoid pour le detail
1270   12FF             ; du protocole materiel.
1271   12FF             ;
1272   12FF             ; Different d'exelnoid sur un point : la ou la raquette d'Exelnoid ne bouge
1273   12FF             ; qu'horizontalement (delta Y ignore), le viseur de ce jeu bouge dans les
1274   12FF             ; DEUX sens -- delta Y conserve ici (mouse_dy), pas simplement lu et jete.
1275   12FF             ;
1276   12FF             ; check_mouse ne fait PAS de boutons une action de jeu pour l'instant :
1277   12FF             ; aucune competence unique ne correspond a un simple clic dans cette
1278   12FF             ; interface (les competences restent assignees au clavier, C/D/B/F/H/E).
1279   12FF             ; Le clic est neanmoins detecte (front, pas niveau) si besoin plus tard.
1280   12FF             ; ============================================================================
1281   12FF             read_mouse:
1282   12FF B8                  push    A
1283   1300 C8                  push    B
1284   1301             
1285   1301                     ; --- passe 1 : nibble haut du delta X, + boutons dans l'octet brut
1286   1301 A2 08 32            movp    %$08,P50
1287   1304 A2 03 31            movp    %$03,P49
1288   1307 52 06               mov     %6,B                    ; delai plus long en 1re passe,
1289   1309 8E 13 62            call    @mouse_delay            ; comme dans exelnoid
1290   130C A2 02 32            movp    %$02,P50
1291   130F 80 31               movp    P49,A
1292   1311 8B C7 E5            sta     @mouse_btn_old          ; boutons : bits 6-5 de CET octet
1293   1314 23 0F               and     %$0F,A
1294   1316 BE                  rl      A                       ; SWAP indisponible sur ce TASM --
1295   1317 BE                  rl      A                       ; equivalent a 4x RL (voir SWAP.md :
1296   1318 BE                  rl      A                       ; "equivalent to four consecutive
1297   1319 BE                  rl      A                       ; RL instructions")
1298   131A B8                  push    A                       ; en attente le temps de la passe 2
1299   131B             
1300   131B                     ; --- passe 2 : nibble bas du delta X ---
1301   131B A2 08 32            movp    %$08,P50
1302   131E A2 02 31            movp    %$02,P49
1303   1321 52 01               mov     %1,B
1304   1323 8E 13 62            call    @mouse_delay
1305   1326 A2 02 32            movp    %$02,P50
1306   1329 80 31               movp    P49,A
1307   132B 23 0F               and     %$0F,A
1308   132D C9                  pop     B                       ; B = nibble haut (passe 1)
1309   132E 64                  or      B,A                     ; A = delta X complet, signe
1310   132F D0 0E               mov     A,TEMP1
1311   1331             
1312   1331                     ; --- passe 3 : nibble haut du delta Y ---
1313   1331                     ; Delai porte a 6 (comme la passe 1), pas 1 (comme dans exelnoid) :
1314   1331                     ; les deux demandent le MEME mode $03 (nibble haut). Dans exelnoid,
1315   1331                     ; cette passe n'etait jamais exploitee (juste completee pour la
1316   1331                     ; forme puis jetee) -- personne n'avait verifie si $03 a besoin du
1317   1331                     ; meme delai de stabilisation qu'en passe 1, quel que soit le
1318   1331                     ; numero de passe. Hypothese testee suite a "bas ne fait rien,
1319   1331                     ; meme loin des bords" : une lecture trop rapide du nibble haut
1320   1331                     ; produirait un octet fausse, pas juste un signe interverti.
1321   1331 A2 08 32            movp    %$08,P50
1322   1334 A2 03 31            movp    %$03,P49
1323   1337 52 06               mov     %6,B
1324   1339 8E 13 62            call    @mouse_delay
1325   133C A2 02 32            movp    %$02,P50
1326   133F 80 31               movp    P49,A
1327   1341 23 0F               and     %$0F,A
1328   1343 BE                  rl      A                       ; SWAP indisponible sur ce TASM --
1329   1344 BE                  rl      A                       ; meme equivalent 4x RL qu'en passe 1
1330   1345 BE                  rl      A
1331   1346 BE                  rl      A
1332   1347 B8                  push    A
1333   1348             
1334   1348                     ; --- passe 4 : nibble bas du delta Y ---
1335   1348 A2 08 32            movp    %$08,P50
1336   134B A2 02 31            movp    %$02,P49
1337   134E 52 01               mov     %1,B
1338   1350 8E 13 62            call    @mouse_delay
1339   1353 A2 02 32            movp    %$02,P50
1340   1356 80 31               movp    P49,A
1341   1358 23 0F               and     %$0F,A
1342   135A C9                  pop     B
1343   135B 64                  or      B,A                     ; A = delta Y complet, signe
1344   135C 8B C7 E4            sta     @mouse_dy
1345   135F             
1346   135F C9                  pop     B
1347   1360 B9                  pop     A
1348   1361 0A                  rets
1349   1362             
1350   1362             ; Delai calibre sur le timing ROM (voir exelnoid) -- B = nombre d'iterations
1351   1362             ; (6 en passe 1, 1 pour les passes 2 a 4). La lecture SRAM ne sert qu'a
1352   1362             ; occuper le temps, la valeur lue n'est jamais utilisee ici.
1353   1362             mouse_delay:
1354   1362 B8                  push    A
1355   1363 C8                  push    B
1356   1364 8A C7 E5    md_lp:  lda     @mouse_btn_old
1357   1367 8A C7 E5            lda     @mouse_btn_old
1358   136A CA F8               djnz    B,@md_lp
1359   136C C9                  pop     B
1360   136D B9                  pop     A
1361   136E 0A                  rets
1362   136F             
1363   136F             ; ============================================================================
1364   136F             ; CHECK_MOUSE -- lit la souris et deplace le viseur d'UN pas par lecture,
1365   136F             ; borne comme au clavier (memes constantes CUR_STEP_X/Y, CUR_MAX_XSEG/Y).
1366   136F             ; Appelee une fois par tick depuis mc_key, uniquement si mouse_enabled=1.
1367   136F             ; ============================================================================
1368   136F             ; ============================================================================
1369   136F             ; DEPLACEMENT DU VISEUR -- routines communes au clavier et a la souris.
1370   136F             ;
1371   136F             ; Principe : on calcule d'abord la position VISEE (cur_nx/cur_ny) pas a
1372   136F             ; pas, avec exactement les memes bornes qu'avant, sans rien dessiner ; puis
1373   136F             ; cur_commit efface le viseur UNE fois a l'ancienne position. Le dessin a
1374   136F             ; la nouvelle position est fait a ml_next, une seule fois par passage.
1375   136F             ; Plusieurs pas (ou X + Y en diagonale) ne coutent donc pas plus cher
1376   136F             ; qu'un seul.
1377   136F             ; ============================================================================
1378   136F             
1379   136F             ; --- nombre de pas pour une fleche : 1 a l'appui, puis autant que de ticks
1380   136F             ; ecoules pendant ce passage (plafonne a CUR_BURST_MAX) en repetition.
1381   136F             ; KEY_RPT_NEXT vaut 1 (un pas par tick) : quand une passe dure 3 ticks parce
1382   136F             ; que beaucoup de lemmings ont ete dessines, le viseur fait 3 pas d'un coup
1383   136F             ; au lieu d'un -- sa vitesse ne depend plus du nombre de lemmings, comme
1384   136F             ; celle des lemmings eux-memes (voir ml_consume).
1385   136F             cur_arrow_steps:
1386   136F 22 01               mov     %1,A
1387   1371 8B C7 EA            sta     @cur_steps
1388   1374 8A C5 17            lda     @rpt_flag               ; premier appui : un seul pas, pour
1389   1377 E2 0E               jeq     @cas_done               ; garder la precision au coup par coup
1390   1379 8A C7 E7            lda     @pass_ticks
1391   137C E2 09               jeq     @cas_done
1392   137E 2D 04               cmp     %CUR_BURST_MAX,A
1393   1380 E7 02               jnc     @cas_set                ; jnc : pass_ticks < plafond
1394   1382 22 04               mov     %CUR_BURST_MAX,A
1395   1384             cas_set:
1396   1384 8B C7 EA            sta     @cur_steps
1397   1387             cas_done:
1398   1387 0A                  rets
1399   1388             
1400   1388             ; --- nombre de pas pour la souris : A = amplitude du deplacement lu (>= 1).
1401   1388             ; 1 pas pour un petit mouvement (comme avant), plus pour un geste ample :
1402   1388             ; amplitude/4 + 1, plafonne a CUR_BURST_MAX. La souris accumule son
1403   1388             ; deplacement entre deux lectures ; quand les lectures s'espacent (passes
1404   1388             ; longues), l'amplitude grandit et compense d'elle-meme.
1405   1388             ; NON VERIFIE sur materiel : la conversion suppose un delta en complement a
1406   1388             ; 2 (c'est ce que faisait la ROM d'origine avant son inversion INV/INC). Si
1407   1388             ; un sens se met a sauter de 4 pas au moindre mouvement, remplacer le corps
1408   1388             ; de cette routine par "mov %1,A / sta @cur_steps / rets".
1409   1388             mouse_steps:
1410   1388 BC                  rr      A
1411   1389 BC                  rr      A
1412   138A 23 3F               and     %$3F,A                  ; amplitude / 4 (rr fait tourner les
1413   138C                                                     ; bits 0-1 en haut : on les masque)
1414   138C B3                  inc     A                       ; au moins un pas
1415   138D 2D 04               cmp     %CUR_BURST_MAX,A
1416   138F E7 02               jnc     @ms_set
1417   1391 22 04               mov     %CUR_BURST_MAX,A
1418   1393             ms_set:
1419   1393 8B C7 EA            sta     @cur_steps
1420   1396 0A                  rets
1421   1397             
1422   1397             ; --- position visee = position actuelle
1423   1397             cur_move_init:
1424   1397 8A C7 F9            lda     @cur_pending            ; souris ET clavier dans le meme
1425   139A E6 0C               jne     @cmi_keep               ; passage : on repart de la cible
1426   139C 8A C4 06            lda     @cur_xseg               ; deja demandee, pas de l'ecran
1427   139F 8B C7 E8            sta     @cur_nx
1428   13A2 8A C4 07            lda     @cur_y
1429   13A5 8B C7 E9            sta     @cur_ny
1430   13A8             cmi_keep:
1431   13A8 0A                  rets
1432   13A9             
1433   13A9             ; --- cur_steps pas dans la direction cur_bdir, sur cur_nx/cur_ny. Chaque pas
1434   13A9             ; est borne comme avant : on s'arrete simplement au bord.
1435   13A9             cur_move_n:
1436   13A9             cmn_loop:
1437   13A9 8E 13 B6            call    @cur_try_dir
1438   13AC 8A C7 EA            lda     @cur_steps
1439   13AF B2                  dec     A
1440   13B0 8B C7 EA            sta     @cur_steps
1441   13B3 E6 F4               jne     @cmn_loop
1442   13B5 0A                  rets
1443   13B6             
1444   13B6             ; --- UN pas, memes tests que l'ancien code des fleches (cmp/jc : C=1 quand
1445   13B6             ; A >= operande).
1446   13B6             cur_try_dir:
1447   13B6 8A C7 EB            lda     @cur_bdir
1448   13B9 E6 0B               jne     @ctd_nl
1449   13BB 8A C7 E8            lda     @cur_nx                 ; 0 = gauche
1450   13BE E2 05               jeq     @ctd_ret                ; deja au bord gauche
1451   13C0 2A 01               sub     %CUR_STEP_X,A
1452   13C2 8B C7 E8            sta     @cur_nx
1453   13C5             ctd_ret:
1454   13C5 0A                  rets
1455   13C6             ctd_nl:
1456   13C6 2D 01               cmp     %1,A
1457   13C8 E6 0E               jne     @ctd_nr
1458   13CA 8A C7 E8            lda     @cur_nx                 ; 1 = droite
1459   13CD 28 01               add     %CUR_STEP_X,A
1460   13CF 2D 26               cmp     %CUR_MAX_XSEG,A
1461   13D1 E7 01               jnc     @ctd_rok                ; jnc : reste dans l'ecran
1462   13D3 0A                  rets
1463   13D4             ctd_rok:
1464   13D4 8B C7 E8            sta     @cur_nx
1465   13D7 0A                  rets
1466   13D8             ctd_nr:
1467   13D8 2D 02               cmp     %2,A
1468   13DA E6 0E               jne     @ctd_down
1469   13DC 8A C7 E9            lda     @cur_ny                 ; 2 = haut
1470   13DF 2D 08               cmp     %CUR_STEP_Y,A
1471   13E1 E3 01               jc      @ctd_uok                ; jc : cur_ny >= le pas
1472   13E3 0A                  rets
1473   13E4             ctd_uok:
1474   13E4 2A 08               sub     %CUR_STEP_Y,A
1475   13E6 8B C7 E9            sta     @cur_ny
1476   13E9 0A                  rets
1477   13EA             ctd_down:
1478   13EA 8A C7 E9            lda     @cur_ny                 ; 3 = bas
1479   13ED 28 08               add     %CUR_STEP_Y,A
1480   13EF 2D B8               cmp     %CUR_MAX_Y,A
1481   13F1 E7 01               jnc     @ctd_dok
1482   13F3 0A                  rets
1483   13F4             ctd_dok:
1484   13F4 8B C7 E9            sta     @cur_ny
1485   13F7 0A                  rets
1486   13F8             
1487   13F8             ; --- note le deplacement demande, SANS toucher a l'ecran. Tout l'affichage
1488   13F8             ; du viseur est fait a ml_next, apres le pas des lemmings : effacement puis
1489   13F8             ; redessin aussitot. Avant, la souris effacait le viseur des le debut du
1490   13F8             ; passage (check_mouse est lu juste apres l'attente du tick) et il restait
1491   13F8             ; invisible pendant tout le rattrapage, le clavier et le pas des lemmings --
1492   13F8             ; d'ou un clignotement, visible surtout a la souris qui bouge a chaque
1493   13F8             ; passage.
1494   13F8             cur_commit:
1495   13F8 22 01               mov     %1,A
1496   13FA 8B C7 F9            sta     @cur_pending
1497   13FD 0A                  rets
1498   13FE             
1499   13FE             ; --- applique la position visee (appele par ml_next seulement) : si elle
1500   13FE             ; differe, efface le viseur a l'ANCIENNE position (cur_xseg/cur_y encore
1501   13FE             ; inchanges a ce moment-la), puis met a jour. Au bord, rien ne change et
1502   13FE             ; rien n'est efface.
1503   13FE             cur_apply:
1504   13FE 8A C7 E8            lda     @cur_nx
1505   1401 8D C4 06            cmpa    @cur_xseg
1506   1404 E6 09               jne     @cc_move
1507   1406 8A C7 E9            lda     @cur_ny
1508   1409 8D C4 07            cmpa    @cur_y
1509   140C E6 01               jne     @cc_move
1510   140E 0A                  rets
1511   140F             cc_move:
1512   140F 8E 16 FD            call    @cur_erase
1513   1412 8A C7 E8            lda     @cur_nx
1514   1415 8B C4 06            sta     @cur_xseg
1515   1418 8A C7 E9            lda     @cur_ny
1516   141B 8B C4 07            sta     @cur_y
1517   141E 0A                  rets
1518   141F             
1519   141F             check_mouse:
1520   141F B8                  push    A
1521   1420 C8                  push    B
1522   1421             
1523   1421 8E 12 FF            call    @read_mouse
1524   1424 8E 13 97            call    @cur_move_init          ; X et Y cumules sur cur_nx/cur_ny,
1525   1427                                                     ; UN seul effacement a la fin (avant :
1526   1427                                                     ; un par axe en diagonale)
1527   1427             
1528   1427                     ; --- delta X. Sens verifie sur materiel : bit7=1 = DROITE,
1529   1427                     ; bit7=0 = GAUCHE.
1530   1427 12 0E               mov     TEMP1,A
1531   1429 E2 1D               jeq     @cmm_y
1532   142B 23 80               and     %$80,A
1533   142D E6 09               jne     @cmm_xr
1534   142F B5                  clr     A                       ; gauche
1535   1430 8B C7 EB            sta     @cur_bdir
1536   1433 12 0E               mov     TEMP1,A                 ; amplitude = valeur telle quelle
1537   1435 8C 14 42            br      @cmm_xgo
1538   1438             cmm_xr:
1539   1438 22 01               mov     %1,A                    ; droite
1540   143A 8B C7 EB            sta     @cur_bdir
1541   143D 12 0E               mov     TEMP1,A
1542   143F 25 FF               xor     %$FF,A                  ; amplitude = -valeur (complement a 2)
1543   1441 B3                  inc     A
1544   1442             cmm_xgo:
1545   1442 8E 13 88            call    @mouse_steps
1546   1445 8E 13 A9            call    @cur_move_n
1547   1448             
1548   1448             cmm_y:
1549   1448                     ; --- delta Y. Sens verifie sur materiel : bit7=1 = BAS,
1550   1448                     ; bit7=0 = HAUT.
1551   1448 8A C7 E4            lda     @mouse_dy
1552   144B E2 20               jeq     @cmm_commit
1553   144D 23 80               and     %$80,A
1554   144F E6 0B               jne     @cmm_yd
1555   1451 22 02               mov     %2,A                    ; haut
1556   1453 8B C7 EB            sta     @cur_bdir
1557   1456 8A C7 E4            lda     @mouse_dy
1558   1459 8C 14 67            br      @cmm_ygo
1559   145C             cmm_yd:
1560   145C 22 03               mov     %3,A                    ; bas
1561   145E 8B C7 EB            sta     @cur_bdir
1562   1461 8A C7 E4            lda     @mouse_dy
1563   1464 25 FF               xor     %$FF,A
1564   1466 B3                  inc     A
1565   1467             cmm_ygo:
1566   1467 8E 13 88            call    @mouse_steps
1567   146A 8E 13 A9            call    @cur_move_n
1568   146D             
1569   146D             cmm_commit:
1570   146D 8E 13 F8            call    @cur_commit             ; efface a l'ancienne position si le
1571   1470                                                     ; viseur a bouge ; dessin a ml_next
1572   1470             
1573   1470             cmm_btn:
1574   1470                     ; --- boutons : on ne retient que les NOUVEAUX appuis (front), un
1575   1470                     ; bit par bouton, dans mouse_act ; mouse_actions les traite ensuite
1576   1470                     ; avec le clavier (meme profondeur de pile qu'une touche). Actifs a
1577   1470                     ; l'etat bas dans l'octet P49 brut, d'ou l'inversion.
1578   1470 8A C7 E5            lda     @mouse_btn_old
1579   1473 25 FF               xor     %$FF,A
1580   1475 23 60               and     %$60,A                  ; boutons enfonces maintenant
1581   1477 C0                  mov     A,B
1582   1478 8A C7 E6            lda     @mouse_btn_latch        ; enfonces au passage precedent
1583   147B B4                  inv     A
1584   147C 63                  and     B,A                     ; = appuis nouveaux
1585   147D D0 10               mov     A,TEMP2
1586   147F 8A C7 FC            lda     @mouse_act
1587   1482 14 10               or      TEMP2,A
1588   1484 8B C7 FC            sta     @mouse_act
1589   1487 62                  mov     B,A
1590   1488 8B C7 E6            sta     @mouse_btn_latch
1591   148B             cmm_done:
1592   148B C9                  pop     B
1593   148C B9                  pop     A
1594   148D 0A                  rets
1595   148E             
1596   148E             ; ============================================================================
1597   148E             ; build_mixed_page -- reproduit l'algorithme d'InitMixedPage (vdp.asm),
1598   148E             ; wvdp(x) etant simplement "movp %x,P46" (EXL100.equ). Positionne d'abord
1599   148E             ; ACMPxy sur SCREEN_BASE (via setAcmpxy, meme sequence que vdp.asm), puis
1600   148E             ; ecrit sequentiellement TOP_TEXT_LINES lignes texte, GRAPH_LINES lignes
1601   148E             ; bitmap (vides), BOT_TEXT_LINES lignes texte -- chacune suivie de son
1602   148E             ; octet de controle (type de la ligne SUIVANTE) + un octet de reserve.
1603   148E             ; ============================================================================
1604   148E             build_mixed_page:
1605   148E 22 06               mov     %SCREEN_BASE>>8,A
1606   1490 52 00               mov     %SCREEN_BASE&$FF,B
1607   1492 8E 14 ED            call    @setAcmpxy
1608   1495             
1609   1495 72 02 16            mov     %TOP_TEXT_LINES,TEMP5
1610   1498 E2 1E               jeq     @bmp_after_top
1611   149A             bmp_top:
1612   149A 52 28               mov     %40,B
1613   149C             bmp_topc:
1614   149C A2 F8 2E            movp    %TEXT_ATTR,P46
1615   149F A2 60 2E            movp    %CH_BLANK,P46           ; glyphe vide (plus le code 0)
1616   14A2 CA F8               djnz    B,@bmp_topc
1617   14A4 7D 01 16            cmp     %1,TEMP5
1618   14A7 E2 06               jeq     @bmp_top_graph          ; derniere ligne texte du haut :
1619   14A9 A2 00 2E            movp    %MIXT_NEXT_TEXT,P46     ; suivante = bitmap (GRAPH_LINES
1620   14AC 8C 14 B2            br      @bmp_top2               ; vaut toujours 200 dans ce test,
1621   14AF                                                     ; pas besoin de tester s'il est nul
1622   14AF                                                     ; comme le fait vdp.asm, generique)
1623   14AF             bmp_top_graph:
1624   14AF A2 10 2E            movp    %MIXT_NEXT_GRAPH,P46
1625   14B2             bmp_top2:
1626   14B2 A2 00 2E            movp    %0,P46
1627   14B5 DA 16 E2            djnz    TEMP5,@bmp_top
1628   14B8             
1629   14B8             bmp_after_top:
1630   14B8 72 C8 16            mov     %GRAPH_LINES,TEMP5
1631   14BB             bmp_gr:
1632   14BB 52 78               mov     %120,B
1633   14BD             bmp_grb:
1634   14BD A2 00 2E            movp    %0,P46                  ; bitmap vide au depart (0 partout)
1635   14C0 CA FB               djnz    B,@bmp_grb
1636   14C2 7D 01 16            cmp     %1,TEMP5
1637   14C5 E6 06               jne     @bmp_grg
1638   14C7 A2 00 2E            movp    %MIXT_NEXT_TEXT,P46     ; derniere ligne bitmap -> texte
1639   14CA 8C 14 D0            br      @bmp_gr2
1640   14CD             bmp_grg:
1641   14CD A2 10 2E            movp    %MIXT_NEXT_GRAPH,P46
1642   14D0             bmp_gr2:
1643   14D0 A2 00 2E            movp    %0,P46
1644   14D3 DA 16 E5            djnz    TEMP5,@bmp_gr
1645   14D6             
1646   14D6 72 03 16            mov     %BOT_TEXT_LINES,TEMP5
1647   14D9             bmp_bot:
1648   14D9 52 28               mov     %40,B
1649   14DB             bmp_botc:
1650   14DB A2 F8 2E            movp    %TEXT_ATTR,P46
1651   14DE A2 60 2E            movp    %CH_BLANK,P46
1652   14E1 CA F8               djnz    B,@bmp_botc
1653   14E3 A2 00 2E            movp    %MIXT_NEXT_TEXT,P46
1654   14E6 A2 00 2E            movp    %0,P46
1655   14E9 DA 16 ED            djnz    TEMP5,@bmp_bot
1656   14EC 0A                  rets
1657   14ED             
1658   14ED             ; ============================================================================
1659   14ED             ; setAcmpxy -- reprise exacte de vdp.asm : positionne ACMPxy sur A:B.
1660   14ED             ; ============================================================================
1661   14ED             setAcmpxy:
1662   14ED A2 21 2D            movp    %$21,P45
1663   14F0 92 2D               movp    B,P45
1664   14F2 82 2D               movp    A,P45
1665   14F4 0A                  rets
1666   14F5             
1667   14F5             ; --- setRWxy : arme la lecture ET l'ecriture sur la MEME adresse ----------
1668   14F5             ; A = poids fort, B = poids faible (meme convention que setAcmpxy).
1669   14F5             ; Le TMS3556 a des pointeurs de LECTURE et d'ECRITURE separes, qui
1670   14F5             ; s'auto-incrementent independamment. La sequence ci-dessous (procedure du
1671   14F5             ; moniteur ROM $F932, decrite dans le quickref VDP section 5.1.1) les arme
1672   14F5             ; tous les deux d'un coup : P40 initialise la lecture depuis COL/ROW, le
1673   14F5             ; MOVP P36 qui suit est un DUMMY READ dont la valeur est ignoree mais qui
1674   14F5             ; fait avancer le pointeur lecture, et le transfert BAMP ($09 deux fois)
1675   14F5             ; prepare le pointeur ecriture ACMP sur la meme adresse.
1676   14F5             ; Ensuite, une boucle LVDP / MOVP A,P46 lit et reecrit la meme case, les
1677   14F5             ; deux pointeurs avancant en parallele -- exactement ce qu'il faut pour du
1678   14F5             ; lire-modifier-reecrire sur les trois plans couleur.
1679   14F5             ; Gain : UNE programmation de pointeur par ligne au lieu de DEUX.
1680   14F5             setRWxy:
1681   14F5 CB                  decd    B                       ; INDISPENSABLE : le dummy read
1682   14F6                                                     ; ci-dessous fait avancer le pointeur
1683   14F6                                                     ; lecture d'un octet. On pre-decremente
1684   14F6                                                     ; donc l'adresse (paire A:B, A = poids
1685   14F6                                                     ; fort) pour que le premier LVDP tombe
1686   14F6                                                     ; bien sur la case voulue. C'est ce que
1687   14F6                                                     ; fait le moniteur ROM en $F932.
1688   14F6 A2 01 2D            movp    %$01,P45
1689   14F9 92 2D               movp    B,P45
1690   14FB A2 02 2D            movp    %$02,P45
1691   14FE 82 2D               movp    A,P45
1692   1500 91 28               movp    P40,B                   ; arme la lecture
1693   1502 91 24               movp    P36,B                   ; dummy read : fait avancer le
1694   1504                                                     ; pointeur lecture
1695   1504 A2 09 2D            movp    %$09,P45                ; BAMP : prepare le pointeur
1696   1507 A2 09 2D            movp    %$09,P45                ; ecriture sur la meme adresse
1697   150A 0A                  rets
1698   150B             
1699   150B             ; ============================================================================
1700   150B             ; draw_all_tiles -- redessine TOUTE la zone bitmap (200 lignes de balayage),
1701   150B             ; horizon fixe (10 lignes-tuiles de ciel, 10 de sol) : pas de plan de
1702   150B             ; niveau ici, ce test ne mesure que la vitesse d'un reaffichage complet.
1703   150B             ; Chaque ligne de balayage appartient a UNE seule rangee de tuiles, donc
1704   150B             ; ses 40 segments partagent le meme motif -- pas besoin de lire une carte
1705   150B             ; case par case pour ce test statique.
1706   150B             ; ============================================================================
1707   150B             ; --- resout une rangee complete de tuiles dans tile_row : index reel de
1708   150B             ; chaque case, ou 0 si elle a ete creusee. Appelee UNE FOIS par rangee de
1709   150B             ; tuiles, pas a chaque ligne de balayage -- les bits creuses ne changent
1710   150B             ; que d'une rangee a l'autre. Sans ce cache, le redessin complet testait
1711   150B             ; 8000 cases au lieu de 800 et prenait plus d'une seconde.
1712   150B             build_tile_row:
1713   150B 8A C4 11            lda     @mrow_lo
1714   150E D0 10               mov     A,TEMP2
1715   1510 8A C4 10            lda     @mrow_hi
1716   1513 D0 0F               mov     A,TEMP2-1
1717   1515 8A C4 0E            lda     @cur_screen
1718   1518 8B C4 CA            sta     @map_screen
1719   151B 8E 20 51            call    @dig_row_start
1720   151E B5                  clr     A
1721   151F 8B C4 0C            sta     @tmp_b
1722   1522             btr_loop:
1723   1522 8A C6 CB            lda     @dig_cur
1724   1525 D0 14               mov     A,TEMP4
1725   1527 8A C6 CC            lda     @dig_bit
1726   152A 13 14               and     TEMP4,A
1727   152C E2 04               jeq     @btr_map
1728   152E B5                  clr     A                       ; creusee : vue comme vide
1729   152F 8C 15 34            br      @btr_store
1730   1532             btr_map:
1731   1532 9A 10               lda     *TEMP2
1732   1534             btr_store:
1733   1534 8B C4 0D            sta     @tmp_c
1734   1537 8A C4 0C            lda     @tmp_b
1735   153A C0                  mov     A,B
1736   153B 8A C4 0D            lda     @tmp_c
1737   153E AB C6 D0            sta     @tile_row(B)
1738   1541 D3 10               inc     TEMP2                   ; case suivante de la carte
1739   1543 79 00 0F            adc     %0,TEMP2-1
1740   1546 8A C6 CC            lda     @dig_bit                ; bit suivant ; tous les 8, on
1741   1549 B0                  clrc                            ; recharge l'octet
1742   154A BF                  rlc     A
1743   154B 8B C6 CC            sta     @dig_bit
1744   154E E6 08               jne     @btr_next
1745   1550 8E 20 31            call    @dig_load_byte
1746   1553 22 01               mov     %1,A
1747   1555 8B C6 CC            sta     @dig_bit
1748   1558             btr_next:
1749   1558 8A C4 0C            lda     @tmp_b
1750   155B B3                  inc     A
1751   155C 8B C4 0C            sta     @tmp_b
1752   155F 2D 28               cmp     %LV_MAP_W,A
1753   1561 E6 BF               jne     @btr_loop
1754   1563             
1755   1563                     ; --- tuiles POSEES : un seul balayage de la liste pour toute la
1756   1563                     ; rangee. Les tester case par case reviendrait a parcourir la liste
1757   1563                     ; 40 fois par rangee au lieu d'une.
1758   1563                     ; L'index de parcours est garde en MEMOIRE (bidx) et non dans B :
1759   1563                     ; B sert aussi a indexer build_key, build_col et tile_row, et une
1760   1563                     ; premiere version melangeait les deux usages.
