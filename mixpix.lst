0090   0000             ; ============================================================================
0091   0000             ; SELECTION DES FONCTIONS DE L'API (mixt_api.asm n'assemble le code de
0092   0000             ; chaque routine que si son #DEFINE est pose ici -- sans ce bloc :
0093   0000             ; "Label not found", exactement comme au premier essai de lemproto.asm)
0094   0000             ; Ce test n'utilise que init_vdp : tout le reste de l'affichage passe par
0095   0000             ; nos propres ecritures VDP directes.
0096   0000             ; ============================================================================
0097   0000             #DEFINE Finit_vdp
0098   0000             
0099   0000             ; --- constantes : TOUTES deja definies dans 3556.equ (FWHITE, BBLACK,
0100   0000             ; BAGC2, REGBAPA, COL, ROW, TIMEBASE, DECODER, SCRMODE, BORDER, CM1MASK,
0101   0000             ; CM2MASK, LINEZERO, BAGC3ALPHA, CM3MASK, MIXTMODE, CM4MASK, MBLACK,
0102   0000             ; MIXTLEN, MAPPLEN...). Un premier essai les redeclarait ici, ce que TASM
0103   0000             ; a refuse avec 22 "Duplicate label" -- confirmant du meme coup que notre
0104   0000             ; 3556.equ est bien le meme fichier de constantes que celui du toolkit
0105   0000             ; Jester, ou un equivalent exact. Seules restent ci-dessous les valeurs
0106   0000             ; PROPRES a ce test.
0107   0000             BG_PTR          .equ    30              ; paire R29:R30 (= TEMP9 d'EXL100.equ,
0108   0000                                                     ; nomme ici pour ne pas dependre de
0109   0000                                                     ; 7020.equ) : pointeur VRAM de
0110   0000                                                     ; bg_draw_rect et de destination de
0111   0000                                                     ; bg_fill_buf. Utilise nulle part
0112   0000                                                     ; ailleurs dans ce programme.
0113   0000             VP_PTR          .equ    32              ; paire R31:R32 (= TEMP10 d'EXL100.equ) :
0114   0000                                                     ; adresse VRAM dans lem_draw. Utilise
0115   0000                                                     ; nulle part ailleurs.
0116   0000             MAPPLEN_HI_C    .equ    1               ; (MAPPLEN>>8)+1 = 0+1, en dur
0117   0000             ; --- TEXTE : police MAISON dans BAGC3, comme Exeltris -----------------------
0118   0000             ; La police ROM copiee par trap 13 (BAGC0) marche sur l'emulateur mais PAS
0119   0000             ; sur machine reelle : fond blanc et lignes horizontales a la place des
0120   0000             ; caracteres (photo EXL100), exactement le symptome deja rencontre et
0121   0000             ; documente sur Exeltris ("barres, texte bruite ou paves pleins").
0122   0000             ; Solution reprise d'Exeltris, validee sur EXL100 et EXELTEL : une police
0123   0000             ; chargee par trap 19 dans BAGC3, BAGC3 reloge par ses registres de base et
0124   0000             ; laisse ALPHAMOSAIQUE (CM2.DC5 = 1). En alphamosaique, le fond de la cellule
0125   0000             ; vient des bits 2-0 de l'attribut (BBLACK), l'avant-plan des bits 7-5.
0126   0000             ; Chaque glyphe est charge A SON CODE ASCII ($21..$5F) : aucune traduction
0127   0000             ; dans les routines d'ecriture, sauf l'espace (voir CH_BLANK).
0128   0000             TEXT_ATTR       .equ    FWHITE|$18|BBLACK   ; $18 = banc BAGC3 (bits 4-3),
0129   0000                                                     ; en dur comme dans Exeltris
0130   0000             BAGC3_MOSAIC    .equ    $08             ; CM2.DC5 : BAGC3 alphamosaique (valeur
0131   0000                                                     ; de CM2 d'Exeltris : $88 ; ici $C8,
0132   0000                                                     ; LINEZERO en plus comme avant)
0133   0000             FONT_BAGC3      .equ    $6800           ; generateur BAGC3 en VRAM : 1280 octets
0134   0000                                                     ; ($6800-$6CFF), APRES la page mixte
0135   0000                                                     ; ($0600-$66E9) et sous 32 Ko
0136   0000             FONT_BAGC3_M2   .equ    $67FE           ; FONT_BAGC3-2, en dur : les bases de
0137   0000                                                     ; generateur chargent COL/ROW + 2
0138   0000             CH_BLANK        .equ    $60             ; glyphe VIDE dedie, ecrit a la place
0139   0000                                                     ; de l'espace : sur machine reelle le
0140   0000                                                     ; code $20 peut s'afficher comme un
0141   0000                                                     ; pave (delimiteur de zone VDP) --
0142   0000                                                     ; lecon d'Exeltris. $00 et $20 recoivent
0143   0000                                                     ; quand meme un glyphe vide par surete.
0144   0000             
0145   0000             ; Octet de controle (manuel TMS3556, section 1.3) : BM GM RM C/G MR LR IR X,
0146   0000             ; du bit 7 au bit 0. C/G est donc le BIT 4 = $10 -- et non $18 comme une
0147   0000             ; premiere version de ce fichier l'avait ecrit, par confusion avec le motif
0148   0000             ; de selection du banc BAGC3 (qui vaut bien $18, mais dans l'octet
0149   0000             ; d'ATTRIBUT d'un caractere, pas dans l'octet de controle de fin de ligne :
0150   0000             ; deux champs sans rapport). Valeur recoupee independamment par le moteur
0151   0000             ; de rendu du projet (MIXED_NEXT_GRAPHIC = 0x10).
0152   0000             ; BM/GM/RM (bits 7-5) restent a 0 : marge noire pour la ligne suivante.
0153   0000             MIXT_NEXT_TEXT  .equ    $00             ; C/G = 0 : ligne suivante = texte
0154   0000             MIXT_NEXT_GRAPH .equ    $10             ; C/G = 1 : ligne suivante = graphique
0155   0000             
0156   0000             ; --- disposition de CE test -------------------------------------------------
0157   0000             TOP_TEXT_LINES  .equ    2
0158   0000             GRAPH_LINES     .equ    200             ; 20 lignes-texte de haut, en VRAIES
0159   0000                                                     ; lignes de balayage (20*10)
0160   0000             BOT_TEXT_LINES  .equ    3
0161   0000             SCREEN_BASE     .equ    $0600           ; PAS $4000 : avec 200 lignes bitmap,
0162   0000                                                     ; la page complete pese 24810 octets
0163   0000                                                     ; -- $4000+24810 depassait les 32 Ko
0164   0000                                                     ; de VRAM reelle mentionnes pour cette
0165   0000                                                     ; machine (la puce adresse jusqu'a
0166   0000                                                     ; 64 Ko, mais pas forcement l'EXL100).
0167   0000                                                     ; $0600 laisse la marge necessaire
0168   0000                                                     ; sous 32 Ko, et reste au-dela de la
0169   0000                                                     ; police ROM copiee en $0000 (trap 13,
0170   0000                                                     ; jusqu'a ~1280 octets pour 128 car.)
0171   0000             SCREEN_BASE_M1  .equ    $05FF           ; SCREEN_BASE-1, en dur : BAPA
0172   0000                                                     ; charge COL/ROW+1 (vdp.asm), donc
0173   0000                                                     ; on ecrit l'adresse cible moins un
0174   0000             GRAPH_BASE      .equ    $06A4           ; SCREEN_BASE + TOP_TEXT_LINES*
0175   0000                                                     ; MIXTLEN (2*82=164), en dur
0176   0000             
0177   0000             ; --- grille de tuiles decor : 8 (largeur) x 10 (hauteur), PAS 8x8 (choix
0178   0000             ; explicite pour aligner sur la hauteur d'une ligne-texte).
0179   0000             ; ATTENTION : ces cinq constantes DOCUMENTENT la geometrie mais ne pilotent
0180   0000             ; rien -- draw_all_tiles utilise 40, 100 et 110 en dur. Changer une valeur
0181   0000             ; ici ne changera pas l'affichage ; il faudra aussi toucher draw_all_tiles.
0182   0000             TILE_W_SEG      .equ    1               ; 8 px = 1 segment
0183   0000             TILE_H_LINES    .equ    10
0184   0000             TILES_PER_ROW   .equ    40              ; 320 px / 8
0185   0000             TILE_ROWS       .equ    20              ; GRAPH_LINES / TILE_H_LINES
0186   0000             HORIZON_ROW     .equ    10              ; tuiles 0..9 = ciel, 10..19 = sol
0187   0000             
0188   0000             ; --- viseur bitmap ---------------------------------------------------------
0189   0000             ; Croix EVIDEE au centre (comme un viseur) : 16x16 pixels, soit 2 segments
0190   0000             ; de large et 16 lignes de haut. Se deplace dans la seule zone bitmap.
0191   0000             CUR_W_SEG       .equ    2               ; 16 px de large
0192   0000             CUR_H_LINES     .equ    16
0193   0000             ; Les deux pas doivent couvrir la MEME distance en pixels, sinon le viseur
0194   0000             ; se deplace visiblement plus vite dans un sens que dans l'autre : un
0195   0000             ; segment fait 8 px, le pas vertical doit donc valoir 8 lignes (il etait a
0196   0000             ; 4, d'ou un deplacement horizontal deux fois plus rapide).
0197   0000             ; Contrepartie : le viseur ne peut plus se poser qu'une ligne sur 8 en
0198   0000             ; vertical. Remettre 4 ici si la precision compte plus que la symetrie.
0199   0000             CUR_STEP_X      .equ    1               ; pas horizontal, en segments de 8 px
0200   0000             CUR_STEP_Y      .equ    8               ; pas vertical, en lignes (= 8 px)
0201   0000             CUR_BURST_MAX   .equ    4               ; pas maximum en UNE passe : quand
0202   0000                                                     ; une passe dure plusieurs ticks, le
0203   0000                                                     ; viseur rattrape le temps perdu,
0204   0000                                                     ; mais sans sauter plus loin que ca
0205   0000             CUR_MAX_XSEG    .equ    38              ; 40 - CUR_W_SEG
0206   0000             CUR_MAX_Y       .equ    184             ; GRAPH_LINES - CUR_H_LINES
0207   0000             
0208   0000             ; Lemming : bornes et rythme. LEM_WSEG/LEM_HLINES viennent de lemdata.asm.
0209   0000             ; 40 - LEM_WSEG, ecrit EN DUR : LEM_WSEG vient de lemdata.asm, inclus tout
0210   0000             ; a la fin du fichier, et un .equ ne peut pas referencer un symbole defini
0211   0000             ; plus loin. A CORRIGER A LA MAIN si vous changez la largeur du sprite dans
0212   0000             ; EXELLEM : 39 pour un sprite de 8 px (1 segment), 38 pour 16 px.
0213   0000             ; Borne EXCLUSIVE des colonnes : les tests s'ecrivent "xseg+1 < LEM_COLS".
0214   0000             ; Valait 39, ce qui rendait la colonne 39 inatteignable -- la derniere case
0215   0000             ; de chaque ecran n'etait donc jamais parcourue ni creusee.
0216   0000             LEM_COLS        .equ    40              ; = LV_MAP_W
0217   0000             LEM_LAST_XSEG   .equ    39              ; derniere colonne utilisable
0218   0000             NUM_LEM         .equ    10              ; lemmings au total
0219   0000             ST_WALK         .equ    0               ; etats d'un lemming
0220   0000             ST_FALL         .equ    1
0221   0000             FALL_STEP       .equ    2               ; lignes descendues par pas de chute
0222   0000             LEM_MAX_Y       .equ    190             ; GRAPH_LINES - LEM_HLINES, en dur
0223   0000             TILE_SOLID      .equ    $01             ; bit 0 de lv_flags : porte un lemming
0224   0000             LEM_FOOT        .equ    9               ; LEM_HLINES-1, en dur : derniere
0225   0000                                                     ; ligne du sprite (hauteur des pieds)
0226   0000             
0227   0000             ; --- sondage du relief au pixel --------------------------------------------
0228   0000             ; On sonde les pixels 1 a 6 du segment (bit 7 = pixel 0, a gauche) : un
0229   0000             ; pixel non noir parmi eux suffit. Autrefois seulement les pixels 3 et 4,
0230   0000             ; sous le corps du lemming : suffisant pour des tuiles dessinees a la main,
0231   0000             ; mais un decor IMPORTE d'une image a des colonnes rayees, des traits fins,
0232   0000             ; dont les pixels tombent a cote -- les lemmings traversaient ces murs
0233   0000             ; visibles, et le frappeur n'y voyait rien a creuser (ils restaient
0234   0000             ; affiches). Les pixels 0 et 7, au bord du segment, restent ignores : un
0235   0000             ; trait sur la frontiere entre deux tuiles ne fait pas un mur.
0236   0000             PROBE_MASK      .equ    $7E             ; bits 6 a 1 = pixels 1 a 6
0237   0000             MAX_STEP_UP_N   .equ    11              ; MAX_STEP_UP+1 tours de boucle : le
0238   0000                                                     ; premier examine la ligne de depart
0239   0000                                                     ; elle-meme. Avec 10 tours, une
0240   0000                                                     ; marche de 10 px etait refusee alors
0241   0000                                                     ; qu'elle devait passer.
0242   0000             MAX_STEP_UP     .equ    10              ; denivele franchissable en montant.
0243   0000                                                     ; Vaut une tuile entiere pour que
0244   0000                                                     ; l'escalier du constructeur reste
0245   0000                                                     ; praticable ; une valeur plus faible
0246   0000                                                     ; (4 a 6, comme l'original) donnerait
0247   0000                                                     ; un relief plus exigeant.
0248   0000             MAX_STEP_DOWN   .equ    6               ; au-dela, il tombe au lieu de
0249   0000                                                     ; descendre la pente
0250   0000             TILE_DIG        .equ    $02             ; bit 1 de lv_flags : destructible
0251   0000             ST_DIG          .equ    2               ; troisieme etat : creuse vers le bas
0252   0000             ST_BLOCK        .equ    3               ; type 3 = "bloque" : il reste sur
0253   0000                                                     ; place et fait faire demi-tour aux
0254   0000                                                     ; lemmings qui l'abordent
0255   0000             ST_DEAD         .equ    4               ; type 4 = "meurt"
0256   0000             ST_FLOAT        .equ    5               ; type 5 = "flotte" : chute freinee
0257   0000                                                     ; par un parachute, jamais mortelle
0258   0000             FLOAT_STEP      .equ    1               ; lignes par pas en parachute
0259   0000             FLOAT_OPEN      .equ    12              ; le parachute ne s'ouvre qu'apres
0260   0000                                                     ; 12 lignes de chute : une marche du
0261   0000                                                     ; tunnel du mineur (10 px) se descend
0262   0000                                                     ; sans lui, un trou de 2 tuiles l'ouvre.
0263   0000                                                     ; Tres en dessous de MAX_FALL : un
0264   0000                                                     ; parachutiste ne s'ecrase jamais.
0265   0000                                                     ; (deux fois plus lent qu'une chute)
0266   0000             ST_BASH         .equ    6               ; type 6 = "frappe" : creuse a
0267   0000                                                     ; l'horizontale, dans son sens de
0268   0000                                                     ; marche
0269   0000             
0270   0000             ; --- kamikaze --------------------------------------------------------------
0271   0000             ; Le terrain etant une grille de tuiles 8x10, le cratere circulaire de
0272   0000             ; l'original (~16 px de diametre) n'est pas reproductible : on detruit un
0273   0000             ; carre de tuiles centre sur le lemming. 3x3 = 24x30 px, la surface la plus
0274   0000             ; proche du cratere d'origine, et de quoi percer une paroi ou degager un
0275   0000             ; bloqueur. L'ACIER resiste, comme partout ailleurs.
0276   0000             ST_BUILD        .equ    8               ; type 8 = "construit" : pose un
0277   0000                                                     ; escalier d'une tuile par marche
0278   0000             ST_MINE         .equ    11              ; type 11 = "mine" : creuse en
0279   0000                                                     ; diagonale vers le bas (competence M)
0280   0000             ST_CLIMB        .equ    10              ; type 10 = "grimpe" : escalade une
0281   0000                                                     ; paroi verticale (competence G)
0282   0000             CLIMB_STEP      .equ    2               ; lignes gagnees par pas d'escalade
0283   0000                                                     ; (le test de plafond verifie les 2)
0284   0000             EQUIP_FLOAT     .equ    $01             ; lem_float, bit 0 : parachute
0285   0000             EQUIP_CLIMB     .equ    $02             ; lem_float, bit 1 : grimpeur
0286   0000             ; types de SPRITE du marcheur selon ses competences permanentes (ce ne sont
0287   0000             ; pas des etats : l'etat reste ST_WALK, voir lem_sprite_type)
0288   0000             LT_WALK_F       .equ    12              ; marche, parachute sur le dos
0289   0000             LT_WALK_C       .equ    13              ; marche, grimpeur
0290   0000             LT_WALK_FC      .equ    14              ; marche, les deux ("athlete")
0291   0000             ST_WAIT         .equ    9               ; type 9 = "attend" : plus de
0292   0000                                                     ; briques, bras leves -- signale
0293   0000                                                     ; qu'on peut le reselectionner pour
0294   0000                                                     ; lui donner une nouvelle competence
0295   0000                                                     ; (construire plus haut, par exemple)
0296   0000             WAIT_STEPS      .equ    10              ; duree de la pause, en pas DE CE
0297   0000                                                     ; LEMMING (pas en tics bruts) : son
0298   0000                                                     ; propre pas revient tous les
0299   0000                                                     ; LEM_STEP_DELAY(16) tics a 50 Hz,
0300   0000                                                     ; soit ~0,32 s -- 10 pas font ~3,2 s,
0301   0000                                                     ; le "quelques secondes" demande.
0302   0000                                                     ; S'il n'est pas reselectionne d'ici
0303   0000                                                     ; la, il repart marcher tout seul.
0304   0000             ; Proportions de l'escalier. L'original pose 12 marches de ~4 px de large
0305   0000             ; et ~2 px de haut : 48 px d'avance pour 24 px de montee, soit 26,6 deg.
0306   0000             ; Rapporte a nos tuiles de 8x10 px, cela fait 6 tuiles de large pour 2,4 de
0307   0000             ; haut. Une premiere version montait d'une tuile a CHAQUE brique, soit 12
0308   0000             ; tuiles de haut -- cinq fois trop raide.
0309   0000             ; 6 briques avec une montee toutes les 3 donnent 48x20 px et 22,6 deg :
0310   0000             ; la combinaison la plus proche de l'original sur les deux dimensions.
0311   0000             BUILD_STEPS     .equ    3               ; briques posees
0312   0000             BUILD_CLEARANCE .equ    4               ; BUILD_STEPS+1, EN DUR (a mettre a
0313   0000                                                     ; jour a la main si BUILD_STEPS
0314   0000                                                     ; change) : nombre de tuiles de
0315   0000                                                     ; marge exigees au-dessus du
0316   0000                                                     ; lemming avant d'accepter de le
0317   0000                                                     ; faire construire -- une de plus
0318   0000                                                     ; que la hauteur reelle de
0319   0000                                                     ; l'escalier, pour laisser la place
0320   0000                                                     ; au controle de plafond de sa
0321   0000                                                     ; toute derniere brique.
0322   0000             BUILD_TILE      .equ    1               ; tuile posee : "terre", solide et
0323   0000                                                     ; destructible (pas besoin d'un
0324   0000                                                     ; nouveau type dans EXELTILE)
0325   0000             KEY_BUILD       .equ    $43             ; 'C' : constructeur
0326   0000             KEY_BUILD_LC    .equ    $63
0327   0000             
0328   0000             ; --- tuiles POSEES ---------------------------------------------------------
0329   0000             ; La couche de destruction ne stocke qu'un bit "creusee". Construire demande
0330   0000             ; de memoriser l'inverse, et une seconde couche a 1 bit/case couterait 300
0331   0000             ; octets alors qu'il n'en reste que ~240 en SRAM.
0332   0000             ; Les constructions etant rares (12 par escalier), on tient donc une LISTE :
0333   0000             ; 64 entrees de 2 octets = 128 octets, soit cinq escaliers complets.
0334   0000             ; Elle est consultee UNE FOIS PAR RANGEE lors du remplissage de tile_row,
0335   0000             ; pas une fois par case -- sinon le redessin complet couterait 40x plus.
0336   0000             ; MAX_BUILT : d'abord reduit de 64 a 40 pour liberer la place du tableau
0337   0000             ; build_tile (chaque entree "construite" a maintenant SA PROPRE tuile, pas
0338   0000             ; toujours BUILD_TILE). Puis chaque marche s'est mise a consommer DEUX
0339   0000             ; entrees, pas une : elle comble aussi la rangee du dessous pour rester
0340   0000             ; soudee au terrain d'origine, meme irregulier (voir le comblement dans
0341   0000             ; lst_build). Remonte a 48 (marge SRAM verifiee) : BUILD_STEPS=6 x 2
0342   0000             ; entrees = 12 par escalier complet, soit 4 escaliers simultanes.
0343   0000             MAX_BUILT       .equ    48
0344   0000             
0345   0000             ; --- tuiles d'escalier, progressives -------------------------------------
0346   0000             ; Un escalier reel a une contremarche basse puis de plus en plus haute,
0347   0000             ; pas un bloc plein d'un coup. Trois "marches" couvrent une hauteur de
0348   0000             ; tuile complete (10 px) :
0349   0000             ;   TILE_MARCHEA (nommee dans EXELTILE) : 3 px pleins en bas
0350   0000             ;   TILE_MARCHEB (nommee dans EXELTILE) : 7 px pleins en bas
0351   0000             ;   (la 3e marche est BUILD_TILE lui-meme : entierement pleine)
0352   0000             ; Ces index correspondent aux tuiles A DESSINER dans EXELTILE ; ajuster
0353   0000             ; si vous les placez ailleurs dans votre lv_tiles.
0354   0000             ; Les index des deux tuiles NE SONT PLUS ICI : TILE_MARCHEA et TILE_MARCHEB
0355   0000             ; sont desormais exportes directement par EXELTILE (voir leveldata.asm),
0356   0000             ; nommes d'apres le champ "Nom" de la tuile plutot que fixes en dur. Une
0357   0000             ; tuile qui change de position (une autre ajoutee ou supprimee avant elle)
0358   0000             ; ne desynchronise donc plus jamais le code : l'export les recalcule a
0359   0000             ; chaque fois. C'est directement ce qui manquait la fois ou la suppression
0360   0000             ; d'une tuile de test a decale marcheA/marcheB d'un cran sans que ces
0361   0000             ; constantes, alors figees ici, ne le sachent.
0362   0000             STAIR_DELTA_A   .equ    5               ; px montes lors de la toute
0363   0000                                                     ; premiere marche (A) -- doit
0364   0000                                                     ; correspondre au seuil dessine
0365   0000                                                     ; pour marcheA dans EXELTILE
0366   0000             STAIR_DELTA_C   .equ    5               ; px montes par brique, a partir de
0367   0000                                                     ; la 2e (cycle B+C) -- doit
0368   0000                                                     ; correspondre au seuil de
0369   0000                                                     ; remplissage dessine pour marcheC
0370   0000                                                     ; dans EXELTILE (5 px par defaut).
0371   0000                                                     ; INDEPENDANT de STAIR_DELTA_A : B,
0372   0000                                                     ; qui suit A, est TOUJOURS pleine
0373   0000                                                     ; sur toute sa rangee, donc son
0374   0000                                                     ; appui ne depend pas du seuil
0375   0000                                                     ; exact utilise par A.
0376   0000             
0377   0000             ST_BOOM         .equ    7               ; type 7 = "explose" : gerbe de
0378   0000                                                     ; pixels rouges, puis disparition.
0379   0000                                                     ; Se comporte comme ST_DEAD, mais
0380   0000                                                     ; avec sa propre animation.
0381   0000             ; (duree de la gerbe : plus de constante BOOM_STEPS, c'est le nombre REEL de
0382   0000             ; vignettes du type "explose" dans lemdata.asm -- voir lem_explode)
0383   0000             EXPLODE_R       .equ    1               ; rayon en tuiles (1 -> zone 3x3)
0384   0000             EXPLODE_STEPS   .equ    31              ; ~5 s : 31 pas de 160 ms, comme
0385   0000                                                     ; le compte a rebours d'origine
0386   0000             KEY_BOMB        .equ    $45             ; 'E' : amorce le compte a rebours
0387   0000             KEY_BOMB_LC     .equ    $65
0388   0000             MAX_FALL        .equ    60              ; chute fatale a partir de 60 lignes
0389   0000                                                     ; (6 tuiles). Les transitions d'ecran
0390   0000                                                     ; n'en font que 20 : sans danger.
0391   0000             DEATH_STEPS     .equ    6               ; pas avant disparition du corps
0392   0000             KEY_DIG         .equ    $44             ; 'D' : creuseur
0393   0000             KEY_DIG_LC      .equ    $64
0394   0000             KEY_BLOCK       .equ    $42             ; 'B' : bloqueur
0395   0000             KEY_BLOCK_LC    .equ    $62
0396   0000             KEY_FLOAT       .equ    $46             ; 'F' : parachutiste
0397   0000             KEY_FLOAT_LC    .equ    $66
0398   0000             KEY_BASH        .equ    $48             ; 'H' : frappeur (creuseur
0399   0000             KEY_BASH_LC     .equ    $68             ; horizontal)
0400   0000             
0401   0000             ; --- couche de destruction --------------------------------------------------
0402   0000             ; Les cartes sont en ROM : impossible d'y effacer une tuile. On tient donc
0403   0000             ; a cote, en RAM, UN BIT par case disant "cette case a ete creusee".
0404   0000             ; 40x20 = 800 bits = 100 octets par ecran ; 3 ecrans = 300 octets, ce qui
0405   0000             ; tient dans la SRAM libre. Une copie complete des cartes aurait demande
0406   0000             ; 800 octets par ecran, soit bien trop.
0407   0000             DIG_BYTES_SCR   .equ    100             ; (LV_MAP_W*LV_MAP_H)/8, en dur
0408   0000             SPAWN_TICKS     .equ    200             ; 200 ticks de 10 ms = 2 secondes
0409   0000                                                     ; entre deux apparitions
0410   0000             ; Delais exprimes en TICKS de 10 ms. Doubles en meme temps que l'horloge
0411   0000             ; passait de 50 a 100 Hz, pour que le lemming garde EXACTEMENT le meme
0412   0000             ; rythme : 16 ticks = 160 ms entre deux pas, comme avant.
0413   0000             LEM_STEP_DELAY  .equ    16
0414   0000             
0415   0000             ; ---------------------------------------------------------------------------
0416   0000             ; HORLOGE MATERIELLE -- remplace l'ancienne boucle d'attente logicielle.
0417   0000             ;
0418   0000             ; Une attente logicielle mesure des INSTRUCTIONS, pas du temps : des qu'une
0419   0000             ; image demande plus de travail (deplacer le viseur, par exemple), elle dure
0420   0000             ; plus longtemps, et tout ce qui en depend ralentit. C'est ce qui faisait
0421   0000             ; ralentir le lemming pendant les deplacements du viseur.
0422   0000             ;
0423   0000             ; Le timer du TMS7020 donne une vraie base de temps, independante du travail
0424   0000             ; effectue. Periode : F = 307200 / ((PT+1) * (DT+1))  (doc EXL100, 3.3.2).
0425   0000             ;   PT = 11, DT = 255  ->  307200 / (12*256) = 100,00 Hz, soit 10 ms pile.
0426   0000             ; P3 = bit 7 (TIMER ENABLE) | predisviseur sur les bits 4..0 -> $80|11 = $8B.
0427   0000             ; (PT = 23 donnait 50 Hz ; PT = 5 donnerait 200 Hz si besoin d'aller encore
0428   0000             ; plus vite -- le viseur avance d'un pas par tick, sa vitesse suit donc
0429   0000             ; directement cette frequence.)
0430   0000             ;
0431   0000             ; L'interruption passe par le vecteur systeme BRTIME ($C004) : le moniteur
0432   0000             ; sauvegarde A et B, appelle la routine pointee, qui doit se terminer par un
0433   0000             ; RETS et preserver elle-meme les autres registres qu'elle utilise
0434   0000             ; (TMS7020_AND_EXL100, sections 1309 et 1543).
0435   0000             TIMER_DT        .equ    255             ; diviseur    (P2)
0436   0000             TIMER_P3        .equ    $8B             ; marche + predisviseur 11 (P3)
0437   0000             
0438   0000             ; Repetition automatique quand une touche reste enfoncee : un premier delai
0439   0000             ; plus long (pour ne pas partir au quart de tour sur une pression breve),
0440   0000             ; puis une cadence rapide. Meme principe que le DAS d'Exeltris.
0441   0000             KEY_RPT_FIRST   .equ    16              ; ticks avant la 1re repetition
0442   0000                                                     ; (160 ms, inchange)
0443   0000             KEY_RPT_NEXT    .equ    1               ; un pas par tick : le viseur avance
0444   0000                                                     ; desormais a 100 cases par seconde,
0445   0000                                                     ; soit 800 px/s dans les deux sens
0446   0000             
0447   0000             ; Valeurs reprises telles quelles d'Exeltris (eprouvees sur machine reelle),
0448   0000             ; SAUF la fleche haut, jamais utilisee dans ce projet : $80 est une
0449   0000             ; deduction par symetrie, A VERIFIER a l'usage.
0450   0000             KEY_ARR_LEFT    .equ    $83
0451   0000             KEY_ARR_RIGHT   .equ    $81
0452   0000             KEY_ARR_DOWN    .equ    $82
0453   0000             KEY_ARR_UP      .equ    $80             ; NON VERIFIE
0454   0000             
0455   0000             KEY_REDRAW      .equ    $52             ; 'R' majuscule
0456   0000             KEY_REDRAW_LC   .equ    $72             ; 'r' minuscule -- les deux sont
0457   0000                                                     ; testees : on ne sait pas laquelle
0458   0000                                                     ; le clavier envoie selon l'etat de
0459   0000                                                     ; Verr.Maj., et un test sur la seule
0460   0000                                                     ; majuscule echouait silencieusement
0461   0000             KEY_SPACE       .equ    $20             ; ESPACE : attribue le pouvoir
0462   0000                                                     ; selectionne (n'est plus un secours
0463   0000                                                     ; de R, qui marche seul sur machine)
0464   0000             KEY_TAB         .equ    $09             ; TAB : pouvoir suivant (code tire de
0465   0000                                                     ; la KB clavier, a confirmer)
0466   0000             
0467   0000             ; --- panneau des pouvoirs (3 lignes texte du bas) ---------------------------
0468   0000             NUM_SKILLS      .equ    8               ; ordre : C D H B F E G M
0469   0000             ICON_FIRST      .equ    $61             ; icones des 7 premiers pouvoirs :
0470   0000                                                     ; $61..$7C ; le 8e (M) en $01..$04 :
0471   0000                                                     ; il n'y a que 31 codes libres apres
0472   0000                                                     ; la police. Voir icon_base.
0473   0000             ICON_FIRST_M    .equ    $01             ; icone du 8e pouvoir (M). 4 glyphes
0474   0000                                                     ; par icone : HG, HD, BG, BD
0475   0000             PNL_SEL_BG      .equ    $04             ; fond BLEU (bits 2-0 = B G R) du
0476   0000                                                     ; pouvoir selectionne
0477   0000             PNL_FG_ZERO     .equ    $20             ; libelle en ROUGE quand il n'en reste
0478   0000                                                     ; plus (bits 7-5 = B G R)
0479   0000             MOUSE_BTN1      .equ    $40             ; bit du bouton 1 (attribuer) dans
0480   0000             MOUSE_BTN2      .equ    $20             ; l'octet P49 : NON VERIFIE lequel est
0481   0000                                                     ; le gauche -- permuter ces deux
0482   0000                                                     ; valeurs si les boutons sont inverses
0483   0000             
0484   0000             KEY_MOUSE       .equ    $53             ; 'S' majuscule : bascule la souris
0485   0000             KEY_MOUSE_LC    .equ    $73             ; 's' minuscule
0486   0000             
0487   0000             ; --- variables (SRAM) -------------------------------------------------------
0488   0000             tmp_a           .equ    $C400           ; ligne de balayage courante (0..199)
0489   0000             tmp_b           .equ    $C40C           ; 2e motif, dans cur_draw
0490   0000             tmp_c           .equ    $C40D           ; octet de fond relu, dans cd_getsave
0491   0000             ; --- parcours de la carte de tuiles ----------------------------------------
0492   0000             cur_screen      .equ    $C40E           ; ecran affiche, 0..LV_NSCREENS-1
0493   0000             tline           .equ    $C40F           ; ligne DANS la tuile, 0..9
0494   0000             mrow_hi         .equ    $C410           ; debut de la rangee de tuiles
0495   0000             mrow_lo         .equ    $C411           ; courante, dans la carte
0496   0000             tb_hi           .equ    $C412           ; lv_tiles + tline*3 : adresse de la
0497   0000             tb_lo           .equ    $C413           ; bonne ligne dans CHAQUE tuile
0498   0000             tid             .equ    $C414           ; index de tuile lu dans la carte
0499   0000             ; --- parametres de vram_line_addr (routine partagee) -----------------------
0500   0000             a_xseg          .equ    $C415           ; colonne, en segments de 8 px
0501   0000             a_yline         .equ    $C416           ; ligne de balayage absolue
0502   0000             ; --- lemming ---------------------------------------------------------------
0503   0000             ; ERREUR DE CONCEPTION CORRIGEE : lem_tick etait un compteur UNIQUE,
0504   0000             ; commun a tous les lemmings. Consequence : toutes les LEM_STEP_DELAY
0505   0000             ; lignes de tick, les DIX marchaient exactement au meme instant -- jamais
0506   0000             ; etales dans le temps. Quand ils se trouvent tous sur l'ecran affiche,
0507   0000             ; chacun declenche un redessin complet (~2.9 ms) plus l'effacement de sa
0508   0000             ; trace (~1.6 ms) : jusqu'a ~45 ms d'un coup, toutes les 160 ms, alors
0509   0000             ; qu'un seul tick ne vaut que 10 ms -- le jeu n'a plus le temps de
0510   0000             ; rattraper son retard, d'ou le ralentissement observe (viseur ET
0511   0000             ; lemmings, puisque les deux passent par le meme mecanisme de rattrapage).
0512   0000             ; Un compteur INDEPENDANT par lemming etale naturellement leurs pas : le
0513   0000             ; delai entre deux naissances (SPAWN_TICKS=200) et le rythme de marche
0514   0000             ; (LEM_STEP_DELAY=16) ne sont pas multiples l'un de l'autre (200 mod 16
0515   0000             ; = 8), donc des compteurs qui repartent chacun de zero a la naissance se
0516   0000             ; decalent d'eux-memes, sans code special pour ca.
0517   0000             lem_tick        .equ    $C7B9           ; [NUM_LEM] rythme de marche,
0518   0000                                                     ; INDIVIDUEL
0519   0000             ll_ctr          .equ    $C41C           ; compteur de lignes du sprite
0520   0000             lp_hi           .equ    $C41D           ; pointeur courant dans les donnees
0521   0000             lp_lo           .equ    $C41E           ; de la vignette (lecture sequentielle)
0522   0000             lem_mask        .equ    $C41F           ; octet de masque du segment en cours
0523   0000             lem_spr         .equ    $C4C0           ; octet de plan du sprite
0524   0000             ; Un lemming par indice : toutes ces variables sont des TABLEAUX de
0525   0000             ; NUM_LEM octets, lus et ecrits via "lda @cur_lem / mov A,B / lda @tab(B)".
0526   0000             ; cur_lem designe le lemming en cours de traitement.
0527   0000             cur_lem         .equ    $C4C1           ; indice du lemming traite
0528   0000             spawn_timer     .equ    $C4C2           ; ticks avant la prochaine apparition
0529   0000             spawn_next      .equ    $C4C9           ; indice du prochain a faire naitre
0530   0000             lem_xseg        .equ    $C520           ; [NUM_LEM] colonne, en segments
0531   0000             lem_y           .equ    $C52A           ; [NUM_LEM] ligne de balayage
0532   0000             lem_frame       .equ    $C534           ; [NUM_LEM] vignette courante
0533   0000             lem_screen      .equ    $C53E           ; [NUM_LEM] ecran ou il se trouve
0534   0000             lem_old_xseg    .equ    $C548           ; [NUM_LEM] position avant le pas
0535   0000             lem_alive       .equ    $C552           ; [NUM_LEM] 1 = deja apparu
0536   0000             lem_state       .equ    $C55C           ; [NUM_LEM] ST_WALK ou ST_FALL
0537   0000             lem_old_y       .equ    $C566           ; [NUM_LEM] ligne avant le pas
0538   0000             lem_dir         .equ    $C570           ; [NUM_LEM] 0 = vers la droite,
0539   0000                                                     ; 1 = vers la gauche
0540   0000             lem_float       .equ    $C6BB           ; [NUM_LEM] competences PERMANENTES :
0541   0000                                                     ; bit 0 = parachute (EQUIP_FLOAT),
0542   0000                                                     ; bit 1 = grimpeur (EQUIP_CLIMB).
0543   0000                                                     ; C'est un ATTRIBUT durable, pas un
0544   0000                                                     ; etat : le lemming marche et creuse
0545   0000                                                     ; normalement, le parachute ne sert
0546   0000                                                     ; qu'au moment des chutes.
0547   0000             tile_row        .equ    $C6D0           ; 40 octets : index de tuile resolu
0548   0000                                                     ; pour la rangee courante ($C6D0-F7)
0549   0000             lem_bomb        .equ    $C6F8           ; [NUM_LEM] compte a rebours du
0550   0000                                                     ; kamikaze ; 0 = non amorce
0551   0000             bx0             .equ    $C702           ; bornes de la zone detruite,
0552   0000             bx1             .equ    $C703           ; en tuiles
0553   0000             by0             .equ    $C704
0554   0000             by1             .equ    $C705
0555   0000             bw              .equ    $C708           ; largeur et hauteur de la zone,
0556   0000             bh              .equ    $C709           ; en tuiles
0557   0000             bcol            .equ    $C706           ; parcours de cette zone
0558   0000             brow            .equ    $C707
0559   0000             bcol_n          .equ    $C70A           ; compteurs de parcours
0560   0000             brow_n          .equ    $C70B
0561   0000             bomb_bar        .equ    $C70C           ; barre de compte a rebours dessinee
0562   0000                                                     ; sur la ligne 0 du sprite ; 0 si le
0563   0000                                                     ; lemming n'est pas amorce
0564   0000             lem_build       .equ    $C79E           ; [NUM_LEM] briques restantes
0565   0000                                                     ; derniere montee
0566   0000             ; liste des tuiles posees : cle = ecran*LV_MAP_H + rangee, plus la colonne
0567   0000             build_key       .equ    $C70D           ; [MAX_BUILT] (48) $C70D-$C73C
0568   0000             build_col       .equ    $C73D           ; [MAX_BUILT] (48) $C73D-$C76C
0569   0000             build_tile      .equ    $C76D           ; [MAX_BUILT] (48) QUELLE tuile
0570   0000                                                     ; par entree : $C76D-$C79C. Avant,
0571   0000                                                     ; une case "construite" valait
0572   0000                                                     ; toujours BUILD_TILE ; les marches
0573   0000                                                     ; d'escalier ont chacune leur propre
0574   0000                                                     ; tuile (A, B, pleine), il faut donc
0575   0000                                                     ; s'en souvenir au lieu de la deduire.
0576   0000             build_n         .equ    $C79D           ; nombre d'entrees utilisees
0577   0000             bkey            .equ    $C7A8           ; cle recherchee, variable de travail
0578   0000             bidx            .equ    $C7A9           ; index de parcours de la liste
0579   0000             any_stepped     .equ    $C7CE           ; 1 si au moins un lemming a
0580   0000                                                     ; reellement bouge ce passage --
0581   0000                                                     ; evite de redessiner le viseur en
0582   0000                                                     ; pure perte quand personne n'a
0583   0000                                                     ; encore atteint son tour
0584   0000             rtc_scr         .equ    $C7D3           ; ecran memorise (fait partie de la
0585   0000                                                     ; cle : voir rect_tileptr)
0586   0000             sf_ovh          .equ    $C511           ; surface_find : bas d'un surplomb
0587   0000                                                     ; trouve au-dessus d'une base vide
0588   0000             bt_arg          .equ    $C510           ; (deplace de $C7DE : place du 8e
0589   0000                                                     ; compteur de pouvoir)           ; tuile a memoriser, passee a
0590   0000                                                     ; built_add (voir sa note)
0591   0000             bt_found        .equ    $C7DF           ; index trouve par built_test --
0592   0000                                                     ; l'appelant lit build_tile(bt_found)
0593   0000             tmp_d           .equ    $C7E0           ; scratch, lst_build (escalier)
0594   0000             tmp_g           .equ    $C7E1           ; scratch, lst_build : rangee de
0595   0000                                                     ; tuiles ciblee (B), sauvegardee
0596   0000                                                     ; avant qu'un appel ne l'ecrase
0597   0000             saved_count     .equ    $C7E2           ; nombre de lemmings sauves (a la
0598   0000                                                     ; sortie) depuis le debut du niveau
0599   0000             
0600   0000             ; --- souris ExelMouse, protocole P49/P50 autonome (sans dependance ROM,
0601   0000             ; comme dans exelnoid) : mouse_enabled bascule avec S, conserve entre les
0602   0000             ; niveaux. mouse_btn_old est l'octet BRUT lu au port P49 lors de la passe 1
0603   0000             ; (boutons dans les bits 6-5) ; mouse_btn_latch empeche un bouton maintenu
0604   0000             ; d'agir a chaque tick (detection de FRONT, pas de niveau).
0605   0000             mouse_enabled   .equ    $C7E3
0606   0000             mouse_dy        .equ    $C7E4           ; delta Y signe (delta X reutilise
0607   0000                                                     ; TEMP1, comme dans exelnoid)
0608   0000             mouse_btn_old   .equ    $C7E5
0609   0000             mouse_btn_latch .equ    $C7E6
0610   0000             
0611   0000             ; --- deplacement du viseur "au temps reel" (voir cur_move_n) ---------------
0612   0000             pass_ticks      .equ    $C7E7           ; ticks consommes depuis le debut de
0613   0000                                                     ; ce passage dans main_loop
0614   0000             cur_nx          .equ    $C7E8           ; position VISEE, calculee avant de
0615   0000             cur_ny          .equ    $C7E9           ; toucher a l'ecran (cur_commit)
0616   0000             cur_steps       .equ    $C7EA           ; nombre de pas a faire
0617   0000             cur_bdir        .equ    $C7EB           ; 0=gauche 1=droite 2=haut 3=bas
0618   0000             
0619   0000             ; --- filtre rapide de built_test : 1 bit par rangee (cle = ecran*20 +
0620   0000             ; rangee, 0..99), pose a chaque built_add, efface seulement au demarrage.
0621   0000             ; Les entrees de la liste ne sont jamais retirees (une brique creusee garde
0622   0000             ; son entree, tuile 0), donc un bit a 0 garantit qu'AUCUNE tuile posee
0623   0000             ; n'existe dans cette rangee : on evite le parcours complet de la liste.
0624   0000             cur_pending     .equ    $C7F9           ; 1 = un deplacement du viseur est
0625   0000                                                     ; demande (cur_nx/cur_ny), a appliquer
0626   0000                                                     ; a ml_next
0627   0000             skill_sel       .equ    $C7FA           ; pouvoir selectionne (0..5)
0628   0000             give_ok         .equ    $C7FB           ; 1 = la derniere attribution a reussi
0629   0000             spawn_count     .equ    $C7FD           ; lemmings deja sortis (0..LV_LEM_COUNT)
0630   0000             level_over      .equ    $C7FE           ; 1 = niveau termine (GAGNE / PERDU)
0631   0000             mouse_act       .equ    $C7FC           ; appuis de boutons a traiter
0632   0000                                                     ; (MOUSE_BTN1 / MOUSE_BTN2)
0633   0000             built_rows      .equ    $C7EC           ; 13 octets : $C7EC..$C7F8 (cle max
0634   0000                                                     ; 4*20+19 = 99 avec 5 ecrans EXELTILE)
0635   0000             rtc_valid       .equ    $C7CF           ; cache de rect_tileptr : 0 = vide
0636   0000             rtc_col         .equ    $C7D0           ; colonne memorisee
0637   0000             rtc_row         .equ    $C7D1           ; rangee memorisee
0638   0000             rtc_tid         .equ    $C7D2           ; index de tuile resolu
0639   0000             tk_i            .equ    $C7CD           ; index de parcours des rythmes
0640   0000             sf_ctr          .equ    $C7B8           ; compteur des boucles de sondage --
0641   0000                                                     ; PAS TEMP5 : built_test l'utilise
0642   0000                                                     ; aussi comme compteur (parcours de
0643   0000                                                     ; sa propre liste), et l'appelle
0644   0000                                                     ; depuis PIX_SOLID a chaque tour de
0645   0000                                                     ; ces boucles. TEMP5 se faisait donc
0646   0000                                                     ; ecraser silencieusement a chaque
0647   0000                                                     ; iteration -- le nombre reel de
0648   0000                                                     ; tours dependait de build_n (le
0649   0000                                                     ; nombre de briques deja posees), pas
0650   0000                                                     ; de MAX_STEP_UP/DOWN. Explique
0651   0000                                                     ; exactement le profil observe : la
0652   0000                                                     ; marche 1 passait par chance (peu
0653   0000                                                     ; d'entrees dans la liste a ce
0654   0000                                                     ; moment), la marche 2 echouait
0655   0000                                                     ; (plus d'entrees, plus de
0656   0000                                                     ; corruption).
0657   0000             ; --- niveau courant (plusieurs niveaux, plusieurs jeux de tuiles "themes") :
0658   0000             ; valeurs copiees depuis les tables de leveldata.asm par level_load, au
0659   0000             ; debut de chaque niveau. Deux trous libres de la SRAM : $C7AA-$C7B3 et
0660   0000             ; $C7D4-$C7DD (ancien lem_cyc_y, supprime).
0661   0000             cur_level       .equ    $C7AA           ; 0..LV_NLEVELS-1, garde d'un niveau
0662   0000                                                     ; a l'autre (seul le demarrage a
0663   0000                                                     ; froid le remet a 0)
0664   0000             tiles_lo        .equ    $C7AB           ; adresse des tuiles du THEME du
0665   0000             tiles_hi        .equ    $C7AC           ; niveau (ex-constante lv_tiles)
0666   0000             flags_lo        .equ    $C7AD           ; adresse de leurs proprietes
0667   0000             flags_hi        .equ    $C7AE           ; (ex-constante lv_flags)
0668   0000             cur_map_base    .equ    $C7AF           ; cur_level*3 : index de son premier
0669   0000                                                     ; ecran dans lv_map_hi/lo
0670   0000             cur_nscr        .equ    $C7B0           ; nombre d'ecrans du niveau (1..3)
0671   0000             cur_lem_count   .equ    $C7B1           ; lemmings a faire sortir
0672   0000             cur_to_save     .equ    $C7B2           ; lemmings a sauver
0673   0000             cur_spawn_scr   .equ    $C7B3           ; point de depart : ecran,
0674   0000             cur_spawn_col   .equ    $C7D4           ; colonne (segments),
0675   0000             cur_spawn_y     .equ    $C7D5           ; ligne de balayage
0676   0000             level_won       .equ    $C7D6           ; 1 = GAGNE (Espace -> niveau suivant)
0677   0000             skill_cnt       .equ    $C7D7           ; 8 octets ($C7D7-$C7DE) : pouvoirs
0678   0000                                                     ; restants, dans l'ordre du panneau
0679   0000                                                     ; (C D H B F E G M)
0680   0000             build_up        .equ    $C7B4           ; 1 = la brique en cours fait monter
0681   0000             sf_base         .equ    $C7B5           ; ligne de depart du sondage
0682   0000             sf_s            .equ    $C7B6           ; ligne courante du sondage
0683   0000             sf_y            .equ    $C7B7           ; lem_y resultant
0684   0000             drow_hi         .equ    $C6C9           ; pointeur sur les 5 octets de bits
0685   0000             drow_lo         .equ    $C6CA           ; creuses de la rangee courante
0686   0000             dig_cur         .equ    $C6CB           ; octet de bits en cours de lecture
0687   0000             dig_bit         .equ    $C6CC           ; masque du bit de la colonne
0688   0000             new_col         .equ    $C6C8           ; colonne d'arrivee apres transition
0689   0000             new_scr         .equ    $C6C7           ; ecran vise lors d'une transition.
0690   0000                                                     ; PAS tmp_c : rect_mapptr s'en sert,
0691   0000                                                     ; et l'effacement de l'ancienne
0692   0000                                                     ; position passe par elle -- le
0693   0000                                                     ; numero d'ecran etait ecrase en
0694   0000                                                     ; cours de route.
0695   0000             spr_mirror      .equ    $C6C6           ; 1 = dessiner le sprite en miroir
0696   0000             fall_step       .equ    $C6C5           ; hauteur du pas de descente courant
0697   0000                                                     ; (FALL_STEP ou FLOAT_STEP)
0698   0000             blk_col         .equ    $C6B6           ; colonne testee par blocker_at
0699   0000             blk_self        .equ    $C6B7           ; le marcheur qui pose la question
0700   0000             blk_scr         .equ    $C6B8           ; son ecran et sa ligne, pour le
0701   0000             blk_y           .equ    $C6B9           ; test de recouvrement vertical
0702   0000             blk_i           .equ    $C6BA           ; index de parcours
0703   0000             lem_fall        .equ    $C6AC           ; [NUM_LEM] lignes deja parcourues
0704   0000                                                     ; dans la chute en cours, puis
0705   0000                                                     ; compte a rebours apres la mort
0706   0000             dig_map         .equ    $C580           ; 3 x 100 octets : 1 bit par case
0707   0000             d_col           .equ    $C4CB           ; colonne interrogee par dig_locate
0708   0000             dig_mask        .equ    $C4CE           ; masque du bit dans son octet
0709   0000             sel_lem         .equ    $C4CF           ; lemming designe par le viseur,
0710   0000                                                     ; $FF si aucun
0711   0000             ; --- rectangle de fond a regenerer depuis la carte -------------------------
0712   0000             r_xseg          .equ    $C4C3
0713   0000             r_wseg          .equ    $C4C4
0714   0000             r_yline         .equ    $C4C5
0715   0000             r_hlines        .equ    $C4C6
0716   0000             q_row           .equ    $C4C7           ; rangee de tuiles correspondant a
0717   0000             q_line          .equ    $C4C8           ; r_yline, et ligne dans la tuile
0718   0000             map_screen      .equ    $C4CA           ; ecran dont on consulte la carte
0719   0000             ; Fond regenere sous le lemming, AVANT composition : 2 segments x 3 plans
0720   0000             ; x 10 lignes = 60 octets. Ce n'est plus une copie de l'ecran (qui pouvait
0721   0000             ; contenir un autre sprite) mais le decor recalcule depuis la carte.
0722   0000             LEM_BG_SIZE     .equ    60
0723   0000             lem_bg          .equ    $C4D0
0724   0000             ; ($C510-$C515 : libres -- ancien skill_cnt, deplace en $C7D7 a l'ajout du
0725   0000             ; 7e pouvoir, le grimpeur)
0726   0000             key_rpt         .equ    $C516           ; images restantes avant repetition
0727   0000             rpt_flag        .equ    $C517           ; 1 = l'action courante vient d'une
0728   0000                                                     ; repetition, pas d'un nouvel appui
0729   0000             tick_cnt        .equ    $C518           ; incremente par l'interruption timer
0730   0000             tick_seen       .equ    $C519           ; derniere valeur traitee par la
0731   0000                                                     ; boucle principale
0732   0000             lem_pending     .equ    $C7C3           ; [NUM_LEM] 1 = pas du POUR CE
0733   0000                                                     ; lemming precisement (plus un
0734   0000                                                     ; drapeau global commun)
0735   0000             spawn_pending   .equ    $C51B           ; 1 = une naissance est due
0736   0000             cur_xseg        .equ    $C406           ; position du viseur, en segments
0737   0000             cur_y           .equ    $C407           ; et en lignes de balayage
0738   0000             cur_dirty       .equ    $C408           ; 1 = une sauvegarde est valide
