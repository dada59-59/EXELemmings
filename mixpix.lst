1150   125E                     ; TAB : pouvoir suivant (surbrillance seulement), sans repetition
1151   125E 2D 09               cmp     %KEY_TAB,A
1152   1260 E6 0E               jne     @ml_chk_space
1153   1262 8A C5 17            lda     @rpt_flag
1154   1265 E2 03               jeq     @mtab_go
