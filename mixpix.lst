0740   0000             ; plans = 96 octets. C'est tout l'interet du bitmap ici -- on se SOUVIENT
0741   0000             ; de ce qui etait la, au lieu de le reconstruire logiquement comme il a
0742   0000             ; fallu le faire en mode texte (get_cell_char dans lemproto.asm).
0743   0000             CUR_SAVE_SIZE   .equ    96
