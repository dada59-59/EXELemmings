2650   1D4D             ; (lem_getspr_m, lem_getspr, lem_getbg : mis en ligne dans ldw_seg pour
2651   1D4D             ;  eviter les CALL dans la boucle chaude -- ces routines separees
2652   1D4D             ;  n'existent plus)
2653   1D4D             
2654   1D4D             ; --- BARRE DE COMPTE A REBOURS
2655   1D4D             ; Dessinee sur la LIGNE 0 du sprite, donc a l'interieur de son rectangle :
2656   1D4D             ; aucune zone supplementaire a effacer, et l'effet marche pour les sept
2657   1D4D             ; etats sans dupliquer le moindre sprite.
2658   1D4D             ; Elle est ROUGE : on force donc les plans Bleu et Vert a 0 et le plan
2659   1D4D             ; Rouge a 1 sur les pixels concernes.
2660   1D4D             ; bar_clear sert aux plans B et G, bar_set au plan R. Hors de la ligne 0,
2661   1D4D             ; ou si le lemming n'est pas amorce, les deux laissent A inchange.
2662   1D4D             ; (bar_clear, bar_set : mis en ligne dans ldw_seg, meme raison)
2663   1D4D             
2664   1D4D             ; --- calcule la barre du lemming cur_lem : (compte>>2)+1 pixels, plafonne
2665   1D4D             ; a 8, alignes a gauche. Elle retrecit donc a mesure que le temps passe.
2666   1D4D             bomb_bar_calc:
2667   1D4D 8A C4 C1            lda     @cur_lem
2668   1D50 C0                  mov     A,B
2669   1D51 AA C6 F8            lda     @lem_bomb(B)
2670   1D54 E6 04               jne     @bbc_armed
2671   1D56 8B C7 0C            sta     @bomb_bar               ; 0 : pas de barre
2672   1D59 0A                  rets
2673   1D5A             bbc_armed:
2674   1D5A BC                  rr      A                       ; compte / 4
2675   1D5B BC                  rr      A
2676   1D5C 23 3F               and     %$3F,A                  ; les rr font tourner, pas decaler :
2677   1D5E                                                     ; on jette les bits remontes en haut
2678   1D5E B3                  inc     A
2679   1D5F 2D 09               cmp     %9,A
2680   1D61 E7 02               jnc     @bbc_ok                 ; jnc : <= 8
2681   1D63 22 08               mov     %8,A
2682   1D65             bbc_ok:
2683   1D65 D0 1A               mov     A,TEMP7                 ; nombre de pixels
2684   1D67 B5                  clr     A
2685   1D68             bbc_loop:
2686   1D68 07                  setc
2687   1D69 BD                  rrc     A                       ; amene un 1 par la gauche
2688   1D6A D2 1A               dec     TEMP7
2689   1D6C E6 FA               jne     @bbc_loop
2690   1D6E 8B C7 0C            sta     @bomb_bar
2691   1D71 0A                  rets
2692   1D72             
2693   1D72             ; (lem_compose : mise en ligne dans ldw_seg, meme raison)
2694   1D72             
2695   1D72             ; --- dessine le lemming : fond recalcule + composition + UNE seule ecriture
2696   1D72             ; par octet. Ne fait rien si le lemming n'est pas sur l'ecran affiche. ------
2697   1D72             lem_draw:
2698   1D72                     ; Dessine le lemming cur_lem. Ne fait rien s'il n'est pas encore
2699   1D72                     ; apparu, ou s'il se trouve sur un autre ecran que celui affiche.
2700   1D72 8A C4 C1            lda     @cur_lem
2701   1D75 C0                  mov     A,B
2702   1D76 AA C5 52            lda     @lem_alive(B)
2703   1D79 E6 01               jne     @ld_alive
2704   1D7B 0A                  rets
2705   1D7C             ld_alive:
2706   1D7C 8A C4 C1            lda     @cur_lem
2707   1D7F C0                  mov     A,B
2708   1D80 AA C5 3E            lda     @lem_screen(B)
2709   1D83 8D C4 0E            cmpa    @cur_screen
2710   1D86 E2 01               jeq     @lem_draw_go
2711   1D88 0A                  rets
2712   1D89             lem_draw_go:
2713   1D89 8A C4 C1            lda     @cur_lem                ; le fond sous sa position courante
2714   1D8C C0                  mov     A,B
2715   1D8D AA C5 20            lda     @lem_xseg(B)
2716   1D90 8B C4 C3            sta     @r_xseg
2717   1D93 22 01               mov     %LEM_WSEG,A
2718   1D95 8B C4 C4            sta     @r_wseg
2719   1D98 8A C4 C1            lda     @cur_lem
2720   1D9B C0                  mov     A,B
2721   1D9C AA C5 2A            lda     @lem_y(B)
2722   1D9F 8B C4 C5            sta     @r_yline
2723   1DA2 22 0A               mov     %LEM_HLINES,A
2724   1DA4 8B C4 C6            sta     @r_hlines
2725   1DA7 8E 1B B1            call    @bg_fill_buf
2726   1DAA             
2727   1DAA                     ; --- adresse de la vignette : index = etat*LEM_MAXFRAMES + vignette
2728   1DAA                     ; Les etats ST_WALK/ST_FALL/ST_DIG valent 0/1/2 et correspondent
2729   1DAA                     ; exactement aux types 0/1/2 dessines dans EXELLEM (marche, chute,
2730   1DAA                     ; creuse) : le sprite suit donc l'etat sans table de correspondance.
2731   1DAA                     ; Une version anterieure lisait toujours lem_frames0_* : le lemming
