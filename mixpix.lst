6025   3335 E2 02               jeq     @lspt_done              ; aucune : marcheur ordinaire (A = 0)
6026   3337 28 0B               add     %LT_WALK_F-1,A          ; 1 -> 12, 2 -> 13, 3 -> 14
6027   3339             lspt_done:
