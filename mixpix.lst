3880   24FC C0                  mov     A,B
3881   24FD AA C6 AC            lda     @lem_fall(B)
3882   2500 E2 39               jeq     @lsdd_gone              ; deja a zero : plus rien a faire
3883   2502 B2                  dec     A
3884   2503 8B C4 0D            sta     @tmp_c
