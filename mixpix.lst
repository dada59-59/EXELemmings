1620+  6E85~            	lvdp
1621+  6E85~            	and %$E7,A
1622+  6E85~            	or TEMP4,A
1623+  6E85~            	wvdp(A)
1624+  6E85~            	lvdp
1625+  6E85~            	wvdp(A)
1626+  6E85~            	djnz B,_rept2
1627+  6E85~            	add %LENGTHLINE,TEMP3
