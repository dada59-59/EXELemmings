2314   1A48             
2315   1A48             ; --- TEMP2 = adresse dans la carte de la case (q_row, r_xseg + colonne) ----
2316   1A48             ; Entree : q_row pose, A = numero de colonne a ajouter a r_xseg.
2317   1A48             ; L'ecran consulte est map_screen, PAS cur_screen : on doit pouvoir
2318   1A48             ; interroger la carte d'un lemming qui se trouve sur un autre ecran que
2319   1A48             ; celui affiche (pour savoir s'il a du sol sous les pieds).
2320   1A48             rect_mapptr:
2321   1A48 8B C4 0D            sta     @tmp_c                  ; colonne relative
2322   1A4B 8A C4 CA            lda     @map_screen             ; index = premier ecran du niveau +
2323   1A4E C0                  mov     A,B                     ; ecran consulte
2324   1A4F 8A C7 AF            lda     @cur_map_base
2325   1A52 68                  add     B,A
2326   1A53 C0                  mov     A,B
2327   1A54 AA 5C 8C            lda     @lv_map_hi(B)
2328   1A57 D0 0F               mov     A,TEMP2-1
2329   1A59 AA 5C 8F            lda     @lv_map_lo(B)
2330   1A5C D0 10               mov     A,TEMP2
2331   1A5E 8A C4 C7            lda     @q_row                  ; + q_row * LV_MAP_W
2332   1A61 2C 28               mpy     %LV_MAP_W,A
2333   1A63 D0 18               mov     A,TEMP6
2334   1A65 D1 1A               mov     B,TEMP7
2335   1A67 48 1A 10            add     TEMP7,TEMP2
2336   1A6A 49 18 0F            adc     TEMP6,TEMP2-1
2337   1A6D 8A C4 C3            lda     @r_xseg                 ; + r_xseg + colonne
2338   1A70 C0                  mov     A,B
2339   1A71 8A C4 0D            lda     @tmp_c
2340   1A74 68                  add     B,A
2341   1A75 D0 1A               mov     A,TEMP7
2342   1A77 B5                  clr     A
2343   1A78 D0 18               mov     A,TEMP6
2344   1A7A 48 1A 10            add     TEMP7,TEMP2
2345   1A7D 49 18 0F            adc     TEMP6,TEMP2-1
2346   1A80 0A                  rets
2347   1A81             
2348   1A81             ; --- TEMP1 = adresse des 3 octets de la tuile pointee par TEMP2 ------------
2349   1A81             ; Consulte la couche de destruction AVANT la carte : une case creusee doit
2350   1A81             ; s'afficher vide, sinon le trou creuse resterait invisible a l'ecran.
2351   1A81             ; La colonne reelle est r_xseg + tmp_b (tmp_b = rang dans le rectangle en
2352   1A81             ; cours de parcours), d'ou le passage par d_col.
2353   1A81             ; --- CACHE DE RESOLUTION -------------------------------------------------
2354   1A81             ; La resolution d'une case (liste des briques posees, couche creusee, puis
2355   1A81             ; carte ROM) coute ~70 instructions, dominees par dig_locate (MPY + trois
2356   1A81             ; decalages + calcul d'adresse). Or bg_fill_buf et bg_draw_rect appellent
2357   1A81             ; cette routine UNE FOIS PAR LIGNE : pour un sprite d'un segment de large
2358   1A81             ; et dix lignes de haut, cela fait 20 appels par lemming et par pas, alors
2359   1A81             ; que le sprite ne couvre qu'UNE colonne et au plus DEUX rangees de tuiles
2360   1A81             ; -- donc au plus deux resultats distincts. Environ 51 ms de recalcul
2361   1A81             ; strictement identique sur dix lemmings, pour un budget de 10 ms par tick.
2362   1A81             ; On memorise donc la derniere case resolue : tant que la colonne ET la
2363   1A81             ; rangee n'ont pas change, on reutilise le resultat.
2364   1A81             ; rtc_valid est invalide des qu'une case est creusee ou une brique posee.
2365   1A81             rect_tileptr:
2366   1A81 8A C4 C3            lda     @r_xseg
2367   1A84 C0                  mov     A,B
2368   1A85 8A C4 0C            lda     @tmp_b
2369   1A88 68                  add     B,A
2370   1A89 8B C4 CB            sta     @d_col
2371   1A8C             
2372   1A8C 8A C7 CF            lda     @rtc_valid              ; le cache est-il utilisable ?
2373   1A8F E2 21               jeq     @rtp_resolve
2374   1A91 8A C4 CA            lda     @map_screen             ; l'ECRAN fait partie de la cle :
2375   1A94 8D C7 D3            cmpa    @rtc_scr                ; rect_tileptr sert aussi bien le
2376   1A97 E6 19               jne     @rtp_resolve            ; decor affiche que la carte d'un
2377   1A99                                                     ; lemming hors champ
2378   1A99 8A C4 CB            lda     @d_col
2379   1A9C 8D C7 D0            cmpa    @rtc_col
2380   1A9F E6 11               jne     @rtp_resolve
2381   1AA1 8A C4 C7            lda     @q_row
2382   1AA4 8D C7 D1            cmpa    @rtc_row
2383   1AA7 E6 09               jne     @rtp_resolve
2384   1AA9 8A C7 D2            lda     @rtc_tid                ; meme case : on reutilise
2385   1AAC 8B C4 14            sta     @tid
2386   1AAF 8C 1A F2            br      @rtp_addr
2387   1AB2             rtp_resolve:
2388   1AB2                     ; Les tuiles POSEES sont consultees ici aussi. Sans cela, seul le
2389   1AB2                     ; redessin plein ecran les affichait : une brique fraichement posee
2390   1AB2                     ; restait invisible, l'escalier ne se voyait pas se construire.
2391   1AB2 8E 20 96            call    @built_test
2392   1AB5 E2 0D               jeq     @rtp_nobuild
2393   1AB7 8A C7 DF            lda     @bt_found               ; QUELLE tuile : plus toujours
2394   1ABA C0                  mov     A,B                     ; BUILD_TILE (marches d'escalier)
2395   1ABB AA C7 6D            lda     @build_tile(B)
2396   1ABE 8B C4 14            sta     @tid
2397   1AC1 8C 1A F2            br      @rtp_addr
2398   1AC4             rtp_nobuild:
2399   1AC4 8E 21 70            call    @dig_test               ; n'ecrase pas TEMP2 (il n'utilise
2400   1AC7                                                     ; que TEMP1, TEMP3 et TEMP6-8)
2401   1AC7 E2 07               jeq     @rtp_map
2402   1AC9 B5                  clr     A                       ; creusee : tuile 0 (vide)
2403   1ACA 8B C4 14            sta     @tid
2404   1ACD 8C 1A F2            br      @rtp_addr
2405   1AD0             rtp_map:
2406   1AD0 9A 10               lda     *TEMP2
2407   1AD2 8B C4 14            sta     @tid
2408   1AD5 8A C4 CA            lda     @map_screen             ; memorise la case resolue
2409   1AD8 8B C7 D3            sta     @rtc_scr
2410   1ADB 8A C4 CB            lda     @d_col
2411   1ADE 8B C7 D0            sta     @rtc_col
2412   1AE1 8A C4 C7            lda     @q_row
2413   1AE4 8B C7 D1            sta     @rtc_row
2414   1AE7 8A C4 14            lda     @tid
2415   1AEA 8B C7 D2            sta     @rtc_tid
2416   1AED 22 01               mov     %1,A
2417   1AEF 8B C7 CF            sta     @rtc_valid
2418   1AF2             rtp_addr:
2419   1AF2 8A C4 13            lda     @tb_lo
2420   1AF5 D0 0E               mov     A,TEMP1
2421   1AF7 8A C4 12            lda     @tb_hi
2422   1AFA D0 0D               mov     A,TEMP1-1
2423   1AFC 8A C4 14            lda     @tid
2424   1AFF 2C 1E               mpy     %LV_TILE_BYTES,A
2425   1B01 D0 18               mov     A,TEMP6
2426   1B03 D1 1A               mov     B,TEMP7
2427   1B05 48 1A 0E            add     TEMP7,TEMP1
2428   1B08 49 18 0D            adc     TEMP6,TEMP1-1
2429   1B0B 0A                  rets
2430   1B0C             
2431   1B0C             ; --- redessine directement en VRAM le rectangle (r_xseg, r_yline,
2432   1B0C             ; r_wseg x r_hlines) depuis la carte. Sert a effacer un sprite. ------------
2433   1B0C             bg_draw_rect:
2434   1B0C                     ; --- PAR COLONNE, et la tuile n'est resolue qu'une fois par rangee
2435   1B0C                     ; (1 a 2 fois pour 10 a 16 lignes). Avant, chaque LIGNE refaisait
2436   1B0C                     ; rect_tilebase + rect_mapptr (un MPY) + rect_tileptr (un 2e MPY et
2437   1B0C                     ; une dizaine de comparaisons en SRAM, meme sur le cache) : ~1000
2438   1B0C                     ; cycles par ligne, soit ~10 000 pour effacer un lemming et ~23 000
2439   1B0C                     ; pour effacer le viseur. Ici : pointeur de tuile (TEMP1) et adresse
2440   1B0C                     ; VRAM (BG_PTR) en REGISTRES, avances de 3 octets et d'une ligne
2441   1B0C                     ; ecran : ~250 cycles par ligne. Les lignes d'une tuile sont
2442   1B0C                     ; contigues (3 octets B,G,R par ligne), d'ou le simple +3.
2443   1B0C                     ; BG_PTR (R29:R30) et PAS TEMP3 : dig_test, appele par la
2444   1B0C                     ; resolution d'une tuile, se sert de TEMP3 (erreur trouvee par
2445   1B0C                     ; simulation : le decor s'ecrivait en SRAM, dans dig_map). BG_PTR
2446   1B0C                     ; n'est utilise nulle part ailleurs dans ce programme.
2447   1B0C 8A C4 0E            lda     @cur_screen             ; le decor dessine est celui affiche
2448   1B0F 8B C4 CA            sta     @map_screen
2449   1B12 B5                  clr     A
2450   1B13 8B C4 0C            sta     @tmp_b                  ; colonne dans le rectangle
2451   1B16             bdr_col:
2452   1B16 8E 18 11            call    @rect_rowline           ; q_row / q_line de la 1re ligne
2453   1B19 8A C4 C5            lda     @r_yline                ; adresse VRAM de la 1re ligne de
2454   1B1C 8B C4 16            sta     @a_yline                ; cette colonne
2455   1B1F 8A C4 C3            lda     @r_xseg
2456   1B22 C0                  mov     A,B
2457   1B23 8A C4 0C            lda     @tmp_b
2458   1B26 68                  add     B,A
2459   1B27 8B C4 15            sta     @a_xseg
2460   1B2A 8E 16 A0            call    @vram_line_addr
2461   1B2D 8A C4 05            lda     @tv_lo
2462   1B30 D0 1E               mov     A,BG_PTR
2463   1B32 8A C4 04            lda     @tv_hi
2464   1B35 D0 1D               mov     A,BG_PTR-1
2465   1B37 8E 1B A4            call    @bg_resolve             ; TEMP1 = octets de la tuile, ligne q_line
2466   1B3A 8A C4 C6            lda     @r_hlines
2467   1B3D 8B C4 1C            sta     @ll_ctr
2468   1B40             bdr_line:
2469   1B40 A2 21 2D            movp    %$21,P45                ; pointeur d'ecriture VRAM (setAcmpxy
2470   1B43 12 1E               mov     BG_PTR,A                 ; en ligne : poids faible puis fort)
2471   1B45 82 2D               movp    A,P45
2472   1B47 12 1D               mov     BG_PTR-1,A
2473   1B49 82 2D               movp    A,P45
2474   1B4B 9A 0E               lda     *TEMP1                  ; plan Bleu
2475   1B4D 82 2E               movp    A,P46
2476   1B4F D3 0E               inc     TEMP1
2477   1B51 79 00 0D            adc     %0,TEMP1-1
2478   1B54 9A 0E               lda     *TEMP1                  ; plan Vert
2479   1B56 82 2E               movp    A,P46
2480   1B58 D3 0E               inc     TEMP1
2481   1B5A 79 00 0D            adc     %0,TEMP1-1
2482   1B5D 9A 0E               lda     *TEMP1                  ; plan Rouge
2483   1B5F 82 2E               movp    A,P46
2484   1B61 D3 0E               inc     TEMP1                   ; -> meme tuile, ligne suivante
2485   1B63 79 00 0D            adc     %0,TEMP1-1
2486   1B66 78 7A 1E            add     %MAPPLEN&$FF,BG_PTR      ; VRAM : ligne ecran suivante
2487   1B69 79 00 1D            adc     %MAPPLEN>>8,BG_PTR-1
2488   1B6C 8A C4 1C            lda     @ll_ctr
2489   1B6F B2                  dec     A
2490   1B70 8B C4 1C            sta     @ll_ctr
2491   1B73 E2 1F               jeq     @bdr_coldone
2492   1B75 8A C4 C8            lda     @q_line
