1442+  6E85             ; The following functions are useful to change attribute of some cells inside the current window
1443+  6E85             ; without to reprint characters (helpful for user interface).
1444+  6E85             	
1445+  6E85~            #IFDEF Ffill_color
1446+  6E85~            #DEFINE Fset_acmpacmpxy
1447+  6E85~            #DEFINE Fcalcul_pointer
1448+  6E85~            #DEFINE Ftest_draw
1449+  6E85~            ; fill a rectangular area of the active window with a drawing color
1450+  6E85~            ; The cursor position is not modified.
1451+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
1452+  6E85~            ;			TEMP4 = foreground color (0 to 7)
1453+  6E85~            ; USED Registers :TEMP2-1,TEMP3-1,TEMP3,TEMP4
1454+  6E85~            ; USED Mem :XSX,YSY
1455+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmacmpxy,test_draw
1456+  6E85~            	.module fcolor
1457+  6E85~            fill_color
1458+  6E85~            	push A
1459+  6E85~            	push B
1460+  6E85~            	and %$7,TEMP4
1461+  6E85~            	rr TEMP4
1462+  6E85~            	rr TEMP4
1463+  6E85~            	rr TEMP4
1464+  6E85~            	call @test_draw
1465+  6E85~            	jc _fin
1466+  6E85~            	movd TEMP1,R1
1467+  6E85~            	call @calcul_pointer
1468+  6E85~            _rept1
1469+  6E85~            	movd TEMP3,R1
1470+  6E85~            	call @set_acmpacmpxy
1471+  6E85~            	mov TEMP2,B
1472+  6E85~            _rept2
1473+  6E85~            	lvdp
1474+  6E85~            	and %$1F,A
1475+  6E85~            	or TEMP4,A
1476+  6E85~            	wvdp(A)
1477+  6E85~            	lvdp
1478+  6E85~            	wvdp(A)
1479+  6E85~            	djnz B,_rept2
1480+  6E85~            	add %LENGTHLINE,TEMP3
1481+  6E85~            	adc %0,TEMP3-1
1482+  6E85~            	djnz TEMP2-1,_rept1
1483+  6E85~            _fin
1484+  6E85~            	pop B
1485+  6E85~            	pop A
1486+  6E85~            	rets
1487+  6E85             #ENDIF
1488+  6E85             
1489+  6E85~            #IFDEF Ffill_bgcolor
