3247   2170             ; --- cette case a-t-elle ete creusee ? Sortie : A != 0 si oui --------------
3248   2170             dig_test:
3249   2170 8E 1F 77            call    @dig_locate
3250   2173 9A 12               lda     *TEMP3
3251   2175 D0 18               mov     A,TEMP6
3252   2177 8A C4 CE            lda     @dig_mask
3253   217A 13 18               and     TEMP6,A
3254   217C 0A                  rets
3255   217D             
3256   217D             ; --- marque la case comme creusee -----------------------------------------
3257   217D             dig_set:
3258   217D B5                  clr     A                       ; le terrain change : le cache de
3259   217E 8B C7 CF            sta     @rtc_valid              ; rect_tileptr devient faux
3260   2181             
3261   2181                     ; --- une tuile POSEE, si elle existe pour cette case, doit AUSSI
3262   2181                     ; etre "detruite" ici. ERREUR DE CONCEPTION EVITEE : built_test
3263   2181                     ; passe toujours avant dig_test dans tile_flags_at/pix_solid --
3264   2181                     ; poser simplement le bit de creusement n'aurait donc RIEN change
3265   2181                     ; pour une case construite : elle serait restee visuellement et
3266   2181                     ; physiquement intacte, meme apres une explosion sur une marche
3267   2181                     ; d'escalier destructible. On bascule donc directement son entree
3268   2181                     ; construite vers la tuile "vide" (index 0) : les lectures futures
3269   2181                     ; la trouveront toujours via built_test (l'entree reste dans la
3270   2181                     ; liste), mais liront desormais des donnees vides -- exactement
3271   2181                     ; comme si elle avait ete creusee. built_test ne modifie jamais
3272   2181                     ; d_col (verifie), aucune sauvegarde necessaire.
3273   2181 8E 20 96            call    @built_test
3274   2184 E2 09               jeq     @ds_notbuilt
3275   2186 8A C7 DF            lda     @bt_found
3276   2189 C0                  mov     A,B
3277   218A B5                  clr     A
3278   218B AB C7 6D            sta     @build_tile(B)
3279   218E 0A                  rets                            ; case construite : c'est fait, pas
3280   218F                                                     ; besoin de toucher le bitmap creuse
3281   218F             ds_notbuilt:
3282   218F 8E 1F 77            call    @dig_locate
3283   2192 9A 12               lda     *TEMP3
3284   2194 D0 18               mov     A,TEMP6
3285   2196 8A C4 CE            lda     @dig_mask
3286   2199 14 18               or      TEMP6,A
3287   219B 9B 12               sta     *TEMP3
3288   219D 0A                  rets
3289   219E             
3290   219E             ; --- efface toute la couche au demarrage -----------------------------------
3291   219E             dig_clear_all:
3292   219E 22 C5               mov     %dig_map>>8,A
3293   21A0 D0 0D               mov     A,TEMP1-1
3294   21A2 22 80               mov     %dig_map&$FF,A
3295   21A4 D0 0E               mov     A,TEMP1
3296   21A6 72 03 16            mov     %3,TEMP5                ; les 3 ecrans possibles (place en
3297   21A9             dca_scr:                                ; SRAM : 3 x DIG_BYTES_SCR)
3298   21A9 72 64 18            mov     %DIG_BYTES_SCR,TEMP6
3299   21AC             dca_byte:
3300   21AC B5                  clr     A
3301   21AD 9B 0E               sta     *TEMP1
3302   21AF D3 0E               inc     TEMP1
3303   21B1 79 00 0D            adc     %0,TEMP1-1
3304   21B4 DA 18 F5            djnz    TEMP6,@dca_byte
3305   21B7 DA 16 EF            djnz    TEMP5,@dca_scr
3306   21BA 0A                  rets
3307   21BB             
3308   21BB             ; ============================================================================
3309   21BB             ; tile_flags_at -- proprietes de la tuile situee en (r_xseg, r_yline) sur
3310   21BB             ; l'ecran map_screen. Sortie : A = octet de lv_flags.
3311   21BB             ; Une case marquee comme creusee est vue comme VIDE, quelle que soit la
3312   21BB             ; tuile d'origine dans la carte ROM.
3313   21BB             ; ============================================================================
3314   21BB             tile_flags_at:
3315   21BB 8E 18 11            call    @rect_rowline           ; r_yline -> q_row, q_line
3316   21BE 8A C4 C3            lda     @r_xseg
3317   21C1 8B C4 CB            sta     @d_col
3318   21C4 8E 20 96            call    @built_test             ; une tuile POSEE prime sur tout :
3319   21C7 E2 0C               jeq     @tfa_nobuild            ; on construit apres avoir creuse
3320   21C9 8A C7 DF            lda     @bt_found               ; QUELLE tuile : plus toujours
3321   21CC C0                  mov     A,B                     ; BUILD_TILE (marches d'escalier)
3322   21CD AA C7 6D            lda     @build_tile(B)
3323   21D0 C0                  mov     A,B
3324   21D1 8E 21 E7            call    @tile_flags_B
3325   21D4 0A                  rets
3326   21D5             tfa_nobuild:
3327   21D5 8E 21 70            call    @dig_test
3328   21D8 E2 02               jeq     @tfa_map
3329   21DA B5                  clr     A                       ; creusee : ni solide ni destructible
3330   21DB 0A                  rets
3331   21DC             tfa_map:
3332   21DC B5                  clr     A
3333   21DD 8E 1A 48            call    @rect_mapptr            ; TEMP2 = case (q_row, r_xseg)
3334   21E0 9A 10               lda     *TEMP2
3335   21E2 C0                  mov     A,B
3336   21E3 8E 21 E7            call    @tile_flags_B
3337   21E6 0A                  rets
3338   21E7             
3339   21E7             ; --- B = indice de tuile -> A = ses proprietes, dans le THEME du niveau.
3340   21E7             ; La table n'est plus a une adresse fixe (un theme par groupe de niveaux) :
3341   21E7             ; lecture indirecte par TEMP2, que tile_flags_at n'utilisait deja plus
3342   21E7             ; apres la lecture de la carte (aucun appelant ne le relit, verifie).
3343   21E7             tile_flags_B:
3344   21E7 8A C7 AE            lda     @flags_hi
3345   21EA D0 0F               mov     A,TEMP2-1
3346   21EC 8A C7 AD            lda     @flags_lo
3347   21EF 68                  add     B,A
3348   21F0 E7 02               jnc     @tfb_nc                 ; retenue lue AVANT tout LDA/MOV
3349   21F2 D3 0F               inc     TEMP2-1
3350   21F4             tfb_nc:
3351   21F4 D0 10               mov     A,TEMP2
3352   21F6 9A 10               lda     *TEMP2
3353   21F8 0A                  rets
3354   21F9             
3355   21F9             ; ============================================================================
3356   21F9             ; surface_find -- ou se poserait le lemming cur_lem s'il avancait dans le
3357   21F9             ; segment r_xseg ?
3358   21F9             ; Sortie : A = 0  mur infranchissable (demi-tour)
3359   21F9             ;          A = 1  praticable, sf_y contient la nouvelle valeur de lem_y
3360   21F9             ;          A = 2  aucun sol a portee : il tombe
3361   21F9             ;
3362   21F9             ; On part de la ligne juste sous ses pieds :
3363   21F9             ;   - si elle est solide, on REMONTE tant qu'elle l'est (pente montante ou
3364   21F9             ;     marche), dans la limite de MAX_STEP_UP ;
3365   21F9             ;   - sinon on DESCEND tant qu'elle est vide (pente descendante ou creux),
3366   21F9             ;     dans la limite de MAX_STEP_DOWN.
3367   21F9             ; Les pieds se posent juste au-dessus du premier pixel solide trouve.
3368   21F9             ; ============================================================================
3369   21F9             surface_find:
3370   21F9 8A C4 C1            lda     @cur_lem
3371   21FC C0                  mov     A,B
3372   21FD AA C5 3E            lda     @lem_screen(B)
3373   2200 8B C4 CA            sta     @map_screen
3374   2203 8A C4 C1            lda     @cur_lem
3375   2206 C0                  mov     A,B
3376   2207 AA C5 2A            lda     @lem_y(B)
3377   220A 28 0A               add     %LEM_HLINES,A           ; premiere ligne sous ses pieds
3378   220C 8B C7 B5            sta     @sf_base
3379   220F 8B C7 B6            sta     @sf_s
3380   2212 8B C4 C5            sta     @r_yline
3381   2215 8E 23 69            call    @pix_solid
3382   2218 E2 08               jeq     @sf_base_empty          ; rien a la base : chercher plus haut
3383   221A                     ; --- solide directement a la base : MEME controle de sens que dans
3384   221A                     ; la boucle de recherche plus bas. ERREUR DE CONCEPTION CORRIGEE :
3385   221A                     ; ce test-ci, le tout premier de surface_find, sautait directement
3386   221A                     ; a sf_up SANS jamais passer par stair_dir_ok -- un lemming qui
3387   221A                     ; REDESCEND un escalier a contresens a, a chaque pas, sa hauteur
3388   221A                     ; ACTUELLE qui correspond DEJA a la marche suivante : elle est
3389   221A                     ; trouvee ICI, pas dans la boucle de recherche vers le haut, et
3390   221A                     ; traversait donc l'escalier sans jamais etre bloque.
3391   221A 8E 21 35            call    @stair_dir_ok
3392   221D E2 45               jeq     @sf_wrongdir
3393   221F 8C 22 B8            br      @sf_up                  ; deja du sol : chercher son sommet
3394   2222             sf_base_empty:
3395   2222             
3396   2222                     ; --- rien au niveau de base : une marche PLUS HAUTE existe peut-
3397   2222                     ; etre juste au-dessus (une brique de montee, sans rien en dessous
3398   2222                     ; d'elle a cette colonne precise -- exactement le cas d'une marche
3399   2222                     ; d'escalier qui n'est pas adossee au sol naturel).
3400   2222                     ; ERREUR DE CONCEPTION CORRIGEE : une premiere version, ne trouvant
3401   2222                     ; rien a la base, concluait DIRECTEMENT a une chute sans jamais
3402   2222                     ; regarder vers le haut. La premiere marche d'un escalier passait
3403   2222                     ; par chance (le sol naturel existe encore en dessous d'elle), mais
3404   2222                     ; la deuxieme -- une plateforme isolee, sans rien en dessous a sa
3405   2222                     ; propre colonne -- n'etait jamais retrouvee.
3406   2222 22 0A               mov     %MAX_STEP_UP,A
3407   2224 8B C7 B8            sta     @sf_ctr
3408   2227             sf_probe_up:
3409   2227 8A C7 B6            lda     @sf_s
3410   222A E6 03               jne     @sf_probe_up_in
3411   222C 8C 22 6F            br      @sf_go_down             ; haut de l'ecran : rien trouve
3412   222F             sf_probe_up_in:
3413   222F B2                  dec     A
3414   2230 8B C7 B6            sta     @sf_s
3415   2233 8B C4 C5            sta     @r_yline
3416   2236 8E 23 69            call    @pix_solid
3417   2239 E2 2B               jeq     @sf_pu_next             ; rien ici : continue normalement
3418   223B                     ; --- solide trouve : est-ce une marche construite dans le SENS
3419   223B                     ; OPPOSE a celui dans lequel ce lemming marche ? Si oui, ce n'est
3420   223B                     ; PAS une marche franchissable pour lui -- c'est un mur, et un vrai
3421   223B                     ; mur (pas une chute) : il ne doit pas continuer a chercher plus
3422   223B                     ; haut, ni redescendre chercher un autre chemin, sinon il se met a
3423   223B                     ; grimper ou tomber sur une brique censee le bloquer net.
3424   223B 8E 21 35            call    @stair_dir_ok
3425   223E E2 24               jeq     @sf_wrongdir
3426   2240 8A C7 B6            lda     @sf_s                   ; bon sens (ou tuile ordinaire) :
3427   2243 8B C5 11            sta     @sf_ovh                 ; grimper jusqu'a son sommet, comme
3428   2246 8E 22 B8            call    @sf_up                  ; avant (meme boucle, budget neuf --
3429   2249 E2 01               jeq     @sf_under               ; une brique ne fait jamais plus
3430   224B 0A                  rets                            ; d'une tuile de haut). A=1 : marche
3431   224C             sf_under:
3432   224C                     ; --- trop haut pour etre gravi : ce n'est pas une marche mais le
3433   224C                     ; DESSOUS d'un surplomb (bas d'une colonne qui s'arrete au-dessus du
3434   224C                     ; sol, plafond d'un tunnel...). Il passe DESSOUS si le sol, plus bas,
3435   224C                     ; laisse sa tete sous ce surplomb. ERREUR CORRIGEE : sans ce test, un
3436   224C                     ; lemming monte d'1 px sur une tuile au sol plus haut que ses
3437   224C                     ; voisines voyait, des deux cotes, le bas des colonnes voisines a
3438   224C                     ; hauteur de sa tete : demi-tour a chaque pas, prisonnier sur place.
3439   224C 8E 22 6F            call    @sf_go_down
3440   224F 2D 01               cmp     %1,A
3441   2251 E2 02               jeq     @sf_under_chk
3442   2253 B5                  clr     A                       ; rien a portee dessous : mur (sa
3443   2254 0A                  rets                            ; tete resterait dans le surplomb)
3444   2255             sf_under_chk:
3445   2255 8A C7 B7            lda     @sf_y                   ; nouveau haut de sa tete, plus bas
3446   2258 8D C5 11            cmpa    @sf_ovh                 ; que le bas du surplomb ?
3447   225B E2 02               jeq     @sf_under_no
3448   225D E3 02               jc      @sf_under_ok            ; jc : sf_y > sf_ovh
3449   225F             sf_under_no:
3450   225F B5                  clr     A
3451   2260 0A                  rets
3452   2261             sf_under_ok:
3453   2261 22 01               mov     %1,A
3454   2263 0A                  rets
3455   2264             sf_wrongdir:
3456   2264 B5                  clr     A
3457   2265 0A                  rets                            ; mur : mauvais sens de construction
3458   2266             sf_pu_next:
3459   2266 8A C7 B8            lda     @sf_ctr
3460   2269 B2                  dec     A
3461   226A 8B C7 B8            sta     @sf_ctr
3462   226D E6 B8               jne     @sf_probe_up
3463   226F                     ; tombe ici : rien trouve dans la plage de recherche vers le haut
3464   226F             
3465   226F             sf_go_down:
3466   226F                     ; --- rien a la base ni au-dessus : on descend --------------------
3467   226F                     ; NOTE : les deux sorties "chute" posent sf_y = lem_y actuel
3468   226F                     ; (inchange) -- lw_p_move l'utilise pour avancer a niveau constant,
3469   226F                     ; laissant lem_supported declencher la chute au prochain pas.
3470   226F 8A C7 B5            lda     @sf_base
3471   2272 8B C7 B6            sta     @sf_s
3472   2275 22 06               mov     %MAX_STEP_DOWN,A
3473   2277 8B C7 B8            sta     @sf_ctr
3474   227A             sf_down:
3475   227A 8A C7 B6            lda     @sf_s
3476   227D B3                  inc     A
3477   227E 2D C8               cmp     %GRAPH_LINES,A
3478   2280 E7 0D               jnc     @sf_down_in
3479   2282 8A C4 C1            lda     @cur_lem
3480   2285 C0                  mov     A,B
3481   2286 AA C5 2A            lda     @lem_y(B)
3482   2289 8B C7 B7            sta     @sf_y
3483   228C 22 02               mov     %2,A
3484   228E 0A                  rets                            ; bas de l'ecran : il tombe
3485   228F             sf_down_in:
3486   228F 8B C7 B6            sta     @sf_s
3487   2292 8B C4 C5            sta     @r_yline
3488   2295 8E 23 69            call    @pix_solid
3489   2298 E2 08               jeq     @sf_down_next           ; rien ici : continue de descendre
3490   229A                     ; --- meme controle de sens qu'a la base et en montant : un
3491   229A                     ; lemming qui REDESCEND un escalier a contresens rencontre ses
3492   229A                     ; marches ICI aussi (une petite marche en dessous de lui, pas
3493   229A                     ; directement a sa hauteur) -- sans ce controle, il continuait de
3494   229A                     ; descendre a travers l'escalier entier sans jamais etre bloque.
3495   229A 8E 21 35            call    @stair_dir_ok
3496   229D E2 C5               jeq     @sf_wrongdir
3497   229F 8C 22 DE            br      @sf_hit
3498   22A2             sf_down_next:
3499   22A2 8A C7 B8            lda     @sf_ctr
3500   22A5 B2                  dec     A
3501   22A6 8B C7 B8            sta     @sf_ctr
3502   22A9 E6 CF               jne     @sf_down
3503   22AB 8A C4 C1            lda     @cur_lem
3504   22AE C0                  mov     A,B
3505   22AF AA C5 2A            lda     @lem_y(B)
3506   22B2 8B C7 B7            sta     @sf_y
3507   22B5 22 02               mov     %2,A
3508   22B7 0A                  rets                            ; rien a portee : il tombe
3509   22B8             
3510   22B8                     ; --- du sol sous ses pieds (ou trouve en remontant) : on continue
3511   22B8                     ; de remonter tant qu'il y en a --------------------------------
3512   22B8             sf_up:
3513   22B8 22 0B               mov     %MAX_STEP_UP_N,A
3514   22BA 8B C7 B8            sta     @sf_ctr
3515   22BD             sf_up_loop:
3516   22BD 8A C7 B6            lda     @sf_s
3517   22C0 E6 02               jne     @sf_up_in
3518   22C2 B5                  clr     A
3519   22C3 0A                  rets                            ; haut de l'ecran : mur
3520   22C4             sf_up_in:
3521   22C4 B2                  dec     A
3522   22C5 8B C4 C5            sta     @r_yline
3523   22C8 8E 23 69            call    @pix_solid
3524   22CB E2 11               jeq     @sf_hit                 ; vide : le sommet est juste dessous
3525   22CD 8A C4 C5            lda     @r_yline                ; encore solide : on continue
3526   22D0 8B C7 B6            sta     @sf_s
3527   22D3 8A C7 B8            lda     @sf_ctr
3528   22D6 B2                  dec     A
3529   22D7 8B C7 B8            sta     @sf_ctr
3530   22DA E6 E1               jne     @sf_up_loop
3531   22DC B5                  clr     A
3532   22DD 0A                  rets                            ; trop haut : c'est un mur
3533   22DE             
3534   22DE             sf_hit:
