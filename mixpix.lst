6875   3BA6             
6876   3BA6             ; ============================================================================
6877   3BA6             ; tick_isr -- appelee 50 fois par seconde par le moniteur, via BRTIME.
6878   3BA6             ; A et B sont deja sauvegardes par le moniteur ; cette routine n'utilise
6879   3BA6             ; qu'eux, donc rien d'autre a preserver. Elle doit finir par RETS (et non
6880   3BA6             ; RETI) : c'est le moniteur qui termine l'interruption.
6881   3BA6             ; Volontairement minuscule -- tout le travail se fait dans la boucle
6882   3BA6             ; principale, qui consomme les ticks accumules.
6883   3BA6             ; ============================================================================
6884   3BA6             tick_isr:
6885   3BA6 8A C5 18            lda     @tick_cnt
6886   3BA9 B3                  inc     A
6887   3BAA 8B C5 18            sta     @tick_cnt
6888   3BAD 0A                  rets
6889   3BAE             
6890   3BAE             ; ============================================================================
6891   3BAE             ; DONNEES GENEREES PAR LES EDITEURS
6892   3BAE             ;
6893   3BAE             ; Placees ICI, tout a la fin de la zone de donnees : un #include insere le
6894   3BAE             ; contenu a l'endroit exact ou il apparait, et ce sont des .byte -- au
6895   3BAE             ; milieu du code, le processeur tenterait d'executer des pixels.
6896   3BAE             ;
6897   3BAE             ; Ces deux fichiers sont produits par les outils et peuvent etre remplaces
6898   3BAE             ; a volonte sans toucher a ce programme :
6899   3BAE             ;   leveldata.asm  <- EXELTILE  (tuiles 8x10 + proprietes + cartes)
6900   3BAE             ;   lemdata.asm    <- EXELLEM   (sprites de lemmings + animations)
6901   3BAE             ;
6902   3BAE             ; Symboles exportes, prefixes pour eviter toute collision avec ce fichier :
6903   3BAE             ;   LV_NTILES, LV_NSCREENS, LV_MAP_W, LV_MAP_H, LV_TILE_BYTES
6904   3BAE             ;   lv_flags, lv_tiles, lv_map0..2, lv_map_hi, lv_map_lo
6905   3BAE             ;   LEM_NTYPES, LEM_WSEG, LEM_HLINES, LEM_FRAME_BYTES
6906   3BAE             ;   lem_tN_fM, lem_defN, lem_framesN_hi/lo, lem_def_hi/lo
6907   3BAE             ;
6908   3BAE             ; Ces donnees sont REELLEMENT utilisees : draw_all_tiles parcourt la carte
6909   3BAE             ; de l'ecran courant, bg_draw_rect/bg_fill_buf la relisent pour regenerer
6910   3BAE             ; le decor sous les sprites, et lem_draw va chercher les vignettes du
6911   3BAE             ; lemming dans lem_frames0_hi/lo.
6912   3BAE             ; ============================================================================
6913   3BAE             #include "leveldata.asm"
0001+  3BAE             ; ============================================================================
0002+  3BAE             ; Genere par EXELTILE -- ne pas editer a la main.
0003+  3BAE             ;
0004+  3BAE             ; 1 niveau(x), 1 theme(s) (jeux de tuiles). Chaque niveau
0005+  3BAE             ; designe son theme ; l'ordre des niveaux est l'ordre du jeu.
0006+  3BAE             ; Tuiles 8x10, mode bitmap TMS3556 : chaque ligne de tuile occupe
0007+  3BAE             ; 3 octets consecutifs -- plan Bleu, plan Vert, plan Rouge (manuel TMS3556,
0008+  3BAE             ; figure 3.18). bit 7 = pixel de gauche. Une tuile = 30 octets.
0009+  3BAE             ; ============================================================================
0010+  3BAE             
0011+  3BAE             LV_NLEVELS     .equ    1
0012+  3BAE             LV_NTHEMES     .equ    1
0013+  3BAE             LV_MAP_W       .equ    40
0014+  3BAE             LV_MAP_H       .equ    20
0015+  3BAE             LV_TILE_BYTES  .equ    30
0016+  3BAE             
