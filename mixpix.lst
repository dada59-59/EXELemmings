3610   2369             ; ============================================================================
3611   2369             ; pix_solid -- le terrain est-il solide sous le corps du lemming, a la ligne
3612   2369             ; r_yline et dans le segment r_xseg, sur l'ecran map_screen ?
3613   2369             ; Sortie : A != 0 si oui.
3614   2369             ;
3615   2369             ; Lit les PIXELS de la tuile, pas ses proprietes : un pixel est solide si
3616   2369             ; l'un des trois plans a son bit a 1 (couleur differente du noir). Les trois
3617   2369             ; plans sont combines par OU, puis masques par PROBE_MASK.
3618   2369             ; Une tuile creusee est vide, une tuile posee vaut BUILD_TILE -- memes
3619   2369             ; regles de resolution qu'a l'affichage.
3620   2369             ; ============================================================================
3621   2369             pix_solid:
3622   2369 8E 18 11            call    @rect_rowline           ; r_yline -> q_row, q_line
3623   236C 8A C4 C3            lda     @r_xseg
3624   236F 8B C4 CB            sta     @d_col
3625   2372 8E 20 96            call    @built_test
3626   2375 E2 0D               jeq     @ps_nobuild
3627   2377 8A C7 DF            lda     @bt_found               ; QUELLE tuile : plus toujours
3628   237A C0                  mov     A,B                     ; BUILD_TILE (marches d'escalier)
3629   237B AA C7 6D            lda     @build_tile(B)
3630   237E 8B C4 14            sta     @tid
3631   2381 8C 23 94            br      @ps_data
3632   2384             ps_nobuild:
3633   2384 8E 21 70            call    @dig_test
3634   2387 E2 02               jeq     @ps_map
3635   2389 B5                  clr     A
3636   238A 0A                  rets                            ; creusee : entierement vide
3637   238B             ps_map:
3638   238B B5                  clr     A
3639   238C 8E 1A 48            call    @rect_mapptr
3640   238F 9A 10               lda     *TEMP2
3641   2391 8B C4 14            sta     @tid
3642   2394             ps_data:
3643   2394                     ; adresse = lv_tiles + tid*LV_TILE_BYTES + q_line*3
3644   2394 8A C4 14            lda     @tid
3645   2397 2C 1E               mpy     %LV_TILE_BYTES,A
3646   2399 D0 18               mov     A,TEMP6
3647   239B D1 1A               mov     B,TEMP7
3648   239D 8A C7 AC            lda     @tiles_hi
3649   23A0 D0 0D               mov     A,TEMP1-1
3650   23A2 8A C7 AB            lda     @tiles_lo               ; tuiles du theme du niveau
3651   23A5 D0 0E               mov     A,TEMP1
3652   23A7 48 1A 0E            add     TEMP7,TEMP1
3653   23AA 49 18 0D            adc     TEMP6,TEMP1-1
3654   23AD 8A C4 C8            lda     @q_line                 ; + q_line*3
3655   23B0 C0                  mov     A,B
3656   23B1 68                  add     B,A
3657   23B2 68                  add     B,A
3658   23B3 D0 1A               mov     A,TEMP7
3659   23B5 B5                  clr     A
3660   23B6 D0 18               mov     A,TEMP6
3661   23B8 48 1A 0E            add     TEMP7,TEMP1
3662   23BB 49 18 0D            adc     TEMP6,TEMP1-1
3663   23BE             
3664   23BE 9A 0E               lda     *TEMP1                  ; plan Bleu
3665   23C0 D0 1C               mov     A,TEMP8
3666   23C2 D3 0E               inc     TEMP1
3667   23C4 79 00 0D            adc     %0,TEMP1-1
3668   23C7 9A 0E               lda     *TEMP1                  ; plan Vert
3669   23C9 14 1C               or      TEMP8,A
3670   23CB D0 1C               mov     A,TEMP8
3671   23CD D3 0E               inc     TEMP1
3672   23CF 79 00 0D            adc     %0,TEMP1-1
3673   23D2 9A 0E               lda     *TEMP1                  ; plan Rouge
3674   23D4 14 1C               or      TEMP8,A
3675   23D6 23 7E               and     %PROBE_MASK,A           ; sous le corps seulement
3676   23D8 0A                  rets
3677   23D9             
3678   23D9             ; ============================================================================
3679   23D9             ; lem_supported -- le lemming cur_lem a-t-il du sol sous les pieds ?
3680   23D9             ; Sortie : A != 0 si oui.
3681   23D9             ;
3682   23D9             ; On ne teste QU'UN seul segment, celui de sa position (lem_xseg).
3683   23D9             ; Le sprite fait 16 px de large, donc a cheval sur deux segments ; une
3684   23D9             ; premiere version le considerait supporte des que l'UN des deux reposait
3685   23D9             ; sur du solide. ConsÃ©quence : un puits d'une seule tuile de large ne
3686   23D9             ; pouvait jamais l'avaler, il l'enjambait systematiquement.
3687   23D9             ; Avec un seul segment teste, il tombe dans un trou d'une tuile -- au prix
3688   23D9             ; d'un chevauchement visuel : la moitie du sprite se retrouve alors dans la
3689   23D9             ; paroi. C'est le compromis habituel des portages de Lemmings sur grille de
3690   23D9             ; tuiles, ou la chute depend du centre du personnage et non de sa largeur.
3691   23D9             ; ============================================================================
3692   23D9             lem_supported:
3693   23D9 8A C4 C1            lda     @cur_lem
3694   23DC C0                  mov     A,B
3695   23DD AA C5 3E            lda     @lem_screen(B)
3696   23E0 8B C4 CA            sta     @map_screen             ; la carte de SON ecran, pas celle
3697   23E3                                                     ; affichee : il peut marcher hors champ
3698   23E3 8A C4 C1            lda     @cur_lem
3699   23E6 C0                  mov     A,B
3700   23E7 AA C5 2A            lda     @lem_y(B)
3701   23EA 28 0A               add     %LEM_HLINES,A           ; premiere ligne SOUS ses pieds
3702   23EC 2D C8               cmp     %GRAPH_LINES,A
3703   23EE E7 03               jnc     @lsup_inside
3704   23F0 22 01               mov     %1,A                    ; sous le bas de l'ecran : on
3705   23F2 0A                  rets                            ; considere qu'il y a un sol
3706   23F3             lsup_inside:
3707   23F3 8B C4 C5            sta     @r_yline
3708   23F6 8A C4 C1            lda     @cur_lem
3709   23F9 C0                  mov     A,B
3710   23FA AA C5 20            lda     @lem_xseg(B)
3711   23FD 8B C4 C3            sta     @r_xseg
3712   2400 8E 23 69            call    @pix_solid              ; au PIXEL, plus par tuile : il peut
3713   2403 0A                  rets                            ; donc s'enfoncer dans les pixels
3714   2404                                                     ; noirs du haut d'une tuile
3715   2404             
3716   2404             ; --- un pas de marche pour le lemming cur_lem.
3717   2404             ; ORDRE VOULU : on dessine le sprite a sa NOUVELLE position d'abord, puis on
3718   2404             ; efface seulement la colonne laissee derriere. Le sprite n'est donc jamais
3719   2404             ; absent de l'ecran, meme un instant -- c'est ce qui supprime le
3720   2404             ; clignotement ("produire la ligne finale avant l'ecriture VRAM").
3721   2404             lem_step:
3722   2404 8A C4 C1            lda     @cur_lem
3723   2407 C0                  mov     A,B
3724   2408 AA C5 52            lda     @lem_alive(B)
3725   240B E6 01               jne     @lst_go
3726   240D 0A                  rets                            ; pas encore apparu
3727   240E             lst_go:
3728   240E                     ; --- memorise la position de depart (les deux axes : la chute
3729   240E                     ; deplace en Y, la marche en X) --------------------------------------
3730   240E 8A C4 C1            lda     @cur_lem
3731   2411 C0                  mov     A,B
3732   2412 AA C5 20            lda     @lem_xseg(B)
3733   2415 AB C5 48            sta     @lem_old_xseg(B)
3734   2418 8A C4 C1            lda     @cur_lem
3735   241B C0                  mov     A,B
3736   241C AA C5 2A            lda     @lem_y(B)
3737   241F AB C5 66            sta     @lem_old_y(B)
3738   2422             
3739   2422                     ; --- mort : on laisse jouer l'animation, puis le corps disparait --
3740   2422 8A C4 C1            lda     @cur_lem
3741   2425 C0                  mov     A,B
3742   2426 AA C5 5C            lda     @lem_state(B)
3743   2429 2D 04               cmp     %ST_DEAD,A
3744   242B E2 04               jeq     @lst_isdead
3745   242D 2D 07               cmp     %ST_BOOM,A              ; meme traitement : animer, puis
3746   242F E6 03               jne     @lst_notdead            ; effacer le corps
3747   2431             lst_isdead:
3748   2431 8C 24 F3            br      @lst_dead
3749   2434             lst_notdead:
3750   2434                     ; --- sortie atteinte ? Verifiee ICI, avant TOUTE autre activite --
3751   2434                     ; un lemming qui creuse, construit ou porte un compte a rebours
3752   2434                     ; doit etre sauve tout autant qu'un simple marcheur s'il finit par
3753   2434                     ; se trouver sur cette tuile. pix_solid laisse toujours l'index
3754   2434                     ; de la tuile resolue dans tid, qu'elle vienne du terrain naturel
3755   2434                     ; ou d'une case construite -- son propre resultat de solidite (A)
3756   2434                     ; ne nous interesse pas ici, seul tid compte.
3757   2434 8A C4 C1            lda     @cur_lem
3758   2437 C0                  mov     A,B
3759   2438 AA C5 3E            lda     @lem_screen(B)
3760   243B 8B C4 CA            sta     @map_screen
3761   243E 8A C4 C1            lda     @cur_lem
3762   2441 C0                  mov     A,B
3763   2442 AA C5 2A            lda     @lem_y(B)
3764   2445 28 0A               add     %LEM_HLINES,A
3765   2447 8B C4 C5            sta     @r_yline
3766   244A 8A C4 C1            lda     @cur_lem
3767   244D C0                  mov     A,B
3768   244E AA C5 20            lda     @lem_xseg(B)
3769   2451 8B C4 C3            sta     @r_xseg
3770   2454 8E 23 69            call    @pix_solid
3771   2457 8A C4 14            lda     @tid
3772   245A 2D 08               cmp     %TILE_SORTIE,A
3773   245C E2 03               jeq     @lst_saved
3774   245E 8C 24 95            br      @lst_nosortie
3775   2461             lst_saved:
3776   2461                     ; --- efface le sprite PENDANT que lem_alive vaut encore 1 :
3777   2461                     ; bg_erase_if_visible verifie cet indicateur avant de dessiner --
3778   2461                     ; exactement le meme ordre que la disparition du corps apres une
3779   2461                     ; mort (lsdd_gone).
3780   2461 8A C4 C1            lda     @cur_lem
3781   2464 C0                  mov     A,B
3782   2465 AA C5 20            lda     @lem_xseg(B)
3783   2468 8B C4 C3            sta     @r_xseg
3784   246B 22 01               mov     %LEM_WSEG,A
3785   246D 8B C4 C4            sta     @r_wseg
3786   2470 8A C4 C1            lda     @cur_lem
3787   2473 C0                  mov     A,B
3788   2474 AA C5 2A            lda     @lem_y(B)
3789   2477 8B C4 C5            sta     @r_yline
3790   247A 22 0A               mov     %LEM_HLINES,A
3791   247C 8B C4 C6            sta     @r_hlines
3792   247F 8E 1F 5E            call    @bg_erase_if_visible
3793   2482 8A C7 E2            lda     @saved_count
3794   2485 B3                  inc     A
3795   2486 8B C7 E2            sta     @saved_count
3796   2489 8E 36 6E            call    @draw_saved_count       ; met a jour l'affichage tout de suite
3797   248C 8A C4 C1            lda     @cur_lem
3798   248F C0                  mov     A,B
3799   2490 B5                  clr     A
3800   2491 AB C5 52            sta     @lem_alive(B)
3801   2494 0A                  rets
3802   2495             lst_nosortie:
3803   2495             
3804   2495                     ; --- compte a rebours du kamikaze. Le lemming continue son activite
3805   2495                     ; normalement pendant ce temps : marcher, creuser, tomber.
3806   2495 8A C4 C1            lda     @cur_lem
3807   2498 C0                  mov     A,B
3808   2499 AA C6 F8            lda     @lem_bomb(B)
3809   249C E2 13               jeq     @lst_nobomb
3810   249E B2                  dec     A
3811   249F 8B C4 0D            sta     @tmp_c
3812   24A2 8A C4 C1            lda     @cur_lem
3813   24A5 C0                  mov     A,B
3814   24A6 8A C4 0D            lda     @tmp_c
3815   24A9 AB C6 F8            sta     @lem_bomb(B)
3816   24AC E6 03               jne     @lst_nobomb
3817   24AE 8C 31 36            br      @lem_explode            ; zero : il explose maintenant
3818   24B1             lst_nobomb:
3819   24B1             
3820   24B1                     ; --- creuseur : il descend en supprimant la tuile sous ses pieds ---
3821   24B1 8A C4 C1            lda     @cur_lem
3822   24B4 C0                  mov     A,B
3823   24B5 AA C5 5C            lda     @lem_state(B)
3824   24B8 2D 02               cmp     %ST_DIG,A
3825   24BA E6 03               jne     @lst_notdig
3826   24BC 8C 29 5B            br      @lst_dig
3827   24BF             lst_notdig:
3828   24BF 2D 0A               cmp     %ST_CLIMB,A             ; accroche a une paroi : AVANT le test
3829   24C1 E6 03               jne     @lst_notclimb           ; de sol, qui le ferait tomber (il n'a
3830   24C3 8C 2E 76            br      @lst_climb              ; rien sous les pieds)
3831   24C6             lst_notclimb:
3832   24C6             
3833   24C6                     ; --- plus de sol sous les pieds : il tombe --------------------------
3834   24C6 8E 23 D9            call    @lem_supported
3835   24C9 E2 03               jeq     @lst_nofloor            ; jne @lst_grounded etait hors de
3836   24CB 8C 2A AF            br      @lst_grounded           ; portee depuis l'ajout du bloc de
3837   24CE             lst_nofloor:                            ; creusement : test inverse + br
3838   24CE                     ; ATTENTION : ce code est traverse a CHAQUE pas tant que le lemming
3839   24CE                     ; n'a pas de sol, pas seulement au debut de la chute. Il ne faut
3840   24CE                     ; donc reinitialiser que si l'etat CHANGE reellement -- sinon la
3841   24CE                     ; distance parcourue repart de zero a chaque pas, ne depasse jamais
3842   24CE                     ; le seuil, et le lemming ne meurt jamais, quelle que soit la
3843   24CE                     ; hauteur. L'animation redemarrait au passage, elle aussi.
3844   24CE 8A C4 C1            lda     @cur_lem
3845   24D1 C0                  mov     A,B
3846   24D2 AA C5 5C            lda     @lem_state(B)
3847   24D5 2D 01               cmp     %ST_FALL,A
3848   24D7 E6 03               jne     @lst_chkfloat
3849   24D9 8C 2A 06            br      @lst_fall               ; deja en chute libre : on poursuit
3850   24DC             lst_chkfloat:
3851   24DC 2D 05               cmp     %ST_FLOAT,A
3852   24DE E6 03               jne     @lst_newfall
3853   24E0 8C 2A 06            br      @lst_fall               ; deja en parachute : on poursuit
3854   24E3             lst_newfall:
3855   24E3                     ; Toute chute commence en chute LIBRE, parachutiste compris : son
3856   24E3                     ; parachute s'ouvre dans lst_fall, seulement si la chute depasse
3857   24E3                     ; FLOAT_OPEN lignes. Avant, il s'ouvrait des la premiere ligne, y
3858   24E3                     ; compris pour chaque marche de 10 px d'un tunnel de mineur.
3859   24E3             lst_freefall:
3860   24E3 22 01               mov     %ST_FALL,A
3861   24E5             lst_setfall:
3862   24E5 8E 33 3A            call    @lem_set_state          ; remet aussi l'animation au debut
3863   24E8 8A C4 C1            lda     @cur_lem                ; nouvelle chute : distance a zero
3864   24EB C0                  mov     A,B
3865   24EC B5                  clr     A
3866   24ED AB C6 AC            sta     @lem_fall(B)
3867   24F0                     ; BRANCHEMENT EXPLICITE, indispensable : ce code comptait autrefois
3868   24F0                     ; sur un simple enchainement vers lst_fall, qui le suivait
3869   24F0                     ; immediatement. Les blocs lst_dead et lst_dig ont depuis ete
3870   24F0                     ; inseres entre les deux -- le lemming passait en etat de chute puis
3871   24F0                     ; executait le code de la MORT, qui ne fait qu'animer et dessiner.
3872   24F0 8C 2A 06            br      @lst_fall
3873   24F3             lst_dead:
3874   24F3                     ; Le corps reste visible le temps de l'animation, puis disparait.
3875   24F3                     ; lem_fall sert ici de compte a rebours (il n'a plus a mesurer de
3876   24F3                     ; distance, le lemming ne tombera plus).
3877   24F3 8E 32 ED            call    @lem_anim_next
3878   24F6 8E 1D 72            call    @lem_draw
