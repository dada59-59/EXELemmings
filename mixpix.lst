6015   3327             ; ses competences permanentes choisissent la variante du marcheur : sac de
6016   3327             ; parachute dans le dos, crochet de grimpeur, ou les deux (athlete). Ce sont
6017   3327             ; les types 12 a 14 d'EXELLEM. Rend A = type ; utilise B.
6018   3327             lem_sprite_type:
6019   3327 8A C4 C1            lda     @cur_lem
