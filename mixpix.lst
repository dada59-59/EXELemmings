1719+  6E85~            ; fill a rectangular area of the active window with a pattern (attribute drawing,character)
1720+  6E85~            ; The cursor position is not modified.
1721+  6E85~            ; Compatible with alphanumeric and R0lphamosaic generator.
1722+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
1723+  6E85~            ;			TEMP4-1 = attribute, TEMP4 = character (0 to 127)
1724+  6E85~            ; USED Registers :TEMP2-1,TEMP3-1,TEMP3
1725+  6E85~            ; USED Mem :XSX,YSY
1726+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmacmpxy,test_draw
1727+  6E85~            	.module fpattern
1728+  6E85~            fill_pattern
1729+  6E85~            	push A
1730+  6E85~            	push B
1731+  6E85~            	call @test_draw
1732+  6E85~            	jc _fin
1733+  6E85~            	movd TEMP1,R1
1734+  6E85~            	call @calcul_pointer
1735+  6E85~            _rept1
1736+  6E85~            	movd TEMP3,R1
1737+  6E85~            	call @set_acmpxy
1738+  6E85~            	mov TEMP2,B
1739+  6E85~            _rept2
1740+  6E85~            	mov TEMP4-1,A
1741+  6E85~            	wvdp(A)
1742+  6E85~            	mov TEMP4,A
1743+  6E85~            	wvdp(A)
1744+  6E85~            	djnz B,_rept2
1745+  6E85~            	add %LENGTHLINE,TEMP3
1746+  6E85~            	adc %0,TEMP3-1
1747+  6E85~            	djnz TEMP2-1,_rept1
1748+  6E85~            _fin
1749+  6E85~            	pop B
1750+  6E85~            	pop A
1751+  6E85~            	rets
1752+  6E85             #ENDIF
1753+  6E85             
1754+  6E85             ; The following functions are useful to replace attribute of some cells inside the current window
1755+  6E85             ; without to reprint characters (helpful for user interface).
1756+  6E85             	
1757+  6E85~            #IFDEF Freplace_color
1758+  6E85~            #DEFINE Fset_acmpacmpxy
1759+  6E85~            #DEFINE Fcalcul_pointer
1760+  6E85~            #DEFINE Ftest_draw
1761+  6E85~            ; replace in a rectangular area of the active window a drawing color by another one
1762+  6E85~            ; The cursor position is not modified.
1763+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
1764+  6E85~            ;			TEMP4-1 = old foreground color (0 to 7), TEMP4 = new foreground color (0 to 7)
1765+  6E85~            ; USED Registers :TEMP2-1,TEMP3-1,TEMP3,TEMP4-1,TEMP4
1766+  6E85~            ; USED Mem :XSX,YSY
1767+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmacmpxy,test_draw
1768+  6E85~            	.module rcolor
1769+  6E85~            replace_color
1770+  6E85~            	push A
1771+  6E85~            	push B
1772+  6E85~            	and %$7,TEMP4
1773+  6E85~            	rr TEMP4
1774+  6E85~            	rr TEMP4
1775+  6E85~            	rr TEMP4
1776+  6E85~            	and %$7,TEMP4-1
1777+  6E85~            	rr TEMP4-1
1778+  6E85~            	rr TEMP4-1
1779+  6E85~            	rr TEMP4-1
1780+  6E85~            	call @test_draw
1781+  6E85~            	jc _fin
1782+  6E85~            	movd TEMP1,R1
1783+  6E85~            	call @calcul_pointer
1784+  6E85~            _rept1
1785+  6E85~            	movd TEMP3,R1
1786+  6E85~            	call @set_acmpacmpxy
1787+  6E85~            	mov TEMP2,B
1788+  6E85~            _rept2
1789+  6E85~            	lvdp
1790+  6E85~            	push A
1791+  6E85~            	and %$E0,A
1792+  6E85~            	cmp TEMP4-1,A
1793+  6E85~            	jeq _replace
1794+  6E85~            	pop A
1795+  6E85~            	jmp _noreplace
1796+  6E85~            _replace
1797+  6E85~            	pop A	
1798+  6E85~            	and %$1F,A
1799+  6E85~            	or TEMP4,A
1800+  6E85~            _noreplace	
1801+  6E85~            	wvdp(A)
1802+  6E85~            	lvdp
1803+  6E85~            	wvdp(A)
1804+  6E85~            	djnz B,_rept2
1805+  6E85~            	add %LENGTHLINE,TEMP3
1806+  6E85~            	adc %0,TEMP3-1
1807+  6E85~            	djnz TEMP2-1,_rept1
1808+  6E85~            _fin
1809+  6E85~            	pop B
1810+  6E85~            	pop A
1811+  6E85~            	rets
1812+  6E85             #ENDIF
1813+  6E85             
1814+  6E85~            #IFDEF Freplace_bgcolor
1815+  6E85~            #DEFINE Fset_acmpacmpxy
1816+  6E85~            #DEFINE Fcalcul_pointer
1817+  6E85~            #DEFINE Ftest_draw
1818+  6E85~            ; replace in rectangular area of the active window with a background color with another one
1819+  6E85~            ; The cursor position is not modified.
1820+  6E85~            ; Change only the background color for R0lphamosaic generators !
1821+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
1822+  6E85~            ;			TEMP4-1 = old background color (0 to 7), TEMP4 = new background color (0 to 7)
1823+  6E85~            ; USED Registers :TEMP2-1,TEMP3-1,TEMP3,TEMP4-1,TEMP4
1824+  6E85~            ; USED Mem :XSX,YSY
1825+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmacmpxy,test_draw
1826+  6E85~            	.module rbgcolor
1827+  6E85~            replace_bgcolor
1828+  6E85~            	push A
1829+  6E85~            	push B
1830+  6E85~            	and %$7,TEMP4-1
1831+  6E85~            	and %$7,TEMP4
1832+  6E85~            	call @test_draw
1833+  6E85~            	jc _fin
1834+  6E85~            	movd TEMP1,R1
1835+  6E85~            	call @calcul_pointer
1836+  6E85~            _rept1
1837+  6E85~            	movd TEMP3,R1
1838+  6E85~            	call @set_acmpacmpxy
1839+  6E85~            	mov TEMP2,B
1840+  6E85~            _rept2
1841+  6E85~            	lvdp
1842+  6E85~            	btjz %$08,A,_alphanum
1843+  6E85~            	push A
1844+  6E85~            	and %$07,A
1845+  6E85~            	cmp TEMP4-1,A
1846+  6E85~            	jeq _replace
1847+  6E85~            	pop A
1848+  6E85~            	jmp _noreplace
1849+  6E85~            _replace
1850+  6E85~            	pop A	
1851+  6E85~            	and %$F8,A
1852+  6E85~            	or TEMP4,A
1853+  6E85~            _noreplace		
1854+  6E85~            _alphanum
1855+  6E85~            	wvdp(A)
1856+  6E85~            	lvdp
1857+  6E85~            	wvdp(A)
1858+  6E85~            	djnz B,_rept2
1859+  6E85~            	add %LENGTHLINE,TEMP3
1860+  6E85~            	adc %0,TEMP3-1
1861+  6E85~            	djnz TEMP2-1,_rept1
1862+  6E85~            _fin
1863+  6E85~            	pop B
1864+  6E85~            	pop A
1865+  6E85~            	rets
1866+  6E85             #ENDIF
