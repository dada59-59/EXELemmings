0153+  6E85~            #IFDEF Fset_BORDER
0154+  6E85~            #DEFINE Fdraw_border
0155+  6E85~            #deFINE Fset_CM
0156+  6E85~            ; set the border color of displayed page
0157+  6E85~            ; This function is compatible with TEXT and MIXT mode but works differently
0158+  6E85~            ; TEXT mode => the related CM7 bit is fixed (very fast)
0159+  6E85~            ; MIXT mode => same as TEXT mode and each end line pattern is set to border color mode (required but slower than TEXT mode)
0160+  6E85~            ; The cursor position is not modified.
0161+  6E85~            ; IN :A = color value of the border (0 to 7)
0162+  6E85~            ; USED Registers :TEMP4
0163+  6E85~            ; USED Mem :VIDEOMODE
0164+  6E85~            ; DEPENDENCIES :set_CM,draw_border
0165+  6E85~            set_BORDER
0166+  6E85~            	push A
0167+  6E85~            	push B
0168+  6E85~            	mov %$07,B
0169+  6E85~            	rr A
0170+  6E85~            	rr A
0171+  6E85~            	rr A
0172+  6E85~            	push A
0173+  6E85~            	mov A,TEMP4
0174+  6E85~            	lda @VIDEOMODE
0175+  6E85~            	btjz %$80,A,not_mixtmode
0176+  6E85~            	call @draw_border
0177+  6E85~            not_mixtmode
0178+  6E85~            	pop A	
0179+  6E85~            	jmp set_CM
0180+  6E85             #ENDIF
0181+  6E85             
0182+  6E85~            #IFDEF Fset_TEXTMODE
0183+  6E85~            #DEFINE Fset_CM
0184+  6E85~            ; configure the video mode to TEXT mode (LENGTHLINE=80)
0185+  6E85~            ; USED Mem :VIDEOMODE
0186+  6E85~            ; DEPENDENCIES :set_CM
0187+  6E85~            set_TEXTMODE
0188+  6E85~            	push A
0189+  6E85~            	push B
0190+  6E85~            	mov %$06,B
0191+  6E85~            	mov %$48,A
0192+  6E85~            	sta @VIDEOMODE
0193+  6E85~            	jmp set_CM
0194+  6E85             #ENDIF
0195+  6E85             	
0196+  6E85~            #IFDEF Fset_MIXTMODE
0197+  6E85~            #DEFINE Fset_CM
0198+  6E85~            #DEFINE Fmixt_config
0199+  6E85~            ; configure the video mode to MIXT mode (LENGTHLINE=82)
0200+  6E85~            ; This function is useful to apply complex MIXT definition and/or border definition.
0201+  6E85~            ; It calls mixt_configurator which is very helpful to configure a MIXT page (see mixt_configurator)
0202+  6E85~            ; because MIXT mode is very complex but very powerful !
0203+  6E85~            ; The cursor position is not modified.
0204+  6E85~            ; IN :B = adr of the MIXT configuration data structure (required)
0205+  6E85~            ; USED Mem :VIDEOMODE,MIXT_CONFIG
0206+  6E85~            ; DEPENDENCIES :set_CM,mixt_configurator
0207+  6E85~            set_MIXTMODE
0208+  6E85~            	push A
0209+  6E85~            	push B
0210+  6E85~            	sta @MIXT_CONFIG
0211+  6E85~            	xchb A
0212+  6E85~            	sta @MIXT_CONFIG+1
0213+  6E85~            	call @mixt_config
0214+  6E85~            	mov %$06,B
0215+  6E85~            	mov %$C8,A
0216+  6E85~            	sta @VIDEOMODE
0217+  6E85             #ENDIF
0218+  6E85             					
0219+  6E85~            #IFDEF Fset_CM
0220+  6E85~            ; Reserved function used by "set" function which modify CM registers
0221+  6E85~            ; Try it at your own risk !
0222+  6E85~            set_CM
0223+  6E85~            	movp B,P45
0224+  6E85~            	movp A,P45
0225+  6E85~            	pop B
0226+  6E85~            	pop A
0227+  6E85~            	rets
0228+  6E85             #ENDIF
0229+  6E85             
0230+  6E85~            #IFDEF Fdraw_border
0231+  6E85~            #DEFINE Fset_acmpacmpxy
0232+  6E85~            ; Reserved function used by set_border function for MIXT mode
0233+  6E85~            ; Try it at your own risk !
0234+  6E85~            ; Change the border attribute in the byte 81 f each line
0235+  6E85~            ; The cursor position is not modified.
0236+  6E85~            ; IN :TEMP4 = color value of the border (0 to 7)
0237+  6E85~            ; USED Registers :TEMP1-1,TEMP1,TEMP2-1,TEMP2,
0238+  6E85~            ; USED Mem :VIDEOBUF,LINE_NUMBER,XSX,YSY
0239+  6E85~            ; DEPENDENCIES :calc_pointer,set_acmacmpxy,locate
0240+  6E85~            	.module draw_border
0241+  6E85~            draw_border
0242+  6E85~            	push B
0243+  6E85~            	lda @VIDEOBUF+1
0244+  6E85~            	mov A,TEMP2
0245+  6E85~            	lda @VIDEOBUF
0246+  6E85~            	mov A,TEMP2-1
0247+  6E85~            	decd TEMP2
0248+  6E85~            	decd TEMP2
0249+  6E85~            ;	lda @LINE_NUMBER
0250+  6E85~            ;	<=> mpy %10,A, mais gagne 15 cycles
0251+  6E85~            ;	rl A
0252+  6E85~            ;	mov A,B
0253+  6E85~            ;	rl A
0254+  6E85~            ;	rl A
0255+  6E85~            ;	add B,A
0256+  6E85~            	
0257+  6E85~            	mov %250,TEMP1
0258+  6E85~            	clr A
0259+  6E85~            _rept	
0260+  6E85~            	btjz %$08,A,_text_mode
0261+  6E85~            	dec TEMP1
0262+  6E85~            	add %122,TEMP2
0263+  6E85~            	jmp _calc_pointer
0264+  6E85~            _text_mode	
0265+  6E85~            	sub %10,TEMP1
0266+  6E85~            	add %82,TEMP2
0267+  6E85~            _calc_pointer	
0268+  6E85~            	adc %0,TEMP2-1
0269+  6E85~            	movd TEMP2,R1
0270+  6E85~            	call @set_acmpacmpxy
0271+  6E85~            	lvdp
0272+  6E85~            	and %$1F,A
0273+  6E85~            	or TEMP4,A
0274+  6E85~            	wvdp(A)
0275+  6E85~            	cmp %0,TEMP1
0276+  6E85~            	jne _rept
0277+  6E85~            	pop B
0278+  6E85~            	rets
0279+  6E85             #ENDIF
0280+  6E85             
0281+  6E85~            #IFDEF Fmixt_config
0282+  6E85~            #DEFINE Fset_acmpxy
0283+  6E85~            ; configure a complex MIXT mode in a simple way
0284+  6E85~            ; VIDEOBUF data structure has to be set
0285+  6E85~            ; MIXT_CONFIG data structure has to be set
0286+  6E85~            ; because MIXT mode is very complex but very powerful !
0287+  6E85~            ; MIXT_CONFIG is a pointer to MIXT_CONFIG data:
0288+  6E85~            ; MIXT_CONFIG data are 25 (or 25) bytes, each of them represents the byte 81 of a line in MIXT mode
0289+  6E85~            ; These data allows to set the border color and type of the line (text or bitmap) of the following lines.
0290+  6E85~            ; All these data are stored downward (to optimize memory access)
0291+  6E85~            ; The cursor position is not modified.
0292+  6E85~            ; IN :VIDEOBUF and MIXT_CONFIG is setup
0293+  6E85~            ; USED Registers :A,B,TEMP1-1,TEMP1,TEMP2-1,TEMP2,TEMP3-1,TEMP3,
0294+  6E85~            ; USED Mem :VIDEOMODE,MIXT_CONFIG,LINE_NUMBER,XSX,YSY
0295+  6E85~            ; DEPENDENCIES :calc_pointer,set_acmpxy,locate
0296+  6E85~            	.module mixt_config
0297+  6E85~            mixt_config
0298+  6E85~            	lda @VIDEOBUF+1
0299+  6E85~            	mov A,TEMP2
0300+  6E85~            	lda @VIDEOBUF
0301+  6E85~            	mov A,TEMP2-1
0302+  6E85~            	lda @MIXT_CONFIG+1
0303+  6E85~            	mov A,TEMP3
0304+  6E85~            	lda @MIXT_CONFIG
0305+  6E85~            	mov A,TEMP3-1	
0306+  6E85~            ;	lda @LINE_NUMBER
0307+  6E85~            	mov %25,TEMP1
0308+  6E85~            	clr A
0309+  6E85~            	decd TEMP2
0310+  6E85~            	decd TEMP2
0311+  6E85~            _rept1
0312+  6E85~            	btjo %$08,A,_graph_mode
0313+  6E85~            	add %82,TEMP2
0314+  6E85~            	jmp _calc_pointer
0315+  6E85~            _graph_mode
0316+  6E85~            	add %122,TEMP2
0317+  6E85~            _calc_pointer
0318+  6E85~            	adc %0,TEMP2-1
0319+  6E85~            	movd TEMP2,R1
0320+  6E85~            	call @set_acmpxy
0321+  6E85~            	lda *TEMP3
0322+  6E85~            	wvdp(A)
0323+  6E85~            	wvdp(%0)
0324+  6E85~            	btjz %$08,A,_text_mode
0325+  6E85~            	mov %9,TEMP1-1
0326+  6E85~            _rept2
0327+  6E85~            	add %122,TEMP2
0328+  6E85~            	adc %0,TEMP2-1
0329+  6E85~            	push A
0330+  6E85~            	movd TEMP2,R1
0331+  6E85~            	call @set_acmpxy
0332+  6E85~            	pop A
0333+  6E85~            	wvdp(A)
0334+  6E85~            	wvdp(%0)
0335+  6E85~            	djnz TEMP1-1,_rept2	
0336+  6E85~            _text_mode
0337+  6E85~            	decd TEMP3
0338+  6E85~            	djnz TEMP1,_rept1
0339+  6E85~            	rets
0340+  6E85             #ENDIF
0341+  6E85             
0342+  6E85             
0343+  6E85             ; All the following set_ functions modify one character attribute for next display.
0344+  6E85             ; Results of a set_ functions depends on the generator class (alphamosaic or alphanumeric).
0345+  6E85             ; A direct memory write of ATRCAR is a better way for global attributes change (and not only one).
0346+  6E85             
0347+  6E85~            #IFDEF Fset_color
0348+  6E85~            ; set the color attribute for character printing
0349+  6E85~            ; only color is changed, others attribute are unchanged
0350+  6E85~            ; IN :B = color value (0 to 7)
0351+  6E85~            ; USED Mem :ATRCAR
0352+  6E85~            	.module set_color
0353+  6E85~            set_color
0354+  6E85~            	push A
0355+  6E85~            	push B
0356+  6E85~            	lda @ATRCAR
0357+  6E85~            	and %$1F,A
0358+  6E85~            	and %$7,B
0359+  6E85~            	rr B
0360+  6E85~            	rr B
0361+  6E85~            	rr B
0362+  6E85~            	or B,A
0363+  6E85~            	sta @ATRCAR
0364+  6E85~            	pop B
0365+  6E85~            	pop A
0366+  6E85~            	rets
0367+  6E85             #ENDIF
0368+  6E85             
0369+  6E85~            #IFDEF Fset_bgcolor
0370+  6E85~            ; set the background color attribute for character printing
0371+  6E85~            ; only background color is changed, others attribute are unchanged
0372+  6E85~            ; This function is used only for alphamosaic character generator,
0373+  6E85~            ; for alphanumeric generator you must use set_border instead
0374+  6E85~            ; IN :B = color value (0 to 7)
0375+  6E85~            ; USED Mem :ATRCAR
0376+  6E85~            	.module set_bgcolor
0377+  6E85~            set_bgcolor
0378+  6E85~            	push A
0379+  6E85~            	push B
0380+  6E85~            	lda @ATRCAR
0381+  6E85~            	btjz %$08,A,_fin
0382+  6E85~            	and %$F8,A
0383+  6E85~            	and %$7,B
0384+  6E85~            	or B,A
0385+  6E85~            	sta @ATRCAR
0386+  6E85~            _fin
0387+  6E85~            	pop B
0388+  6E85~            	pop A	
0389+  6E85~            	rets
0390+  6E85             #ENDIF
0391+  6E85             
0392+  6E85~            #IFDEF Fset_generator
0393+  6E85~            ; set the character generator for next printing
0394+  6E85~            ; only generator is changed, others attribute are unchanged
0395+  6E85~            ; IN :B = color value (0 to 3)
0396+  6E85~            ; USED Mem :ATRCAR
0397+  6E85~            	.module set_generator
0398+  6E85~            set_generator
0399+  6E85~            	push A
0400+  6E85~            	push B
0401+  6E85~            	lda @ATRCAR
0402+  6E85~            	and %$E7,A
0403+  6E85~            	and %$3,B
0404+  6E85~            	rl B
0405+  6E85~            	rl B
0406+  6E85~            	rl B
0407+  6E85~            	or B,A
0408+  6E85~            	sta @ATRCAR
0409+  6E85~            	pop B
0410+  6E85~            	pop A	
0411+  6E85~            	rets
0412+  6E85             #ENDIF
0413+  6E85             
0414+  6E85~            #IFDEF Fset_invideo
0415+  6E85~            ; Inverse video the attribute character (Color and background color are exchanged)
0416+  6E85~            ; only related color attributes are changed, others attribute are unchanged.
0417+  6E85~            ; This is a flip-flop function (color and background are swap at each time).
0418+  6E85~            ; This function is compatible with alphamosaic and alphanumeric generator:
0419+  6E85~            ; for alphanumeric generator the Inverse Video bit is XOR
0420+  6E85~            ; for alphamosaic generator the 3bits for color and background are exchanged
0421+  6E85~            ; USED Mem :ATRCAR
0422+  6E85~            	.module set_invideo
0423+  6E85~            set_invideo
0424+  6E85~            	push A
0425+  6E85~            	push B
0426+  6E85~            	lda @ATRCAR
0427+  6E85~            	btjo %$08,A,inv_mosaic
0428+  6E85~            	xor %$04,A
0429+  6E85~            	jmp _fin
0430+  6E85~            inv_mosaic	
0431+  6E85~            	mov A,B
0432+  6E85~            	push A
0433+  6E85~            	and %$18,A
0434+  6E85~            	rr B
0435+  6E85~            	rr B
0436+  6E85~            	rr B
0437+  6E85~            	and %$E0,B
0438+  6E85~            	or B,A
0439+  6E85~            	pop B
0440+  6E85~            	rl B
0441+  6E85~            	rl B
0442+  6E85~            	rl B
0443+  6E85~            	and %$7,B
0444+  6E85~            	or B,A
0445+  6E85~            _fin
0446+  6E85~            	sta @ATRCAR
0447+  6E85~            	pop B
0448+  6E85~            	pop A		
0449+  6E85~            	rets
0450+  6E85             #ENDIF
0451+  6E85             
0452+  6E85~            #IFDEF Fset_Dwidth
0453+  6E85~            #DEFINE Fset_wh
0454+  6E85~            ; set the double width size for next printing
0455+  6E85~            ; only width is changed, others attribute are unchanged
0456+  6E85~            ; This function is compatible with alphanumeric generator only !
0457+  6E85~            ; USED Mem :ATRCAR
0458+  6E85~            ; DEPENDENCIES : set_width_heigth
0459+  6E85~            set_Dwidth
