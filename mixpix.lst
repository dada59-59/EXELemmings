5126   2D16 8E 21 F9            call    @surface_find
5127   2D19 8B C7 E1            sta     @tmp_g                  ; resultat : 0 mur / 1 grimpe / 2 tombe
5128   2D1C             
5129   2D1C                     ; --- bloqueur sur l'ecran vise ? Sonde AVANT de restaurer l'ecran
5130   2D1C                     ; ACTUEL : blocker_at lit lui aussi lem_screen(cur_lem), et doit
5131   2D1C                     ; donc encore le trouver bascule sur l'ecran vise a cet instant.
5132   2D1C 8A C7 E1            lda     @tmp_g
5133   2D1F 2D 01               cmp     %1,A
5134   2D21 E6 0F               jne     @lw_ns_noblk
