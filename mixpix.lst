1421+  6E85~            	and TEMP4-1,A
1422+  6E85~            	mov A,B
1423+  6E85~            	inv TEMP4-1
1424+  6E85~            	lda @XSX
1425+  6E85~            	mov A,B
1426+  6E85~            	lda @YSY
1427+  6E85~            	call @calcul_pointer
1428+  6E85~            	call @set_acmpacmpxy
1429+  6E85~            	lvdp
1430+  6E85~            	and TEMP4-1,A
1431+  6E85~            	or R0,B
