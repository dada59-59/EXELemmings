1942   16A0             ; ============================================================================
1943   16A0             ; vram_line_addr -- routine PARTAGEE : tv_hi:tv_lo = GRAPH_BASE
1944   16A0             ;   + a_yline*MAPPLEN + a_xseg*3   (3 octets par segment : B, G, R)
1945   16A0             ; Utilisee par le viseur ET par le lemming, pour n'avoir qu'un seul endroit
1946   16A0             ; ou ce calcul peut etre faux.
1947   16A0             ; ============================================================================
1948   16A0             vram_line_addr:
1949   16A0                     ; MULTIPLICATION, pas addition repetee. La premiere version ajoutait
1950   16A0                     ; MAPPLEN autant de fois que le numero de ligne : jusqu'a 199 tours
1951   16A0                     ; de boucle, pour UN appel. Multiplie par les ~42 appels que coute
1952   16A0                     ; un deplacement du viseur, cela representait plus de 30000
1953   16A0                     ; instructions, soit environ 120 ms -- du meme ordre que les 160 ms
1954   16A0                     ; separant deux pas du lemming. C'etait la vraie cause du
1955   16A0                     ; ralentissement, et aucune gestion de ticks ne pouvait la corriger.
1956   16A0                     ; MPY fait le calcul en une instruction : a_yline*MAPPLEN tient sur
1957   16A0                     ; 16 bits (199*122 = 24278).
1958   16A0 22 06               mov     %GRAPH_BASE>>8,A
1959   16A2 D0 0D               mov     A,TEMP1-1
1960   16A4 22 A4               mov     %GRAPH_BASE&$FF,A
1961   16A6 D0 0E               mov     A,TEMP1
1962   16A8             
1963   16A8 8A C4 16            lda     @a_yline                ; + a_yline * MAPPLEN
1964   16AB 2C 7A               mpy     %MAPPLEN,A              ; A = poids fort, B = poids faible
1965   16AD D0 18               mov     A,TEMP6
1966   16AF D1 1A               mov     B,TEMP7
1967   16B1 48 1A 0E            add     TEMP7,TEMP1             ; l'ADD pose la retenue,
1968   16B4 49 18 0D            adc     TEMP6,TEMP1-1           ; l'ADC la consomme aussitot
1969   16B7             
1970   16B7 8A C4 15            lda     @a_xseg                 ; + a_xseg * 3 (3 octets B,G,R)
1971   16BA 2C 03               mpy     %3,A
1972   16BC D0 18               mov     A,TEMP6
1973   16BE D1 1A               mov     B,TEMP7
1974   16C0 48 1A 0E            add     TEMP7,TEMP1
1975   16C3 49 18 0D            adc     TEMP6,TEMP1-1
1976   16C6             
1977   16C6 12 0E               mov     TEMP1,A
1978   16C8 8B C4 05            sta     @tv_lo
1979   16CB 12 0D               mov     TEMP1-1,A
1980   16CD 8B C4 04            sta     @tv_hi
1981   16D0 0A                  rets
1982   16D1             
1983   16D1             ; ============================================================================
1984   16D1             ; cur_addr -- adresse de la ligne cl_ctr du viseur. Simple mise en place des
1985   16D1             ; parametres de vram_line_addr, depuis que celle-ci est partagee.
1986   16D1             ; ============================================================================
1987   16D1             cur_addr:
1988   16D1                     ; Meme principe que ldw_line / bdr_line : seule la premiere ligne
1989   16D1                     ; du viseur demande le calcul complet (2 MPY), les quinze suivantes
1990   16D1                     ; s'obtiennent en ajoutant MAPPLEN. Sur les 16 lignes, cela evite
1991   16D1                     ; 15 calculs d'adresse complets a CHAQUE dessin du viseur -- et le
1992   16D1                     ; viseur est redessine a chaque deplacement, donc tres souvent.
1993   16D1 8A C4 0B            lda     @cl_ctr
1994   16D4 E6 10               jne     @ca_next
1995   16D6 8A C4 07            lda     @cur_y
1996   16D9 8B C4 16            sta     @a_yline
1997   16DC 8A C4 06            lda     @cur_xseg
1998   16DF 8B C4 15            sta     @a_xseg
1999   16E2 8E 16 A0            call    @vram_line_addr
2000   16E5 0A                  rets
2001   16E6             ca_next:
2002   16E6 8A C4 05            lda     @tv_lo                  ; tv += MAPPLEN
2003   16E9 28 7A               add     %MAPPLEN&$FF,A
2004   16EB E7 0C               jnc     @ca_nc
2005   16ED 8B C4 05            sta     @tv_lo
2006   16F0 8A C4 04            lda     @tv_hi
2007   16F3 28 01               add     %MAPPLEN_HI_C,A
2008   16F5 8B C4 04            sta     @tv_hi
2009   16F8 0A                  rets
2010   16F9             ca_nc:
2011   16F9 8B C4 05            sta     @tv_lo
2012   16FC 0A                  rets
