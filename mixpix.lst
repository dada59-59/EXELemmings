3555   22F9 C0                  mov     A,B
3556   22FA AA C5 2A            lda     @lem_y(B)
3557   22FD 8B C6 B9            sta     @blk_y
3558   2300 B5                  clr     A
3559   2301 8B C6 BA            sta     @blk_i
3560   2304             ba_loop:
