0003+  6E7A             ; TEXT-MIXT API
0004+  6E7A             ; WARNING !!! All the operations on VDP have to be handled by API functions and API data structure
0005+  6E7A             ; Some elements of data structure can be modify directly (some details at the end of the source code)
0006+  6E7A             ; The whole of these functions save the A & B registers (keep unchanged for user program), exceptions are pointed out !
0007+  6E7A             
0008+  6E7A             ; This information is a constant for efficiency
0009+  6E7A             ; It means you cannot swap between TEXT and MIXT mode
0010+  6E7A             LENGTHLINE  .EQU 82  ; Length of a line (text mode=80, mixt mode=82)
0011+  6E7A             
0012+  6E7A             ; WINDOWING Data
0013+  6E7A             ACTIVE_WD		.equ $C310 ; pointer on the user active window (2 bytes)
0014+  6E7A             ; Internal data for the active window
0015+  6E7A             XSX					.equ $C312	; Cursor position column
0016+  6E7A             YSY					.equ $C313 ; Cursor position line
0017+  6E7A             ATRCAR			.equ $C314 ; character attribute
0018+  6E7A             FLASH				.equ $C315 ; Flash attribute (flag on/off)
0019+  6E7A             WINDOW_X		.equ $C316 ; window position X from the screen adr
0020+  6E7A             WINDOW_Y		.equ $C317 ; window position Y from the screen adr
0021+  6E7A             WINDOW_W		.equ $C318 ; window width
0022+  6E7A             WINDOW_H		.equ $C319 ; window heigth
0023+  6E7A             ; Global data
0024+  6E7A             SCREEN			.equ $C320 ; start adr for API (and window) drawing (2 bytes)
0025+  6E7A             VIDEOBUF		.equ $C322	; VRAM page adr (BAPA) (2 bytes)
0026+  6E7A             MIXT_CONFIG	.equ $C324 ; pointer on user configuration data for MIXT mode (2 bytes)
0027+  6E7A             LINE_NUMBER	.equ $C326 ; number of line in VRAM page (24/25)
0028+  6E7A             VIDEOMODE		.equ $C327 ; save the current video mode
0029+  6E7A             ; Symbol values for drawing a box:
0030+  6E7A             ; upleft_corner,upright_corner,bottomleft_corner,bottomrigth_corner,horizontal,vertical
0031+  6E7A             ; you can even modify these symbols at execution time if needed
0032+  6E7A             box_pattern .equ $C328 ; 6 bytes
