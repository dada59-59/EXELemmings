3890   2512                     ; --- fin du decompte : on efface le corps et on libere la place ---
3891   2512 8A C4 C1            lda     @cur_lem
3892   2515 C0                  mov     A,B
3893   2516 AA C5 20            lda     @lem_xseg(B)
3894   2519 8B C4 C3            sta     @r_xseg
3895   251C 22 01               mov     %LEM_WSEG,A
3896   251E 8B C4 C4            sta     @r_wseg
3897   2521 8A C4 C1            lda     @cur_lem
