2293   1A24             ; --- tb_hi:tb_lo = lv_tiles + q_line*3 (debut de la bonne ligne dans
2294   1A24             ; n'importe quelle tuile) --------------------------------------------------
2295   1A24             rect_tilebase:
2296   1A24 8A C4 C8            lda     @q_line
2297   1A27 C0                  mov     A,B
2298   1A28 68                  add     B,A
2299   1A29 68                  add     B,A                     ; A = q_line*3
2300   1A2A D0 14               mov     A,TEMP4
2301   1A2C 8A C7 AB            lda     @tiles_lo               ; tuiles du theme du niveau
2302   1A2F 18 14               add     TEMP4,A
2303   1A31 E7 0B               jnc     @rtb_nc                 ; retenue AVANT le sta
2304   1A33 8B C4 13            sta     @tb_lo
2305   1A36 8A C7 AC            lda     @tiles_hi
2306   1A39 B3                  inc     A
2307   1A3A 8B C4 12            sta     @tb_hi
2308   1A3D 0A                  rets
