3098   2096             
3099   2096             ; --- cette case porte-t-elle une tuile posee ? Sortie : A != 0 si oui ------
3100   2096             built_test:
3101   2096 8E 20 85            call    @built_key
3102   2099 8A C7 9D            lda     @build_n
3103   209C E6 01               jne     @bt_filter
3104   209E 0A                  rets                            ; liste vide : A = 0
3105   209F             bt_filter:
3106   209F                     ; --- filtre rapide : cette rangee a-t-elle deja recu une tuile
3107   209F                     ; posee ? Sinon, inutile de parcourir la liste (~58 cycles par
3108   209F                     ; entree, jusqu'a MAX_BUILT entrees, a CHAQUE test de pixel).
3109   209F 8A C7 A8            lda     @bkey
3110   20A2 23 07               and     %7,A
3111   20A4 C0                  mov     A,B
3112   20A5 AA 21 2D            lda     @bit_tbl(B)             ; masque du bit (bkey & 7)
3113   20A8 D0 16               mov     A,TEMP5
3114   20AA 8A C7 A8            lda     @bkey
3115   20AD BC                  rr      A
3116   20AE BC                  rr      A
3117   20AF BC                  rr      A
3118   20B0 23 1F               and     %$1F,A                  ; octet = bkey / 8
3119   20B2 C0                  mov     A,B
3120   20B3 AA C7 EC            lda     @built_rows(B)
3121   20B6 13 16               and     TEMP5,A
3122   20B8 E6 01               jne     @bt_scan0
3123   20BA 0A                  rets                            ; A = 0 : rien de pose dans la rangee
3124   20BB             bt_scan0:
3125   20BB 8A C7 9D            lda     @build_n
3126   20BE             bt_scan:
3127   20BE D0 16               mov     A,TEMP5                 ; compteur
3128   20C0 B5                  clr     A
3129   20C1 C0                  mov     A,B                     ; index
3130   20C2             bt_loop:
3131   20C2 AA C7 0D            lda     @build_key(B)
3132   20C5 8D C7 A8            cmpa    @bkey
3133   20C8 E6 0F               jne     @bt_next
3134   20CA AA C7 3D            lda     @build_col(B)
3135   20CD 8D C4 CB            cmpa    @d_col
3136   20D0 E6 07               jne     @bt_next
3137   20D2 62                  mov     B,A
3138   20D3 8B C7 DF            sta     @bt_found               ; index memorise : l'appelant lira
3139   20D6                                                     ; build_tile(bt_found) pour savoir
3140   20D6                                                     ; QUELLE tuile afficher ici
3141   20D6 22 01               mov     %1,A
3142   20D8 0A                  rets                            ; trouvee
3143   20D9             bt_next:
3144   20D9 62                  mov     B,A
3145   20DA B3                  inc     A
3146   20DB C0                  mov     A,B
3147   20DC DA 16 E3            djnz    TEMP5,@bt_loop
3148   20DF B5                  clr     A
3149   20E0 0A                  rets
3150   20E1             
3151   20E1             ; --- ajoute la case courante a la liste (silencieux si elle est pleine) ----
3152   20E1             ; Entree : A = index de la tuile a memoriser pour cette case (pas toujours
3153   20E1             ; BUILD_TILE desormais : une marche d'escalier peut poser TILE_MARCHEA ou
3154   20E1             ; TILE_MARCHEB). Sauvegarde d'abord dans bt_arg : built_key (via MPY) et le
3155   20E1             ; calcul d'adresse ecrasent A et B plusieurs fois avant qu'on en ait besoin.
3156   20E1             built_add:
3157   20E1 8B C5 10            sta     @bt_arg
3158   20E4 8A C7 9D            lda     @build_n
3159   20E7 2D 30               cmp     %MAX_BUILT,A
3160   20E9 E7 01               jnc     @ba_room
3161   20EB 0A                  rets                            ; liste saturee : on ignore
3162   20EC             ba_room:
3163   20EC B5                  clr     A                       ; le terrain change : cache invalide
3164   20ED 8B C7 CF            sta     @rtc_valid
3165   20F0                     ; built_key utilise MPY, qui ECRASE B : il faut donc l'appeler
3166   20F0                     ; AVANT de charger l'index de la liste dans B. Une premiere version
3167   20F0                     ; faisait l'inverse et ecrivait l'entree a un index arbitraire --
3168   20F0                     ; la brique n'etait jamais retrouvee, et le lemming tombait.
3169   20F0 8E 20 85            call    @built_key
3170   20F3 8A C7 9D            lda     @build_n
3171   20F6 C0                  mov     A,B
3172   20F7 8A C7 A8            lda     @bkey
3173   20FA AB C7 0D            sta     @build_key(B)
3174   20FD 8A C4 CB            lda     @d_col
3175   2100 AB C7 3D            sta     @build_col(B)
3176   2103 8A C5 10            lda     @bt_arg
3177   2106 AB C7 6D            sta     @build_tile(B)
3178   2109 8A C7 9D            lda     @build_n
3179   210C B3                  inc     A
3180   210D 8B C7 9D            sta     @build_n
3181   2110 8A C7 A8            lda     @bkey                   ; marque la rangee pour le filtre
3182   2113 23 07               and     %7,A                    ; rapide de built_test
3183   2115 C0                  mov     A,B
3184   2116 AA 21 2D            lda     @bit_tbl(B)
3185   2119 D0 16               mov     A,TEMP5
3186   211B 8A C7 A8            lda     @bkey
3187   211E BC                  rr      A
3188   211F BC                  rr      A
3189   2120 BC                  rr      A
3190   2121 23 1F               and     %$1F,A
3191   2123 C0                  mov     A,B
3192   2124 AA C7 EC            lda     @built_rows(B)
3193   2127 14 16               or      TEMP5,A
3194   2129 AB C7 EC            sta     @built_rows(B)
3195   212C 0A                  rets
3196   212D             
3197   212D             ; masque d'un bit : bit_tbl(n) = 1 << n
3198   212D             bit_tbl:
3199   212D 01 02 04 08         .byte   $01,$02,$04,$08,$10,$20,$40,$80
3199   2131 10 20 40 80 
3200   2135             
3201   2135             ; --- une marche d'escalier fraichement sondee (via pix_solid, qui laisse
3202   2135             ; l'index trouve dans tid) est-elle franchissable pour CE lemming, selon
3203   2135             ; SON propre sens de marche ? Sortie : A = 0 si c'est un mur (marche
3204   2135             ; construite dans le sens oppose), A != 0 sinon (bon sens, OU tuile
3205   2135             ; ordinaire qui n'a aucune notion de sens).
3206   2135             ; Sans ce controle, un escalier construit dans un sens etait grimpe tout
3207   2135             ; aussi lissement dans l'AUTRE sens (chaque marche, prise isolement, reste
3208   2135             ; sous MAX_STEP_UP) -- alors qu'un escalier ne devrait bloquer, comme un
3209   2135             ; vrai mur, que ceux qui l'abordent a contresens.
3210   2135             stair_dir_ok:
3211   2135 8A C4 14            lda     @tid
3212   2138 2D 02               cmp     %TILE_MARCHEA,A
3213   213A E2 1A               jeq     @sdo_right
3214   213C 2D 04               cmp     %TILE_MARCHEB,A
3215   213E E2 16               jeq     @sdo_right
3216   2140 2D 06               cmp     %TILE_MARCHEC,A
3217   2142 E2 12               jeq     @sdo_right
3218   2144 8A C4 14            lda     @tid
3219   2147 2D 03               cmp     %TILE_MARCHEAG,A
3220   2149 E2 17               jeq     @sdo_left
3221   214B 2D 05               cmp     %TILE_MARCHEBG,A
3222   214D E2 13               jeq     @sdo_left
3223   214F 2D 07               cmp     %TILE_MARCHECG,A
3224   2151 E2 0F               jeq     @sdo_left
3225   2153 22 01               mov     %1,A                    ; tuile ordinaire : toujours ok
3226   2155 0A                  rets
3227   2156             sdo_right:
3228   2156                     ; construite pour un lemming qui avance vers la DROITE (lem_dir=0)
3229   2156 8A C4 C1            lda     @cur_lem
3230   2159 C0                  mov     A,B
3231   215A AA C5 70            lda     @lem_dir(B)
3232   215D E6 0F               jne     @sdo_no
3233   215F 22 01               mov     %1,A
3234   2161 0A                  rets
3235   2162             sdo_left:
3236   2162                     ; construite pour un lemming qui avance vers la GAUCHE (lem_dir!=0)
3237   2162 8A C4 C1            lda     @cur_lem
3238   2165 C0                  mov     A,B
3239   2166 AA C5 70            lda     @lem_dir(B)
3240   2169 E2 03               jeq     @sdo_no
3241   216B 22 01               mov     %1,A
3242   216D 0A                  rets
3243   216E             sdo_no:
3244   216E B5                  clr     A
3245   216F 0A                  rets
