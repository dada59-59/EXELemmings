5085   2CE2 8C 2D 81            br      @lst_anim               ; anime quand meme : il piÃ©tine
5086   2CE5             
5087   2CE5             ; (lw_move a disparu : le deplacement se fait desormais dans lw_p_move,
5088   2CE5             ;  qui ajuste aussi la hauteur selon le relief sonde.)
5089   2CE5             
5090   2CE5             lw_next_screen:
5091   2CE5                     ; Bord droit. S'il reste un ecran a droite, le lemming y passe ;
5092   2CE5                     ; sinon il fait DEMI-TOUR -- le niveau a une fin, il ne boucle pas.
5093   2CE5                     ; Une premiere version revenait au premier ecran, ce qui donnait
5094   2CE5                     ; l'impression que le lemming se teleportait a l'autre bout.
5095   2CE5 8A C4 C1            lda     @cur_lem
5096   2CE8 C0                  mov     A,B
