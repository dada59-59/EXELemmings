0136+  6E85             	
0137+  6E85~            #IFDEF Fset_24LINE
0138+  6E85~            #DEFINE Fset_CM
0139+  6E85~            ; set the number of diplayed line to 24
0140+  6E85~            ; The first line is not displayed.
0141+  6E85~            ; USED Mem :LINE_NUMBER
0142+  6E85~            ; DEPENDENCIES :set_CM
0143+  6E85~            set_24LINE
0144+  6E85~            	push A
0145+  6E85~            	push B
0146+  6E85~            	mov %24,A
0147+  6E85~            	sta @LINE_NUMBER
0148+  6E85~            	mov %$05,B
0149+  6E85~            	mov %$88,A
0150+  6E85~            	jmp set_CM
