0870   10B9                                                     ; des briques au hasard.
0871   10B9 B5                  clr     A
0872   10BA 8B C7 E2            sta     @saved_count            ; aucun lemming sauve au demarrage
0873   10BD 8B C7 FC            sta     @mouse_act
0874   10C0 8B C7 E7            sta     @pass_ticks
0875   10C3 8B C7 F9            sta     @cur_pending
0876   10C6 8B C7 FA            sta     @skill_sel              ; premier pouvoir selectionne
0877   10C9 8B C7 FD            sta     @spawn_count            ; personne n'est encore sorti
0878   10CC 8B C7 FE            sta     @level_over
0879   10CF 8B C7 D6            sta     @level_won
0880   10D2 22 60               mov     %$60,A                  ; boutons de la souris consideres
0881   10D4 8B C7 E6            sta     @mouse_btn_latch        ; deja enfonces : celui qui a lance
0882   10D7                                                     ; ce niveau ne compte pas
