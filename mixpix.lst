2969   1F77             ; ============================================================================
2970   1F77             ; COUCHE DE DESTRUCTION
2971   1F77             ;
2972   1F77             ; Les cartes sont en ROM : on ne peut pas y effacer une tuile. On tient donc
2973   1F77             ; a cote, en RAM, UN BIT par case disant "creusee". 40x20 = 800 bits = 100
2974   1F77             ; octets par ecran ; 3 ecrans = 300 octets. Une copie complete des cartes
2975   1F77             ; aurait demande 800 octets par ecran, soit bien trop pour la SRAM.
2976   1F77             ;
2977   1F77             ; dig_locate -- pour la case (q_row, d_col) de l'ecran map_screen, calcule
2978   1F77             ; l'adresse de l'octet (dans TEMP3) et le masque de bit (dig_mask).
2979   1F77             ;   index = (map_screen*LV_MAP_H + q_row) * LV_MAP_W + d_col
2980   1F77             ;   octet = dig_map + index/8   ;   masque = 1 << (index & 7)
2981   1F77             ; d_col est un parametre distinct de r_xseg : les routines de dessin
2982   1F77             ; parcourent plusieurs colonnes a partir de r_xseg, il leur faut pouvoir
2983   1F77             ; interroger chacune d'elles.
2984   1F77             ; ============================================================================
2985   1F77             dig_locate:
2986   1F77                     ; --- index de la case = k*40 + colonne, k = ecran*20 + rangee
2987   1F77                     ; (0..59). 40 etant multiple de 8 : octet = k*5 + colonne/8, bit =
2988   1F77                     ; colonne & 7. Par TABLES (dig_row_lo/hi : dig_map + k*5 ;
2989   1F77                     ; scr20_tbl : ecran*20) au lieu de deux MPY et d'une boucle de
2990   1F77                     ; division : ~260 cycles au lieu de ~430, pour une routine appelee
2991   1F77                     ; une dizaine de fois par pas de lemming (chaque test de terrain).
2992   1F77                     ; Sorties inchangees : adresse de l'octet dans TEMP1 ET TEMP3,
2993   1F77                     ; masque dans dig_mask.
2994   1F77 8A C4 CA            lda     @map_screen
2995   1F7A C0                  mov     A,B
2996   1F7B AA 1F B6            lda     @scr20_tbl(B)           ; ecran * LV_MAP_H
2997   1F7E D0 18               mov     A,TEMP6
2998   1F80 8A C4 C7            lda     @q_row
2999   1F83 18 18               add     TEMP6,A                 ; k
3000   1F85 C0                  mov     A,B
3001   1F86 AA 1F F5            lda     @dig_row_hi(B)          ; dig_map + k*5
3002   1F89 D0 0D               mov     A,TEMP1-1
3003   1F8B AA 1F B9            lda     @dig_row_lo(B)
3004   1F8E D0 0E               mov     A,TEMP1
3005   1F90 8A C4 CB            lda     @d_col
3006   1F93 D0 1A               mov     A,TEMP7
3007   1F95 23 07               and     %7,A                    ; bit = colonne & 7
3008   1F97 C0                  mov     A,B
3009   1F98 AA 21 2D            lda     @bit_tbl(B)
3010   1F9B 8B C4 CE            sta     @dig_mask
3011   1F9E 12 1A               mov     TEMP7,A                 ; + colonne / 8
3012   1FA0 BC                  rr      A
3013   1FA1 BC                  rr      A
3014   1FA2 BC                  rr      A
3015   1FA3 23 1F               and     %$1F,A
3016   1FA5 D0 1A               mov     A,TEMP7
3017   1FA7 48 1A 0E            add     TEMP7,TEMP1
3018   1FAA 79 00 0D            adc     %0,TEMP1-1
3019   1FAD 12 0E               mov     TEMP1,A
3020   1FAF D0 12               mov     A,TEMP3
3021   1FB1 12 0D               mov     TEMP1-1,A
3022   1FB3 D0 11               mov     A,TEMP3-1
3023   1FB5 0A                  rets
3024   1FB6             
3025   1FB6             ; tables de dig_locate (LV_MAP_H = 20 et LV_MAP_W = 40 en dur : les regenerer
3026   1FB6             ; si la taille de la carte change) -- 3 ecrans x 20 rangees
3027   1FB6             scr20_tbl:
3028   1FB6 00 14 28            .byte   0,20,40
