3536   22DE 8A C7 B6            lda     @sf_s
3537   22E1 2A 0A               sub     %LEM_HLINES,A
3538   22E3 8B C7 B7            sta     @sf_y
3539   22E6 22 01               mov     %1,A
3540   22E8 0A                  rets
