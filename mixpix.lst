0471+  6E85~            ; only width is changed, others attribute are unchanged
0472+  6E85~            ; This function is compatible with alphanumeric generator only !
0473+  6E85~            ; USED Mem :ATRCAR
0474+  6E85~            ; DEPENDENCIES : set_width_heigth
0475+  6E85~            set_Swidth
