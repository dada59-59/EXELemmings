0493+  6E85~            	lda @ATRCAR
0494+  6E85~            	btjo %$08,A,fin_wh
0495+  6E85~            	or %$01,A
0496+  6E85~            	sta @ATRCAR
0497+  6E85~            	jmp set_wh
0498+  6E85             #ENDIF
0499+  6E85             	
0500+  6E85~            #IFDEF Fset_Sheigth
0501+  6E85~            #DEFINE Fset_wh
0502+  6E85~            ; set the simple heigth size for next printing
0503+  6E85~            ; only heigth is changed, others attribute are unchanged
0504+  6E85~            ; This function is compatible with alphanumeric generator only !
0505+  6E85~            ; USED Mem :ATRCAR
0506+  6E85~            set_Sheigth
