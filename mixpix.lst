2614   1C4D             ; ============================================================================
2615   1C4D             ; LEMMING -- sprite masque issu de lemdata.asm (EXELLEM)
2616   1C4D             ;
2617   1C4D             ; Format d'une vignette : en-tete "wseg, hblock", puis, par ligne et par
2618   1C4D             ; segment de 8 px, quatre octets M, B, G, R.
2619   1C4D             ;   masque a 1 = le pixel du sprite s'affiche
2620   1C4D             ;   masque a 0 = le decor reste visible
2621   1C4D             ; Composition, plan par plan : dst = (fond & ~M) | (sprite & M)
2622   1C4D             ; ============================================================================
2623   1C4D             
2624   1C4D             ; --- miroir horizontal du segment : evite de dessiner et de stocker un
2625   1C4D             ; second jeu de vignettes pour la marche vers la gauche -- le sprite ne
2626   1C4D             ; faisant qu'un segment de large, retourner ses octets suffit.
2627   1C4D             ; --- bitrev_tbl : octet a bits inverses (bit 7 <-> bit 0...), pour dessiner
2628   1C4D             ; un sprite en miroir. Remplace l'ancienne routine bitrev (boucle de 8 tours,
2629   1C4D             ; ~266 cycles par octet, 40 appels par lemming tourne vers la gauche : ~4 ms
2630   1C4D             ; par dessin, pres de la moitie d'un tick). Usage : mov A,B / lda @bitrev_tbl(B).
2631   1C4D             ; B n'est pas utilise dans la boucle ldw_seg, verifie avant le changement.
