1090   1208                     ; --- deplacement du viseur. Un seul chemin pour les 4 fleches :
1091   1208                     ; direction dans cur_bdir, nombre de pas selon le temps ecoule
1092   1208                     ; (cur_arrow_steps), position visee calculee SANS toucher a l'ecran,
1093   1208                     ; puis UN effacement a l'ancienne position (cur_commit). Le dessin a
1094   1208                     ; la nouvelle position est differe a ml_next, apres le pas des
1095   1208                     ; lemmings : il n'est donc fait qu'UNE fois par passage (voir la note
1096   1208                     ; a ml_next).
1097   1208 2D 83               cmp     %KEY_ARR_LEFT,A
1098   120A E6 04               jne     @ml_chk_right
1099   120C B5                  clr     A                       ; 0 = gauche
1100   120D 8C 12 28            br      @ml_arrow
1101   1210             ml_chk_right:
1102   1210 2D 81               cmp     %KEY_ARR_RIGHT,A
1103   1212 E6 05               jne     @ml_chk_up
1104   1214 22 01               mov     %1,A                    ; 1 = droite
1105   1216 8C 12 28            br      @ml_arrow
1106   1219             ml_chk_up:
1107   1219 2D 80               cmp     %KEY_ARR_UP,A
1108   121B E6 05               jne     @ml_chk_down
1109   121D 22 02               mov     %2,A                    ; 2 = haut
1110   121F 8C 12 28            br      @ml_arrow
1111   1222             ml_chk_down:
1112   1222 2D 82               cmp     %KEY_ARR_DOWN,A
1113   1224 E6 14               jne     @ml_chk_dig
1114   1226 22 03               mov     %3,A                    ; 3 = bas
1115   1228             ml_arrow:
1116   1228 8B C7 EB            sta     @cur_bdir
1117   122B 8E 13 6F            call    @cur_arrow_steps
1118   122E 8E 13 97            call    @cur_move_init
1119   1231 8E 13 A9            call    @cur_move_n
1120   1234 8E 13 F8            call    @cur_commit
1121   1237 8C 12 CF            br      @ml_next
