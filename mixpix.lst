1510+  6E85~            _rept1
1511+  6E85~            	movd TEMP3,R1
1512+  6E85~            	call @set_acmpacmpxy
1513+  6E85~            	mov TEMP2,B
1514+  6E85~            _rept2
1515+  6E85~            	lvdp
1516+  6E85~            	btjz %$08,A,_alphanum
1517+  6E85~            	and %$F8,A
1518+  6E85~            	or TEMP4,A
1519+  6E85~            _alphanum
1520+  6E85~            	wvdp(A)
1521+  6E85~            	lvdp
1522+  6E85~            	wvdp(A)
1523+  6E85~            	djnz B,_rept2
1524+  6E85~            	add %LENGTHLINE,TEMP3
