3912   253C             lst_build:
3913   253C                     ; Escalier en coin, BUILD_STEPS briques : chacune avance d'une
3914   253C                     ; colonne et monte d'une tuile complete (voir plus bas, "ESCALIER
3915   253C                     ; EN COIN", pour la geometrie A/B/C).
3916   253C                     ;
3917   253C                     ; ERREUR DE CONCEPTION CORRIGEE : une premiere version verifiait,
3918   253C                     ; pour une brique A PLAT, la case AU NIVEAU DU SOL ACTUEL -- qui,
3919   253C                     ; sur un terrain ordinaire, est DEJA de la terre. Le code prenait
3920   253C                     ; ca pour un mur et arretait la construction des la premiere
3921   253C                     ; brique, sur n'importe quel sol normal.
3922   253C                     ; Le vrai principe du constructeur (comme dans l'original) : il
3923   253C                     ; pose sa brique et monte dessus SANS se soucier de ce qu'il y a
3924   253C                     ; deja en dessous -- c'est ce qui lui permet de franchir un mur en
3925   253C                     ; construisant par-dessus. Le seul obstacle reel est un mur A
3926   253C                     ; HAUTEUR DU CORPS, exactement comme pour la marche normale.
3927   253C                     ; --- colonne ET ecran vises : le terrain s'etend continument sur
3928   253C                     ; plusieurs ecrans (une seule limitation materielle de l'EXL100,
3929   253C                     ; pas une frontiere du terrain) -- comme le fait deja la marche
3930   253C                     ; normale, le constructeur doit donc pouvoir continuer sur l'ecran
3931   253C                     ; suivant/precedent plutot que de traiter le bord d'ecran comme un
3932   253C                     ; mur permanent. new_scr est la MEME variable globale qu'utilise
3933   253C                     ; deja entry_blocked pour la marche normale.
3934   253C 8A C4 C1            lda     @cur_lem                ; colonne visee, selon le sens
3935   253F C0                  mov     A,B
3936   2540 AA C5 70            lda     @lem_dir(B)
3937   2543 E6 26               jne     @lsc_left
3938   2545 8A C4 C1            lda     @cur_lem
3939   2548 C0                  mov     A,B
3940   2549 AA C5 20            lda     @lem_xseg(B)
3941   254C B3                  inc     A
3942   254D 2D 28               cmp     %LEM_COLS,A
3943   254F E7 3C               jnc     @lsc_col                ; encore dans cet ecran
3944   2551                     ; --- bord droit : ecran suivant, s'il existe -----------------------
3945   2551 8A C4 C1            lda     @cur_lem
3946   2554 C0                  mov     A,B
3947   2555 AA C5 3E            lda     @lem_screen(B)
3948   2558 B3                  inc     A
3949   2559 8D C7 B0            cmpa    @cur_nscr               ; ecrans de CE niveau
3950   255C E7 03               jnc     @lsc_rs_go
3951   255E 8C 27 4A            br      @lsc_stop               ; dernier ecran : mur
3952   2561             lsc_rs_go:
3953   2561 8B C6 C7            sta     @new_scr
3954   2564 B5                  clr     A
3955   2565 8B C6 C8            sta     @new_col
3956   2568 8C 25 9A            br      @lsc_scrset
3957   256B             lsc_left:
3958   256B 8A C4 C1            lda     @cur_lem
3959   256E C0                  mov     A,B
3960   256F AA C5 20            lda     @lem_xseg(B)
3961   2572 E6 18               jne     @lsc_left_ok
3962   2574                     ; --- bord gauche : ecran precedent, s'il existe --------------------
3963   2574 8A C4 C1            lda     @cur_lem
3964   2577 C0                  mov     A,B
3965   2578 AA C5 3E            lda     @lem_screen(B)
3966   257B E6 03               jne     @lsc_ls_go
3967   257D 8C 27 4A            br      @lsc_stop               ; premier ecran : mur
3968   2580             lsc_ls_go:
3969   2580 B2                  dec     A
3970   2581 8B C6 C7            sta     @new_scr
3971   2584 22 27               mov     %LEM_LAST_XSEG,A
3972   2586 8B C6 C8            sta     @new_col
3973   2589 8C 25 9A            br      @lsc_scrset
3974   258C             lsc_left_ok:
3975   258C B2                  dec     A
3976   258D             lsc_col:
3977   258D 8B C6 C8            sta     @new_col                ; colonne de la brique ET d'arrivee
3978   2590 8A C4 C1            lda     @cur_lem
3979   2593 C0                  mov     A,B
3980   2594 AA C5 3E            lda     @lem_screen(B)
3981   2597 8B C6 C7            sta     @new_scr                ; meme ecran que sa position actuelle
3982   259A             lsc_scrset:
3983   259A 8A C6 C7            lda     @new_scr
3984   259D 8B C4 CA            sta     @map_screen             ; tout ce qui suit (mur, plafond,
3985   25A0                                                     ; pose des briques) sonde CET ecran
3986   25A0             
3987   25A0                     ; --- mur a hauteur du corps ? AU PIXEL PRES ------------------------
3988   25A0                     ; ERREUR DE CONCEPTION CORRIGEE : tile_flags_at renvoie le drapeau
3989   25A0                     ; GLOBAL de la tuile (lv_flags), sans jamais regarder QUELLE ligne
3990   25A0                     ; interne est sondee. Pour une tuile partiellement pleine (une
3991   25A0                     ; encoche, un relief fin), marquee "solide" dans son ensemble,
3992   25A0                     ; tile_flags_at repondait TOUJOURS solide -- meme quand la ligne
3993   25A0                     ; precisement sondee fait partie de sa portion VIDE. Le constructeur
3994   25A0                     ; croyait donc buter sur un mur des qu'il approchait un tel relief,
3995   25A0                     ; incapable d'y construire quoi que ce soit.
3996   25A0                     ; pix_solid lit les VRAIS pixels a la ligne demandee, exactement
3997   25A0                     ; comme le fait la marche normale -- meme precision, meme coherence.
3998   25A0 8A C4 C1            lda     @cur_lem
3999   25A3 C0                  mov     A,B
4000   25A4 AA C5 2A            lda     @lem_y(B)
4001   25A7 28 09               add     %LEM_FOOT,A
4002   25A9 8B C4 C5            sta     @r_yline
4003   25AC 8A C6 C8            lda     @new_col
4004   25AF 8B C4 C3            sta     @r_xseg
4005   25B2 8E 23 69            call    @pix_solid
4006   25B5 E2 03               jeq     @lsc_nowall
4007   25B7 8C 27 4A            br      @lsc_stop               ; "rencontre un mur"
4008   25BA             lsc_nowall:
4009   25BA             
4010   25BA                     ; --- ESCALIER EN COIN --------------------------------------------
4011   25BA                     ; SIX briques (BUILD_STEPS), chacune une montee COMPLETE : la
4012   25BA                     ; conception precedente etalait UNE tuile de hauteur sur trois
4013   25BA                     ; marches progressives (3/7/10 px) ; celle-ci grimpe une tuile
4014   25BA                     ; ENTIERE par brique, donc BUILD_STEPS=6 donne desormais un
4015   25BA                     ; escalier de 6 tuiles de haut (60 px), pas 2.
4016   25BA                     ; Nouvelle conception, plus simple que la precedente : le lemming
4017   25BA                     ; foule A (deja au sol, tel quel -- rien ne le redessine, pour ne
4018   25BA                     ; pas risquer de desaligner l'appui sur lequel il se trouve deja)
4019   25BA                     ; puis grimpe DIRECTEMENT sur C. B, une rangee plus bas que C, MEME
4020   25BA                     ; colonne, sert seulement d'appui invisible entre les deux -- le
4021   25BA                     ; lemming ne le foule jamais. Chaque brique fait donc UNE montee
4022   25BA                     ; complete de STAIR_DELTA_C pixels, colonne par colonne -- plus de
4023   25BA                     ; sous-cycle a trois etats a gerer.
4024   25BA                     ; La colonne visee (new_col) reflete DEJA le sens de marche (+1 ou
4025   25BA                     ; -1, calcule plus haut) : cette logique fonctionne donc telle
4026   25BA                     ; quelle dans les deux sens, sans rien coder de specifique.
4027   25BA 8A C4 C1            lda     @cur_lem
4028   25BD C0                  mov     A,B
4029   25BE AA C5 2A            lda     @lem_y(B)
4030   25C1 28 0A               add     %LEM_HLINES,A
4031   25C3 8B C4 C5            sta     @r_yline                ; rangee de son appui ACTUEL (B)
4032   25C6 8A C6 C8            lda     @new_col
4033   25C9 8B C4 C3            sta     @r_xseg
4034   25CC 8E 18 11            call    @rect_rowline
4035   25CF 8A C4 C7            lda     @q_row
4036   25D2 8B C7 E1            sta     @tmp_g                  ; sauvegarde IMMEDIATE, comme avant :
4037   25D5                                                     ; les appels qui suivent (built_add,
4038   25D5                                                     ; bg_erase_if_visible -> ... ->
4039   25D5                                                     ; rect_tileptr -> rect_rowline)
4040   25D5                                                     ; ecrasent q_row pour leur propre
4041   25D5                                                     ; compte.
4042   25D5             
4043   25D5                     ; --- haut de la carte : tmp_g-1 (la rangee visee, une tuile au-
4044   25D5                     ; dessus) DOIT rester >= 0. Sans ce controle, tmp_g=0 donnerait
4045   25D5                     ; tmp_g-1 = 255 en arithmetique non signee sur 8 bits -- une
4046   25D5                     ; rangee totalement hors limites, potentiellement une ecriture
4047   25D5                     ; n'importe ou en memoire. Un escalier construit plusieurs fois de
4048   25D5                     ; suite (en reselectionnant le lemming en ST_WAIT) peut tout a
4049   25D5                     ; fait finir par atteindre le sommet de la carte.
4050   25D5 8A C7 E1            lda     @tmp_g
4051   25D8 E6 03               jne     @lsc_top_ok
4052   25DA 8C 27 4A            br      @lsc_stop               ; haut de la carte : mur
4053   25DD             lsc_top_ok:
4054   25DD             
4055   25DD                     ; --- plafond : la place au-dessus doit etre libre, AU PIXEL PRES --
4056   25DD 8A C4 C1            lda     @cur_lem
4057   25E0 C0                  mov     A,B
4058   25E1 AA C5 2A            lda     @lem_y(B)
4059   25E4 28 09               add     %LEM_FOOT,A
4060   25E6 2A 0A               sub     %TILE_H_LINES,A
4061   25E8 8B C4 C5            sta     @r_yline
4062   25EB 8A C6 C8            lda     @new_col
4063   25EE 8B C4 C3            sta     @r_xseg
4064   25F1 8E 23 69            call    @pix_solid
4065   25F4 E2 03               jeq     @lsc_place
4066   25F6 8C 27 4A            br      @lsc_stop               ; "cogne sa tete contre un plafond"
4067   25F9             
4068   25F9             lsc_place:
4069   25F9                     ; --- premiere brique, ou suite du cycle B+C ? ----------------------
4070   25F9                     ; A n'existe qu'UNE FOIS, au tout debut : le lemming grimpe DEPUIS
4071   25F9                     ; le sol d'origine JUSQU'A A, une rangee au-dessus, a la colonne
4072   25F9                     ; visee. Ensuite seulement commence le cycle repete B (a droite,
4073   25F9                     ; MEME rangee que son appui actuel) puis C (au-dessus de B) --
4074   25F9                     ; inchange depuis les versions precedentes. lem_build vaut encore
4075   25F9                     ; BUILD_STEPS tant qu'aucune brique n'a ete posee : c'est ce qui
4076   25F9                     ; distingue la premiere marche des suivantes, sans variable
4077   25F9                     ; supplementaire a maintenir.
4078   25F9 8A C4 C1            lda     @cur_lem
4079   25FC C0                  mov     A,B
4080   25FD AA C7 9E            lda     @lem_build(B)
4081   2600 2D 03               cmp     %BUILD_STEPS,A
4082   2602 E2 03               jeq     @lsc_firstA
4083   2604 8C 26 59            br      @lsc_repeat
4084   2607             
4085   2607             lsc_firstA:
4086   2607                     ; --- A : premiere marche, une rangee AU-DESSUS du sol de depart,
4087   2607                     ; a la colonne visee (new_col, pas sa colonne actuelle : il avance
4088   2607                     ; ET monte en une seule fois, ici).
4089   2607 8A C7 E1            lda     @tmp_g
4090   260A B2                  dec     A
4091   260B 8B C4 C7            sta     @q_row
4092   260E 8A C6 C8            lda     @new_col
4093   2611 8B C4 CB            sta     @d_col
4094   2614 8A C4 C1            lda     @cur_lem
4095   2617 C0                  mov     A,B
4096   2618 AA C5 70            lda     @lem_dir(B)
4097   261B E6 05               jne     @lsc_ag
4098   261D 22 02               mov     %TILE_MARCHEA,A
4099   261F 8C 26 24            br      @lsc_adone
4100   2622             lsc_ag:
4101   2622 22 03               mov     %TILE_MARCHEAG,A
4102   2624             lsc_adone:
4103   2624 8E 20 E1            call    @built_add
4104   2627             
4105   2627                     ; Pas de comblement systematique sous A (retire a la demande) : le
4106   2627                     ; terrain naturel en dessous est suppose deja porter -- vrai sur un
4107   2627                     ; sol regulier, mais peut laisser un trou au-dessus d'un relief
4108   2627                     ; irregulier (une encoche, par exemple), comme celui rencontre et
4109   2627                     ; corrige pour le cycle B+C avant que B devienne pleine.
4110   2627             
4111   2627                     ; efface la rangee de A (une seule, sans comblement)
4112   2627 22 01               mov     %1,A
4113   2629 8B C4 C4            sta     @r_wseg
4114   262C 22 0A               mov     %TILE_H_LINES,A
4115   262E 8B C4 C6            sta     @r_hlines
4116   2631 8A C6 C8            lda     @new_col
4117   2634 8B C4 C3            sta     @r_xseg
4118   2637 8A C7 E1            lda     @tmp_g
4119   263A B2                  dec     A
4120   263B 2C 0A               mpy     %TILE_H_LINES,A
4121   263D 62                  mov     B,A
4122   263E 8B C4 C5            sta     @r_yline
4123   2641 8E 1F 5E            call    @bg_erase_if_visible
4124   2644             
4125   2644                     ; hauteur : (tmp_g-1)*10 - STAIR_DELTA_A
4126   2644 8A C7 E1            lda     @tmp_g
4127   2647 B2                  dec     A
4128   2648 2C 0A               mpy     %TILE_H_LINES,A
4129   264A 62                  mov     B,A
4130   264B D0 14               mov     A,TEMP4
4131   264D 22 05               mov     %STAIR_DELTA_A,A
4132   264F C0                  mov     A,B
4133   2650 12 14               mov     TEMP4,A
4134   2652 6A                  sub     B,A
4135   2653 8B C4 0D            sta     @tmp_c
4136   2656 8C 26 C9            br      @lsc_move
4137   2659             
4138   2659             lsc_repeat:
4139   2659                     ; --- B : appui plein, MEME rangee que le sol actuel -----------------
4140   2659                     ; Meme raisonnement que pour C : marcheB a son propre decor, dont
4141   2659                     ; le sens visuel doit correspondre au sens de construction.
4142   2659 8A C7 E1            lda     @tmp_g
4143   265C 8B C4 C7            sta     @q_row
4144   265F 8A C6 C8            lda     @new_col
4145   2662 8B C4 CB            sta     @d_col
4146   2665 8A C4 C1            lda     @cur_lem
