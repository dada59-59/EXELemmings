0129+  6E85~            	push B
0130+  6E85~            	mov %25,A
0131+  6E85~            	sta @LINE_NUMBER
0132+  6E85~            	mov %$05,B
0133+  6E85~            	mov %$C8,A
0134+  6E85~            	jmp set_CM
