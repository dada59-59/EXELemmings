4156   2678             
4157   2678                     ; --- C : atterrissage, UNE rangee au-dessus, MEME colonne ----------
4158   2678                     ; La diagonale de marcheC penche visuellement dans un sens : vers
4159   2678                     ; la gauche (lem_dir != 0), il faut son miroir (marcheCG), sinon
4160   2678                     ; l'escalier semblerait pencher a l'envers par rapport au sens
4161   2678                     ; dans lequel le lemming construit. B n'a pas ce probleme : c'est
4162   2678                     ; un bloc plein, symetrique par nature.
4163   2678 8A C7 E1            lda     @tmp_g
4164   267B B2                  dec     A
4165   267C 8B C4 C7            sta     @q_row
4166   267F 8A C6 C8            lda     @new_col
4167   2682 8B C4 CB            sta     @d_col
4168   2685 8A C4 C1            lda     @cur_lem
4169   2688 C0                  mov     A,B
