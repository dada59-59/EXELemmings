1336+  6E85~            	mov A,TEMP2
1337+  6E85~            	lda @YSY
1338+  6E85~            	call @calcul_pointer
1339+  6E85~            	call @set_acmpacmpxy
1340+  6E85~            	lda @FLASH
1341+  6E85~            	mov A,TEMP4
1342+  6E85~            	lda @ATRCAR
1343+  6E85~            	and TEMP4-1,A
1344+  6E85~            	mov A,B
1345+  6E85~            	inv TEMP4-1
1346+  6E85~            _rept1
1347+  6E85~            	lda *TEMP1
1348+  6E85~            	jz _end_string
1349+  6E85~            	cmp %32,A
1350+  6E85~            	jne _printing_car
1351+  6E85~            	clr A
1352+  6E85~            _printing_car
1353+  6E85~            	inc TEMP2
1354+  6E85~            	decd TEMP1
1355+  6E85~            	push A
1356+  6E85~            	lvdp
1357+  6E85~            	and TEMP4-1,A
1358+  6E85~            	or B,A
1359+  6E85~            	wvdp(A)
1360+  6E85~            	pop A
1361+  6E85~            	or TEMP4,A
1362+  6E85~            	wvdp(A)
1363+  6E85~            	lvdp
1364+  6E85~            	lda @WINDOW_W
1365+  6E85~            	cmp TEMP2,A
1366+  6E85~            	jne _rept1
1367+  6E85~            _end_string
1368+  6E85~            	pop B
1369+  6E85~            	pop A
1370+  6E85~            	rets
