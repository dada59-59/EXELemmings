0107+  6E85~            #IFDEF Fset_screen_adr
0108+  6E85~            ; set the start adr for the API management inside the VRAM page area
0109+  6E85~            ; screen adr is >= video_buffer, and is aligned with the begining of a line
0110+  6E85~            ; WARNING !!! the screen adr is never controlled.
0111+  6E85~            ; This function is not very useful and could be replaced by an inline code.
0112+  6E85~            ; IN :B = VRAM adr
0113+  6E85~            ; USED Mem :SCREEN
0114+  6E85~            set_screen_adr
0115+  6E85~            	sta @SCREEN
0116+  6E85~            	xchb A
0117+  6E85~            	sta @SCREEN+1
0118+  6E85~            	xchb A
0119+  6E85~            	rets
0120+  6E85             #ENDIF
