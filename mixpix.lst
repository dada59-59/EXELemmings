5070   2CCC             
5071   2CCC             lw_turn:
5072   2CCC                     ; Demi-tour : il change de sens et ne bouge pas ce pas-ci. Au fond
5073   2CCC                     ; d'un puits d'une tuile, il fera donc l'aller-retour indefiniment
5074   2CCC                     ; -- c'est bien le comportement du jeu d'origine, un lemming piege
5075   2CCC                     ; attend qu'on lui donne une competence.
5076   2CCC 8A C4 C1            lda     @cur_lem
5077   2CCF C0                  mov     A,B
