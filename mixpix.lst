1325+  6E85~            ; IN :TEMP1 = string adr (terminated by a NULL value)
1326+  6E85~            ;			TEMP4-1 = masked of the current attribute
1327+  6E85~            ; USED Registers :TEMP1-1,TEMP1,TEMP2-1,TEMP2,TEMP4-1,TEMP4
1328+  6E85~            ; USED Mem :WINDOW_H,WINDOW_W,XSX,YSY,ATRCAR,FLASH
