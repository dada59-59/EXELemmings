1165   1277 E2 03               jeq     @mspc_go
1166   1279 8C 12 CF            br      @ml_next
1167   127C             mspc_go:
1168   127C 8A C7 FE            lda     @level_over             ; niveau fini : Espace -> niveau
1169   127F E2 03               jeq     @mspc_use               ; suivant (GAGNE) ou le meme (PERDU)
1170   1281 8C 36 5A            br      @level_next
1171   1284             mspc_use:
