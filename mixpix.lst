1911+  6E85~            #IFDEF Fget_image
1912+  6E85~            #DEFINE Fset_acmpxy
1913+  6E85~            #DEFINE Fcalcul_pointer
1914+  6E85~            #DEFINE Ftest_draw
1915+  6E85~            ; save a rectangular area of the active window in a user buffer
1916+  6E85~            ; The cursor position is not modified.
1917+  6E85~            ; drawing attributes and characters are saved, data are saved downward.
1918+  6E85~            ; The size of reserved memory for the buffer is twice wifth*heigth of the area + 2:
1919+  6E85~            ; the both first data of the buffer are the width and heigth of the saved area or 0,0 if coordinates are incorrect !
1920+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
1921+  6E85~            ;			TEMP4 = buffer adr (enough memory has to be reserved)
1922+  6E85~            ; USED Registers :TEMP2-1,TEMP3-1,TEMP3,TEMP4,TEMP4-1
1923+  6E85~            ; USED Mem :XSX,YSY
1924+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmpxy,test_draw
1925+  6E85~            	.module get_image
1926+  6E85~            get_image
1927+  6E85~            	push A
1928+  6E85~            	push B
1929+  6E85~            	call @test_draw
1930+  6E85~            	jnc do_get
1931+  6E85~            	clr A
1932+  6E85~            	sta *TEMP4
1933+  6E85~            	decd TEMP4
1934+  6E85~            	sta *TEMP4
1935+  6E85~            	jmp _fin
1936+  6E85~            do_get
1937+  6E85~            	mov TEMP2-1,A
1938+  6E85~            	sta *TEMP4
1939+  6E85~            	decd TEMP4
1940+  6E85~            	mov TEMP2,A
1941+  6E85~            	sta *TEMP4
1942+  6E85~            	rl TEMP2
1943+  6E85~            	movd TEMP1,R1
1944+  6E85~            	call @calcul_pointer
1945+  6E85~            _rept1
1946+  6E85~            	movd TEMP3,R1
1947+  6E85~            	call @set_acmpxy
1948+  6E85~            	mov TEMP2,B
1949+  6E85~            _rept2
1950+  6E85~            	lvdp
1951+  6E85~            	decd TEMP4
1952+  6E85~            	sta *TEMP4
1953+  6E85~            	djnz B,_rept2
1954+  6E85~            	add %LENGTHLINE,TEMP3
1955+  6E85~            	adc %0,TEMP3-1
1956+  6E85~            	djnz TEMP2-1,_rept1
1957+  6E85~            _fin	
1958+  6E85~            	pop B
1959+  6E85~            	pop A
1960+  6E85~            	rets
1961+  6E85             #ENDIF
1962+  6E85             
1963+  6E85~            #IFDEF Fput_image
1964+  6E85~            #DEFINE Fset_acmpxy
1965+  6E85~            #DEFINE Fcalcul_pointer
1966+  6E85~            ; put a rectangular area from a buffer to the active window
1967+  6E85~            ; The cursor position is not modified.
1968+  6E85~            ; the buffer is created with - or formatted as - the get_image function.
1969+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X
1970+  6E85~            ;			TEMP4 = buffer adr
1971+  6E85~            ; USED Registers :TEMP1-1,TEMP1,TEMP2-1,TEMP3-1,TEMP3,TEMP4,TEMP4-1,TEMP5-1,TEMP5
1972+  6E85~            ; USED Mem :WINDOW_H,WINDOW_W,XSX,YSY
1973+  6E85~            ; DEPENDENCIES :calcul_pointer,set_acmpxy,test_draw
1974+  6E85~            	.module put_image	
1975+  6E85~            put_image
1976+  6E85~            	push A
1977+  6E85~            	push B
1978+  6E85~            	lda *TEMP4
1979+  6E85~            	decd TEMP4
1980+  6E85~            	mov A,TEMP2-1
1981+  6E85~            	mov A,B
1982+  6E85~            	lda *TEMP4
1983+  6E85~            	mov A,TEMP2
1984+  6E85~            	or R0,B
1985+  6E85~            	jz _fin
1986+  6E85~            	lda @WINDOW_W
1987+  6E85~            	mov A,TEMP5-1
1988+  6E85~            	movd TEMP1,R1
1989+  6E85~            	mov B,TEMP5
1990+  6E85~            	call @calcul_pointer
1991+  6E85~            _rept1
1992+  6E85~            	mov TEMP1-1,A
1993+  6E85~            	cmpa @WINDOW_H
1994+  6E85~            	jeq _fin
1995+  6E85~            	inc TEMP1-1
1996+  6E85~            	movd TEMP3,R1
1997+  6E85~            	call @set_acmpxy
1998+  6E85~            	mov TEMP2,B
1999+  6E85~            	mov TEMP5,TEMP1
2000+  6E85~            _rept2
2001+  6E85~            	decd TEMP4
2002+  6E85~            	lda *TEMP4
2003+  6E85~            	cmp TEMP5-1,TEMP1
2004+  6E85~            	jhs _next1
2005+  6E85~            	wvdp(A)
2006+  6E85~            _next1
2007+  6E85~            	decd TEMP4
2008+  6E85~            	lda *TEMP4
2009+  6E85~            	cmp TEMP5-1,TEMP1
2010+  6E85~            	jhs _next2
2011+  6E85~            	wvdp(A)
2012+  6E85~            _next2
2013+  6E85~            	inc TEMP1	
2014+  6E85~            	djnz B,_rept2
2015+  6E85~            	add %LENGTHLINE,TEMP3
2016+  6E85~            	adc %0,TEMP3-1
2017+  6E85~            	djnz TEMP2-1,_rept1
2018+  6E85~            _fin	
2019+  6E85~            	pop B
2020+  6E85~            	pop A
2021+  6E85~            	rets
2022+  6E85             #ENDIF
2023+  6E85             
2024+  6E85~            #IFDEF Fget_key
2025+  6E85~            #DEFINE Fwait_relkey
2026+  6E85~            ; Waiting for R0ny key press
2027+  6E85~            ; SHIFT and CRTL is never returned but manages for upper/lower/special keys
2028+  6E85~            ; OUT :A = key value
2029+  6E85~            get_key
2030+  6E85~            wait_press_key	
2031+  6E85~            	mov VALUE0,A
2032+  6E85~            	cmp %$86,A
2033+  6E85~            	jeq wait_press_key
2034+  6E85~            	cmp %$89,A
2035+  6E85~            	jeq wait_press_key
2036+  6E85~            	cmp %$04,A
2037+  6E85~            	jeq wait_press_key
2038+  6E85~            	jmp wait_relkey
2039+  6E85             #ENDIF
2040+  6E85             
2041+  6E85~            #IFDEF Fget_akey
2042+  6E85~            #DEFINE Fwait_relkey
2043+  6E85~            ; Waiting for R0 specific key
2044+  6E85~            ; SHIFT and CRTL could be returned as any other key
2045+  6E85~            ; IN :B = key value
2046+  6E85~            		.module get_akey
2047+  6E85~            get_akey
2048+  6E85~            _wait_press_key	
2049+  6E85~            	mov VALUE0,A
2050+  6E85~            	cmp %$04,A
2051+  6E85~            	jeq _wait_press_key
2052+  6E85~            	cmp B,A
2053+  6E85~            	jne _wait_press_key	
2054+  6E85             #ENDIF
2055+  6E85~            #IFDEF Fwait_relkey
2056+  6E85~            wait_relkey
2057+  6E85~            	cmp %$04,VALUE0
2058+  6E85~            	jne wait_relkey
2059+  6E85~            	rets
2060+  6E85             #ENDIF	
2061+  6E85             
2062+  6E85~            #IFDEF Fkey
2063+  6E85~            ; Return the key value
2064+  6E85~            ; SHIFT and CRTL could be returned as any other key
2065+  6E85~            ; OUT :A = key value
2066+  6E85~            ;			 C bit of ST register = 1 (value), =0 (no value or error)
2067+  6E85~            	.module key
2068+  6E85~            key
2069+  6E85~            	mov VALUE0,A
2070+  6E85~            	jz _fin
2071+  6E85~            	cmp %$04,A
2072+  6E85~            	jeq _fin
2073+  6E85~            	setc
2074+  6E85~            	rets
2075+  6E85~            _fin
2076+  6E85~            	clrc
2077+  6E85~            	rets
2078+  6E85             #ENDIF
2079+  6E85             	
2080+  6E85~            #IFDEF Fset_acmpxy
2081+  6E85~            ; Set the ACMPXY VDP pointer
2082+  6E85~            ; IN :B = ACMPXY pointer value
2083+  6E85~            set_acmpxy
2084+  6E85~            	MOVP   %$01,P45
2085+  6E85~            	MOVP   B,P45
2086+  6E85~            	MOVP   %$02,P45
2087+  6E85~            	MOVP   A,P45
2088+  6E85~            	RETS   	
2089+  6E85             #ENDIF
2090+  6E85             
2091+  6E85~            #IFDEF Fset_acmp
2092+  6E85~            ; Set the ACMP VDP pointer
2093+  6E85~            ; WARNING !!! Registers A & B are modified by this function (decrement by one).
2094+  6E85~            ; IN :B = ACMPXY pointer value
2095+  6E85~            set_acmp
2096+  6E85~            	DECD   B
2097+  6E85~            	MOVP   %$01,P45
2098+  6E85~            	MOVP   B,P45
2099+  6E85~            	MOVP   %$02,P45
2100+  6E85~            	MOVP   A,P45
2101+  6E85~            	MOVP   %$09,P45
2102+  6E85~            	MOVP   %$09,P45
2103+  6E85~            	RETS
2104+  6E85             #ENDIF
2105+  6E85             
2106+  6E85~            #IFDEF Fset_acmpacmpxy
2107+  6E85~            ; Set the ACMPXY and ACMP VDP pointers with the same adr
2108+  6E85~            ; WARNING !!! Registers A & B are modified by this function (decrement by one).
2109+  6E85~            ; IN :B = adr value
2110+  6E85~            set_acmpacmpxy
2111+  6E85~            	DECD   B
2112+  6E85~            	MOVP   %$01,P45
2113+  6E85~            	MOVP   B,P45
2114+  6E85~            	MOVP   %$02,P45
2115+  6E85~            	MOVP   A,P45
2116+  6E85~            	MOVP   %$09,P45
2117+  6E85~            	MOVP   %$09,P45
2118+  6E85~            	inc B
2119+  6E85~            	adc %0,A
2120+  6E85~            	MOVP   %$01,P45
2121+  6E85~            	MOVP   B,P45
2122+  6E85~            	MOVP   %$02,P45
2123+  6E85~            	MOVP   A,P45
2124+  6E85~            	RETS   	
2125+  6E85             #ENDIF
2126+  6E85             
2127+  6E85~            #IFDEF Freload_acmp
2128+  6E85~            ; Set the ACMP with its previous loaded value (il loaded)
2129+  6E85~            reload_acmp
2130+  6E85~            	movp %$09,P45
2131+  6E85~            	movp %$09,P45	
2132+  6E85~            	rets
2133+  6E85             #ENDIF
2134+  6E85             
2135+  6E85~            #IFDEF Fset_xy
2136+  6E85~            ; Reserved function, do not use directly
2137+  6E85~            ; (fixed the cursor position and process the related VRAM adr)
2138+  6E85~            ; IN: A = Y, B = X
2139+  6E85~            ; OUT : VRAM adr of (Y,X)
2140+  6E85~            set_xy
2141+  6E85~            	sta @YSY
2142+  6E85~            	xchb A
2143+  6E85~            	sta @XSX
2144+  6E85~            	xchb A
2145+  6E85~            	call @calcul_pointer
2146+  6E85~            	rets
2147+  6E85             #ENDIF
2148+  6E85             
2149+  6E85~            #IFDEF Ftest_draw
2150+  6E85~            ; Test coordinates of a rectangle object wrt. the active window
2151+  6E85~            ; IN :TEMP-1 = Y, TEMP1 = X, TEMP2-1 = heigth, TEMP2 = width
2152+  6E85~            ; OUT : C bit of ST register = 1 => bad coordinates (=0 => ok)
2153+  6E85~            ; USED Registers :A,B,TEMP1-1,TEMP1,TEMP2-1,TEMP2
