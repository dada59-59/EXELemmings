6471   35D6             ; ============================================================================
6472   35D6             ; draw_text_line -- ecrit une chaine sur une ligne TEXTE de notre page
6473   35D6             ; mixte. put_char (mixt_api) ne peut pas servir : il ecrit dans la page de
6474   35D6             ; mixt_api, pas dans la notre. On ecrit donc directement les deux octets
6475   35D6             ; par caractere (attribut, code), 40 par ligne.
6476   35D6             ; Entrees : A:B = adresse VRAM du debut de ligne, TEMP3-1:TEMP3 = chaine
6477   35D6             ; terminee par $00.
6478   35D6             ; ============================================================================
6479   35D6             draw_text_line:
6480   35D6 8E 14 ED            call    @setAcmpxy
6481   35D9 72 28 16            mov     %40,TEMP5               ; la ligne fait toujours 40 cellules
6482   35DC             dtl_char:
6483   35DC 9A 12               lda     *TEMP3
6484   35DE E2 1B               jeq     @dtl_pad                ; fin de chaine : complete d'espaces
6485   35E0 2D 20               cmp     %$20,A                  ; espace -> glyphe vide dedie (le
6486   35E2 E6 02               jne     @dtl_notsp              ; code $20 peut s'afficher comme un
6487   35E4 22 60               mov     %CH_BLANK,A             ; pave sur machine reelle)
6488   35E6             dtl_notsp:
6489   35E6 8B C4 00            sta     @tmp_a
6490   35E9 A2 F8 2E            movp    %TEXT_ATTR,P46
6491   35EC 8A C4 00            lda     @tmp_a
6492   35EF 82 2E               movp    A,P46
6493   35F1 D3 12               inc     TEMP3
6494   35F3 E6 02               jne     @dtl_next
6495   35F5 D3 11               inc     TEMP3-1
6496   35F7             dtl_next:
6497   35F7 DA 16 E2            djnz    TEMP5,@dtl_char
6498   35FA 0A                  rets
6499   35FB             dtl_pad:
6500   35FB A2 F8 2E            movp    %TEXT_ATTR,P46
6501   35FE A2 60 2E            movp    %CH_BLANK,P46           ; espace (glyphe vide dedie)
6502   3601 DA 16 F7            djnz    TEMP5,@dtl_pad
6503   3604 0A                  rets
6504   3605             
6505   3605             ; --- decalages de depart des rythmes de marche.
6506   3605             ; ERREUR CORRIGEE : une premiere table (i*16/10 arrondis) ignorait que le
6507   3605             ; moment de NAISSANCE lui-meme (tous les SPAWN_TICKS=200 ticks) apporte
6508   3605             ; DEJA une phase -- 200 mod 16 = 8, donc les lemmings pairs et impairs
6509   3605             ; partent avec 8 ticks d'ecart avant meme d'ajouter cette table. Combinee
6510   3605             ; a l'ancienne table, la phase REELLE en regime permanent ne prenait que
6511   3605             ; CINQ valeurs distinctes (partagees par deux lemmings chacune), pas dix.
6512   3605             ; Cette table est choisie pour ANNULER la phase de naissance et repartir
6513   3605             ; les dix lemmings sur les dix phases 0..9, une par tick.
6514   3605             lem_tick_init:
6515   3605 00 07 0E 05         .byte   0,7,14,5,12,3,10,1,8,15
6515   3609 0C 03 0A 01 
6515   360D 08 0F 
6516   360F             
6517   360F             ; --- ecrit le compte de lemmings sauves, en 2 chiffres, DIRECTEMENT a
6518   360F             ; l'adresse VRAM voulue -- pas via draw_text_line (qui ne sait lire qu'une
6519   360F             ; chaine en ROM/RAM, jamais convertir un nombre). saved_count vaut au plus
6520   360F             ; NUM_LEM(10), donc au plus 2 chiffres ; le calcul dizaine/unite reste
6521   360F             ; volontairement simple (une seule comparaison) plutot qu'une division
6522   360F             ; generale, qui serait inutile ici.
6523   360F             ; Position : juste apres "SAUVES:" dans txt_top2 -- chaque case ecran
6524   360F             ; occupe 2 octets (attribut, caractere), d'ou le decalage de 36*2=72.
6525   360F             TXT_SAUVES_POS  .equ    $069A           ; TXT_TOP2 + 36 caracteres*2 octets
6526   360F             TXT_TOP_HI      .equ    $06             ; poids fort commun aux deux lignes
6527   360F                                                     ; du haut ($0600..$06A3)
6528   360F             TXT_SORTIS_POS  .equ    $060E           ; ligne 1 (SCREEN_BASE $0600), col 7
6529   360F             TXT_TOTAL_POS   .equ    $0614           ; col 10
6530   360F             TXT_ASAUVER_POS .equ    $062E           ; col 23
6531   360F             TXT_FIN_POS     .equ    $0634           ; col 26 : GAGNE! / PERDU!
6532   360F             TXT_NIV_POS     .equ    $0660           ; ligne 2 (TXT_TOP2 $0652), col 7
6533   360F             ; --- charge le niveau cur_level : son theme (adresses des tuiles et de leurs
6534   360F             ; proprietes) et ses parametres, depuis les tables de leveldata.asm (une
6535   360F             ; entree par niveau ou par theme, generees par EXELTILE).
6536   360F             level_load:
6537   360F 8A C7 AA            lda     @cur_level
6538   3612 C0                  mov     A,B
6539   3613 AA 3B AF            lda     @lv_lvl_nscr(B)
6540   3616 8B C7 B0            sta     @cur_nscr
6541   3619 AA 3B B3            lda     @lv_lvl_lem_count(B)
6542   361C 8B C7 B1            sta     @cur_lem_count
6543   361F AA 3B B4            lda     @lv_lvl_to_save(B)
6544   3622 8B C7 B2            sta     @cur_to_save
6545   3625 AA 3B B0            lda     @lv_lvl_spawn_scr(B)
6546   3628 8B C7 B3            sta     @cur_spawn_scr
6547   362B AA 3B B1            lda     @lv_lvl_spawn_col(B)
6548   362E 8B C7 D4            sta     @cur_spawn_col
6549   3631 AA 3B B2            lda     @lv_lvl_spawn_y(B)
6550   3634 8B C7 D5            sta     @cur_spawn_y
6551   3637 62                  mov     B,A                     ; premier ecran dans lv_map_hi/lo :
6552   3638 68                  add     B,A                     ; 3 par niveau
6553   3639 68                  add     B,A
6554   363A 8B C7 AF            sta     @cur_map_base
6555   363D AA 3B AE            lda     @lv_lvl_theme(B)        ; son jeu de tuiles
6556   3640 C0                  mov     A,B
6557   3641 AA 5C 88            lda     @lv_thm_tiles_lo(B)
6558   3644 8B C7 AB            sta     @tiles_lo
6559   3647 AA 5C 89            lda     @lv_thm_tiles_hi(B)
6560   364A 8B C7 AC            sta     @tiles_hi
6561   364D AA 5C 8A            lda     @lv_thm_flags_lo(B)
6562   3650 8B C7 AD            sta     @flags_lo
6563   3653 AA 5C 8B            lda     @lv_thm_flags_hi(B)
6564   3656 8B C7 AE            sta     @flags_hi
6565   3659 0A                  rets
6566   365A             
6567   365A             ; --- fin de niveau, Espace ou bouton 1 : niveau suivant si GAGNE (retour au
6568   365A             ; premier apres le dernier), le meme si PERDU. On y arrive par BR depuis
6569   365A             ; une routine appelee : level_start repositionne la pile.
6570   365A             level_next:
6571   365A 8A C7 D6            lda     @level_won
6572   365D E2 0C               jeq     @lnx_go
6573   365F 8A C7 AA            lda     @cur_level
6574   3662 B3                  inc     A
6575   3663 2D 01               cmp     %LV_NLEVELS,A
6576   3665 E7 01               jnc     @lnx_set                ; jnc : il reste des niveaux
6577   3667 B5                  clr     A                       ; apres le dernier : le premier
6578   3668             lnx_set:
6579   3668 8B C7 AA            sta     @cur_level
6580   366B             lnx_go:
6581   366B 8C 10 0B            br      @level_start
6582   366E             
6583   366E             draw_saved_count:
6584   366E 8A C7 E2            lda     @saved_count
6585   3671 52 9A               mov     %TXT_SAUVES_POS&$FF,B
6586   3673 8E 36 77            call    @put_2dig               ; jusqu'a 99 (avant : 19 au plus)
6587   3676 0A                  rets
6588   3677             
6589   3677             ; --- ecrit A (0..99) en deux chiffres dans la ligne texte du HAUT, a
6590   3677             ; l'adresse $06:B (les deux lignes du haut sont toutes en $06xx : voir
6591   3677             ; TXT_TOP2 et les positions TXT_*_POS). Utilise TEMP6.
6592   3677             put_2dig:
6593   3677 D0 18               mov     A,TEMP6
6594   3679 22 06               mov     %TXT_TOP_HI,A
6595   367B 8E 14 ED            call    @setAcmpxy              ; A = poids fort, B = poids faible
6596   367E 12 18               mov     TEMP6,A
6597   3680 C5                  clr     B
6598   3681             p2d_div:
6599   3681 2D 0A               cmp     %10,A
6600   3683 E7 06               jnc     @p2d_ok                 ; jnc : A < 10
6601   3685 2A 0A               sub     %10,A
6602   3687 C3                  inc     B
6603   3688 8C 36 81            br      @p2d_div
6604   368B             p2d_ok:
6605   368B D0 18               mov     A,TEMP6                 ; unites
6606   368D A2 F8 2E            movp    %TEXT_ATTR,P46
6607   3690 62                  mov     B,A
6608   3691 28 30               add     %$30,A
6609   3693 82 2E               movp    A,P46
6610   3695 A2 F8 2E            movp    %TEXT_ATTR,P46
6611   3698 12 18               mov     TEMP6,A
6612   369A 28 30               add     %$30,A
6613   369C 82 2E               movp    A,P46
6614   369E 0A                  rets
6615   369F             
6616   369F             ; --- ligne 1 : "SORTIS:nn/tt  A SAUVER:ss" (texte fixe dans txt_top1,
6617   369F             ; chiffres ecrits ici)
6618   369F             draw_level_info:
6619   369F 8A C7 FD            lda     @spawn_count
6620   36A2 52 0E               mov     %TXT_SORTIS_POS&$FF,B
6621   36A4 8E 36 77            call    @put_2dig
6622   36A7 8A C7 B1            lda     @cur_lem_count
6623   36AA 52 14               mov     %TXT_TOTAL_POS&$FF,B
6624   36AC 8E 36 77            call    @put_2dig
6625   36AF 8A C7 B2            lda     @cur_to_save
6626   36B2 52 2E               mov     %TXT_ASAUVER_POS&$FF,B
6627   36B4 8E 36 77            call    @put_2dig
6628   36B7 8A C7 AA            lda     @cur_level              ; numero de niveau, a partir de 1
6629   36BA B3                  inc     A
6630   36BB 52 60               mov     %TXT_NIV_POS&$FF,B
6631   36BD 8E 36 77            call    @put_2dig
6632   36C0 0A                  rets
6633   36C1             
6634   36C1             ; --- fin de niveau : quand tous les lemmings sont sortis et qu'aucun n'est
6635   36C1             ; plus en jeu (sauves ou morts), compare les sauves au nombre demande et
6636   36C1             ; l'affiche, une seule fois. Un bloqueur reste en jeu indefiniment : il
6637   36C1             ; faut le faire exploser (E) pour terminer, comme dans l'original.
6638   36C1             level_check:
6639   36C1 8A C7 FE            lda     @level_over
6640   36C4 E2 01               jeq     @lc_go
6641   36C6 0A                  rets                            ; deja termine
6642   36C7             lc_go:
6643   36C7 8A C7 FD            lda     @spawn_count
6644   36CA 8D C7 B1            cmpa    @cur_lem_count
6645   36CD E2 01               jeq     @lc_all
6646   36CF 0A                  rets                            ; il en reste a faire sortir
6647   36D0             lc_all:
6648   36D0 52 0A               mov     %NUM_LEM,B
6649   36D2             lc_look:
6650   36D2 AA C5 51            lda     @lem_alive-1(B)
6651   36D5 E2 01               jeq     @lc_next
6652   36D7 0A                  rets                            ; encore un lemming en jeu
6653   36D8             lc_next:
6654   36D8 CA F8               djnz    B,@lc_look
6655   36DA 22 01               mov     %1,A
6656   36DC 8B C7 FE            sta     @level_over
6657   36DF 8A C7 E2            lda     @saved_count
6658   36E2 8D C7 B2            cmpa    @cur_to_save
6659   36E5 E7 0C               jnc     @lc_lost                ; jnc : sauves < a sauver
6660   36E7 22 01               mov     %1,A
6661   36E9 8B C7 D6            sta     @level_won              ; Espace : niveau suivant
6662   36EC 88 39 DF 12         movd    %txt_win,TEMP3
6663   36F0 8C 36 F7            br      @lc_msg
6664   36F3             lc_lost:
6665   36F3 88 39 ED 12         movd    %txt_lose,TEMP3
6666   36F7             lc_msg:
6667   36F7 22 06               mov     %TXT_TOP_HI,A
6668   36F9 52 34               mov     %TXT_FIN_POS&$FF,B
6669   36FB 8E 36 FF            call    @draw_text_part
6670   36FE 0A                  rets
6671   36FF             
6672   36FF             ; --- ecrit une chaine (terminee par 0) a partir de A:B, SANS completer la
6673   36FF             ; ligne (contrairement a draw_text_line). Espace -> glyphe vide CH_BLANK.
6674   36FF             draw_text_part:
6675   36FF 8E 14 ED            call    @setAcmpxy
6676   3702             dtp_char:
6677   3702 9A 12               lda     *TEMP3
6678   3704 E2 14               jeq     @dtp_end
6679   3706 2D 20               cmp     %$20,A
6680   3708 E6 02               jne     @dtp_ns
6681   370A 22 60               mov     %CH_BLANK,A
6682   370C             dtp_ns:
6683   370C A2 F8 2E            movp    %TEXT_ATTR,P46
6684   370F 82 2E               movp    A,P46
6685   3711 D3 12               inc     TEMP3
6686   3713 E6 ED               jne     @dtp_char
6687   3715 D3 11               inc     TEMP3-1
6688   3717 8C 37 02            br      @dtp_char
6689   371A             dtp_end:
6690   371A 0A                  rets
6691   371B             
6692   371B             draw_texts:
6693   371B                     ; ORDRE CORRIGE : movd ecrase A et B (il charge une paire de
6694   371B                     ; registres et remet la retenue a zero). Charger la chaine APRES
6695   371B                     ; avoir pose A:B pour setAcmpxy detruisait donc l'adresse de la
6696   371B                     ; ligne -- le texte partait n'importe ou, d'ou les artefacts vus
6697   371B                     ; a l'ecran. On charge desormais la chaine D'ABORD.
6698   371B 88 39 C5 12         movd    %txt_top1,TEMP3
6699   371F 22 06               mov     %SCREEN_BASE>>8,A
6700   3721 52 00               mov     %SCREEN_BASE&$FF,B
6701   3723 8E 35 D6            call    @draw_text_line
6702   3726             
6703   3726 88 39 FB 12         movd    %txt_top2,TEMP3
6704   372A 22 06               mov     %TXT_TOP2>>8,A
6705   372C 52 52               mov     %TXT_TOP2&$FF,B
6706   372E 8E 35 D6            call    @draw_text_line
6707   3731             
6708   3731 8E 35 AA            call    @panel_draw_all         ; panneau des pouvoirs (3 lignes)
6709   3734 8E 36 6E            call    @draw_saved_count       ; "00" au demarrage
6710   3737 8E 36 9F            call    @draw_level_info        ; SORTIS / total / A SAUVER
6711   373A 0A                  rets
6712   373B             
6713   373B             ; Adresses des lignes texte, precalculees en dur (convention du projet :
6714   373B             ; jamais d'expression a plus d'un operateur dans le source) :
6715   373B             ;   haut 0 = SCREEN_BASE            = $0600
6716   373B             ;   haut 1 = SCREEN_BASE + 82       = $0652
6717   373B             ;   bas 0  = GRAPH_BASE + 200*122   = $06A4 + 24400 = $65F4
6718   373B             ;   bas 1  = ... + 82               = $6646
6719   373B             ;   bas 2  = ... + 164              = $6698
6720   373B             ; (une premiere version donnait $6654/$66A6/$66F8 : 96 octets trop loin,
6721   373B             ;  les trois lignes du bas seraient tombees hors de la page.)
6722   373B             TXT_TOP2        .equ    $0652
6723   373B             TXT_BOT1        .equ    $65F4
6724   373B             TXT_BOT2        .equ    $6646
6725   373B             TXT_BOT3        .equ    $6698
