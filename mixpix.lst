0537+  6E85~            #IFDEF Fset_window
0538+  6E85~            #DEFINE Fcls
0539+  6E85~            ; initialise the active windows
0540+  6E85~            ; Warning !!! coordinate and size parameters are not controled.
0541+  6E85~            ; The window is cleared by the function.
0542+  6E85~            ; IN :A = default character attribute
0543+  6E85~            ;			TEMP1-1 = Y coordinate (0-23/24), TEMP1 = X coordinate (0-39)
0544+  6E85~            ;			TEMP2-1 = heigth (1-24/25), TEMP2 = width (1-40)
0545+  6E85~            ; USED Mem :WINDOW_X,WINDOW_Y,WINDOW_H,WINDOW_W,ATRCAR
0546+  6E85~            ; DEPENDENCIES : cls
0547+  6E85~            set_window
0548+  6E85~            	push A
0549+  6E85~            	sta @ATRCAR
0550+  6E85~            	clr A
0551+  6E85~            	sta @FLASH
0552+  6E85~            	mov TEMP1-1,A
0553+  6E85~            	sta @WINDOW_Y
0554+  6E85~            	mov TEMP1,A
0555+  6E85~            	sta @WINDOW_X
0556+  6E85~            	mov TEMP2-1,A
0557+  6E85~            	sta @WINDOW_H
0558+  6E85~            	mov TEMP2,A
0559+  6E85~            	sta @WINDOW_W
0560+  6E85~            	call @cls
0561+  6E85~            	pop A
0562+  6E85~            	rets
0563+  6E85             #ENDIF
0564+  6E85             
0565+  6E85~            #IFDEF Fset_activew
0566+  6E85~            ; set the active window
0567+  6E85~            ; At least one active window must be defined to access this API.
0568+  6E85~            ; If a window previously active is reactivated, its context is restored.
0569+  6E85~            ; (context of current window if saved and restored each time this function is called)
0570+  6E85~            ; IN :TEMP1 = adr of the window data structure (each windowd needs its own data structure of 8 bytes)
0571+  6E85~            ; USED Registers :TEMP1-1,TEMP1,TEMP2-1,TEMP2
0572+  6E85~            ; USED Mem :ACTIVE_WD,XSX,YSY
0573+  6E85~            ; DEPENDENCIES :locate
0574+  6E85~            	.MODULE set_activew
0575+  6E85~            set_activew
0576+  6E85~            	push A
0577+  6E85~            	push B
0578+  6E85~            	lda @ACTIVE_WD+1
0579+  6E85~            	mov A,B
0580+  6E85~            	lda @ACTIVE_WD
0581+  6E85~            	jne save_window
0582+  6E85~            	or R1,B
0583+  6E85~            	jne save_window
0584+  6E85~            _load_window
0585+  6E85~            	movd TEMP1,R1
0586+  6E85~            	sta @ACTIVE_WD
0587+  6E85~            	mov B,A
0588+  6E85~            	sta @ACTIVE_WD+1
0589+  6E85~            	mov %8,B
0590+  6E85~            _rept1
0591+  6E85~            		lda *TEMP1
0592+  6E85~            		sta @XSX-1(B)
0593+  6E85~            		decd TEMP1
0594+  6E85~            		djnz B,_rept1
0595+  6E85~            	pop B
0596+  6E85~            	pop A
0597+  6E85~            	rets
0598+  6E85~            save_window
0599+  6E85~            	movd R1,TEMP2
0600+  6E85~            	mov %8,B
0601+  6E85~            _rept2
0602+  6E85~            		lda @XSX-1(B)
0603+  6E85~            		sta *TEMP2
0604+  6E85~            		decd TEMP2
0605+  6E85~            		djnz B,_rept2	
0606+  6E85~            	jmp _load_window
0607+  6E85             #ENDIF
0608+  6E85             	
0609+  6E85~            #IFDEF Fbox
0610+  6E85~            #DEFINE Ftest_draw
0611+  6E85~            #DEFINE Fset_acmpxy
0612+  6E85~            #DEFINE Fcalcul_pointer
0613+  6E85~            ; draw a box (only the frame not a fill box) on the active window
0614+  6E85~            ; Current drawing attribute are used.
0615+  6E85~            ; Frame symbols could be customized (cf. box_pattern data)
0616+  6E85~            ; if box is outside window area, box is not drawing.
0617+  6E85~            ; The cursor position is not modified.
0618+  6E85~            ; IN :TEMP1-1 = Y coordinate, TEMP1= X coordinate
0619+  6E85~            ;			TEMP2-2 = heigth, TEMP2= width
0620+  6E85~            ; USED Registers :TEMP1-1,TEMP1,TEMP2-1,TEMP2,TEMP3-1,TEMP3,TEMP4-1,TEMP4,TEMP5
0621+  6E85~            ; USED Mem :ATRCAR,box_pattern,XSX,YSY
0622+  6E85~            ; DEPENDENCIES : calcul_pointer,test_draw,set_acmpxy,locate
0623+  6E85~            	.MODULE mod_box
0624+  6E85~            box
0625+  6E85~            	push A
0626+  6E85~            	push B
0627+  6E85~            	call @test_draw
0628+  6E85~            	jnc _drawbox
0629+  6E85~            	pop B
0630+  6E85~            	pop A
0631+  6E85~            	rets
0632+  6E85~            _drawbox
0633+  6E85~            	sub %2,TEMP2
0634+  6E85~            	sub %2,TEMP2-1
0635+  6E85~            	lda @ATRCAR
0636+  6E85~            	mov A,TEMP5
0637+  6E85~            	movd TEMP1,R1
0638+  6E85~            	mov TEMP2,TEMP1
0639+  6E85~            	call @calcul_pointer
0640+  6E85~            	movd R1,TEMP4
0641+  6E85~            	inc TEMP1
0642+  6E85~            	rl TEMP1
0643+  6E85~            	add TEMP1,TEMP4
0644+  6E85~            	adc %0,TEMP4-1
0645+  6E85~            	call @set_acmpxy
0646+  6E85~            	mov TEMP5,B
0647+  6E85~            	wvdp(B)
0648+  6E85~            	lda @box_pattern
0649+  6E85~            	wvdp(A)
0650+  6E85~            	mov TEMP2,TEMP1
0651+  6E85~            _rept1
0652+  6E85~            		wvdp(B)
0653+  6E85~            		lda @box_pattern+4		
0654+  6E85~            		wvdp(A)
0655+  6E85~            		djnz TEMP1,_rept1
0656+  6E85~            	wvdp(B)
0657+  6E85~            	lda @box_pattern+1
0658+  6E85~            	wvdp(A)
0659+  6E85~            _rept2
0660+  6E85~            		add %LENGTHLINE,TEMP3
0661+  6E85~            		adc %0,TEMP3-1
0662+  6E85~            		add %LENGTHLINE,TEMP4
0663+  6E85~            		adc %0,TEMP4-1
0664+  6E85~            		movd TEMP3,R1
0665+  6E85~            		call @set_acmpxy
0666+  6E85~            		mov TEMP5,B
0667+  6E85~            		wvdp(B)
0668+  6E85~            		lda @box_pattern+5
0669+  6E85~            		wvdp(A)
0670+  6E85~            		movd TEMP4,R1
0671+  6E85~            		call @set_acmpxy
0672+  6E85~            		mov TEMP5,B
0673+  6E85~            		wvdp(B)
0674+  6E85~            		lda @box_pattern+5
0675+  6E85~            		wvdp(A)
0676+  6E85~            		djnz TEMP2-1,_rept2	
0677+  6E85~            	add %LENGTHLINE,TEMP3
0678+  6E85~            	adc %0,TEMP3-1
0679+  6E85~            	movd TEMP3,R1
0680+  6E85~            	call @set_acmpxy
0681+  6E85~            	mov TEMP5,B
0682+  6E85~            	wvdp(B)
0683+  6E85~            	lda @box_pattern+2
0684+  6E85~            	wvdp(A)
0685+  6E85~            	mov TEMP2,TEMP1
0686+  6E85~            _rept3
0687+  6E85~            		wvdp(B)		
0688+  6E85~            		lda @box_pattern+4
0689+  6E85~            		wvdp(A)
0690+  6E85~            		djnz TEMP1,_rept3
0691+  6E85~            	wvdp(B)
0692+  6E85~            	lda @box_pattern+3
0693+  6E85~            	wvdp(A)
0694+  6E85~            	pop B
0695+  6E85~            	pop A
0696+  6E85~            	rets
0697+  6E85             #ENDIF
0698+  6E85             	
0699+  6E85~            #IFDEF Fcls
0700+  6E85~            #DEFINE Fcalcul_pointer
0701+  6E85~            #DEFINE Fset_acmpxy
0702+  6E85~            ; Clear the active windows
0703+  6E85~            ; set the cursor position to (0,0)
0704+  6E85~            ; USED Registers :TEMP1-1,TEMP1
0705+  6E85~            ; USED Mem :WINDOW_H,WINDOW_W,ATRCAR
0706+  6E85~            ; DEPENDENCIES : locate
0707+  6E85~            	.MODULE mod_cls
0708+  6E85~            cls
0709+  6E85~            	push A
0710+  6E85~            	push B
0711+  6E85~            	lda @WINDOW_H
0712+  6E85~            	mov A,TEMP1
0713+  6E85~            	movd %$0000,R1
0714+  6E85~            	sta @XSX
0715+  6E85~            	sta @YSY
0716+  6E85~            	call @calcul_pointer
0717+  6E85~            _rept1
0718+  6E85~            	call @set_acmpxy
0719+  6E85~            	lda @WINDOW_W
0720+  6E85~            	mov A,B	
0721+  6E85~            _rept2
0722+  6E85~            			lda @ATRCAR
0723+  6E85~            			wvdp(A)
0724+  6E85~            			wvdp(%0)
0725+  6E85~            			djnz B,_rept2
0726+  6E85~            		add %LENGTHLINE,TEMP3
0727+  6E85~            		adc %0,TEMP3-1
0728+  6E85~            		movd TEMP3,R1
0729+  6E85~            		djnz TEMP1,_rept1
0730+  6E85~            	pop B
0731+  6E85~            	pop A	
0732+  6E85~            	rets
0733+  6E85             #ENDIF
0734+  6E85             
0735+  6E85~            #IFDEF Finput
0736+  6E85~            #DEFINE Fcalcul_pointer
0737+  6E85~            #DEFINE Fset_acmpxy
0738+  6E85~            #DEFINE Fscroll_up
0739+  6E85~            #DEFINE Fset_xy
0740+  6E85~            #DEFINE Fget_key
0741+  6E85~            ; interactive string input in the active window at the current position
0742+  6E85~            ; Use the current attribute character (except the flash attribute)
0743+  6E85~            ; All characters >+ $20 are displayed.
0744+  6E85~            ; The cursor position is fixed at the end of string.
0745+  6E85~            ; Backspace is managed during the user interacrion.
0746+  6E85~            ; IN :TEMP1 = adr to store entered string
0747+  6E85~            ; USED Registers :TEMP1-1,TEMP1,TEMP2-1,TEMP2,TEMP4-1,TEMP4,TEMP6-1,TEMP6
0748+  6E85~            ; USED Mem :WINDOW_H,WINDOW_W,XSX,YSY,ATRCAR
0749+  6E85~            ; DEPENDENCIES :backspace,get_key,scroll_up,calcul_pointer,set_acmpxy
0750+  6E85~            	.MODULE mod_input
0751+  6E85~            input
0752+  6E85~            	push A
0753+  6E85~            	push B
0754+  6E85~            	mov A,TEMP6
0755+  6E85~            	clr TEMP6-1
0756+  6E85~            	lda @ATRCAR
0757+  6E85~            	mov A,TEMP4-1
0758+  6E85~            	movd TEMP1,TEMP5
0759+  6E85~            	lda @XSX
0760+  6E85~            	mov A,B
0761+  6E85~            	lda @YSY
0762+  6E85~            	movd R1,TEMP2
0763+  6E85~            	call @calcul_pointer
0764+  6E85~            	call @set_acmpxy
0765+  6E85~            _rept1
0766+  6E85~            	mov TEMP4-1,B
0767+  6E85~            	wvdp(B)
0768+  6E85~            	wvdp(%32)
0769+  6E85~            _rept3	
0770+  6E85~            	call @get_key
0771+  6E85~            	cmp %$80,A
0772+  6E85~            	jhs _rept3
0773+  6E85~            	cmp %$0D,A
0774+  6E85~            	jeq _end_print
0775+  6E85~            	cmp %$08,A
0776+  6E85~            	jne _normal_car
0777+  6E85~            	call @backspace
0778+  6E85~            	jmp _rept1 
0779+  6E85~            _normal_car
0780+  6E85~            	cmp %$20,A
0781+  6E85~            	jn _rept3
0782+  6E85~            	cmp %0,TEMP6
0783+  6E85~            	jeq infinity_car
0784+  6E85~            	cmp TEMP6-1,TEMP6
0785+  6E85~            	jne infinity_car
0786+  6E85~            	jmp _rept3
0787+  6E85~            infinity_car	
0788+  6E85~            	inc TEMP6-1
0789+  6E85~            	sta *TEMP1
0790+  6E85~            	movd TEMP2,R1
0791+  6E85~            	call @calcul_pointer
0792+  6E85~            	call @set_acmpxy
0793+  6E85~            	inc TEMP2
0794+  6E85~            	lda *TEMP1
0795+  6E85~            	decd TEMP1
0796+  6E85~            	mov TEMP4-1,B
0797+  6E85~            	wvdp(B)
0798+  6E85~            	cmp %$20,A
0799+  6E85~            	jne _nospace
0800+  6E85~            	clr A
0801+  6E85~            _nospace	
0802+  6E85~            	wvdp(A)
0803+  6E85~            	lda @WINDOW_W
0804+  6E85~            	cmp TEMP2,A
0805+  6E85~            	jne _rept1
0806+  6E85~            _line_feed	
0807+  6E85~            	lda @WINDOW_H
0808+  6E85~            	dec A
0809+  6E85~            	cmp TEMP2-1,A
0810+  6E85~            	jne _end_line
0811+  6E85~            	call @scroll_up
0812+  6E85~            	lda @WINDOW_H
0813+  6E85~            	dec A
0814+  6E85~            	clr B
0815+  6E85~            	movd R1,TEMP2
0816+  6E85~            	call @set_xy
0817+  6E85~            	call @set_acmpxy
0818+  6E85~            	jmp _rept1
0819+  6E85~            _end_line
0820+  6E85~            	clr TEMP2
0821+  6E85~            	inc TEMP2-1
0822+  6E85~            	movd TEMP2,R1
