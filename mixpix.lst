5106   2CFC             
5107   2CFC                     ; --- ERREUR DE CONCEPTION CORRIGEE : entry_blocked ne testait
5108   2CFC                     ; qu'un mur a hauteur du corps, jamais la possibilite de GRIMPER en
5109   2CFC                     ; traversant -- un escalier qui deborde sur l'ecran suivant (voir
5110   2CFC                     ; le constructeur, qui lui traverse correctement) bloquait donc a
5111   2CFC                     ; tort tout AUTRE lemming l'abordant par la marche normale. On
5112   2CFC                     ; utilise desormais surface_find, EXACTEMENT le meme sondage qu'un
5113   2CFC                     ; pas normal sur le meme ecran. surface_find lit map_screen depuis
5114   2CFC                     ; lem_screen(cur_lem) : on le bascule donc TEMPORAIREMENT sur
5115   2CFC                     ; l'ecran vise, le temps du sondage uniquement.
5116   2CFC 8A C4 C1            lda     @cur_lem
5117   2CFF C0                  mov     A,B
5118   2D00 AA C5 3E            lda     @lem_screen(B)
5119   2D03 8B C7 E0            sta     @tmp_d                  ; ecran ACTUEL, a restaurer ensuite
5120   2D06 8A C4 C1            lda     @cur_lem
5121   2D09 C0                  mov     A,B
5122   2D0A 8A C6 C7            lda     @new_scr
5123   2D0D AB C5 3E            sta     @lem_screen(B)
