4179   269B 8B C4 C7            sta     @q_row                  ; pas fausser le calcul qui suit
4180   269E             
4181   269E                     ; --- efface sur DEUX rangees de tuiles (20 lignes) : B ET C ont
4182   269E                     ; toutes deux change d'etat, toutes deux doivent etre redessinees.
