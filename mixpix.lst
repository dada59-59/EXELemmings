0477+  6E85~            	lda @ATRCAR
0478+  6E85~            	btjo %$08,A,fin_wh
0479+  6E85~            	and %$FB,A
0480+  6E85~            	sta @ATRCAR
0481+  6E85~            	jmp set_wh
0482+  6E85             #ENDIF
0483+  6E85             	
0484+  6E85~            #IFDEF Fset_Dheigth
0485+  6E85~            #DEFINE Fset_wh
0486+  6E85~            ; set the double heigth size for next printing
0487+  6E85~            ; only heigth is changed, others attribute are unchanged
0488+  6E85~            ; This function is compatible with alphanumeric generator only !
0489+  6E85~            ; USED Mem :ATRCAR
0490+  6E85~            ; DEPENDENCIES : set_width_heigth
0491+  6E85~            set_Dheigth
