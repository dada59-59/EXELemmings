6136   33C4                     ; --- decalage de depart, explicite plutot que subi -----------------
6137   33C4                     ; Jusqu'ici, lem_tick/lem_pending du nouveau lemming n'etaient JAMAIS
6138   33C4                     ; remis a zero : leur compteur continuait simplement de tourner
6139   33C4                     ; depuis le demarrage du jeu (initialise par init_ticks). Comme les
6140   33C4                     ; NUM_LEM compteurs partent tous de 0 EN MEME TEMPS au lancement, et
6141   33C4                     ; que SPAWN_TICKS(200) mod LEM_STEP_DELAY(16) = 8 -- exactement la
6142   33C4                     ; moitie de 16 -- les naissances ne produisaient que DEUX groupes de
6143   33C4                     ; phase, pas dix : cinq lemmings devenaient "dus" au meme tick, et
6144   33C4                     ; leur redessin retardait tout le reste de cette passe de boucle, y
6145   33C4                     ; compris la lecture des touches -- meme loin du viseur.
6146   33C4                     ; Un decalage EXPLICITE, choisi dans une table plutot que subi,
6147   33C4                     ; garantit qu'au plus UN lemming devient du par tick.
6148   33C4 8A C4 C9            lda     @spawn_next
6149   33C7 C0                  mov     A,B
6150   33C8 AA 36 05            lda     @lem_tick_init(B)
6151   33CB AB C7 B9            sta     @lem_tick(B)
6152   33CE B5                  clr     A
6153   33CF AB C7 C3            sta     @lem_pending(B)
6154   33D2                     ; --- position de naissance : point de depart choisi dans EXELTILE
6155   33D2                     ; (LV_SPAWN_COL/LV_SPAWN_Y), plus le "colonne 2, ligne 60" fixe
6156   33D2                     ; d'avant -- chaque niveau a son propre point de chute, ce n'est
6157   33D2                     ; ni une tuile speciale ni un attribut de tuile.
