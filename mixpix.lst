2096   1762 D0 14               mov     A,TEMP4
2097   1764 8A C4 C1            lda     @cur_lem
2098   1767 C0                  mov     A,B
2099   1768 AA C5 20            lda     @lem_xseg(B)
2100   176B 1D 14               cmp     TEMP4,A
2101   176D E7 01               jnc     @ceo_y1
2102   176F 0A                  rets                            ; viseur entierement a gauche
2103   1770             ceo_y1:
2104   1770 8A C4 C1            lda     @cur_lem
2105   1773 C0                  mov     A,B
2106   1774 AA C5 2A            lda     @lem_y(B)
2107   1777 28 0A               add     %LEM_HLINES,A
2108   1779 D0 14               mov     A,TEMP4
2109   177B 8A C4 07            lda     @cur_y
2110   177E 1D 14               cmp     TEMP4,A
2111   1780 E7 01               jnc     @ceo_y2
2112   1782 0A                  rets                            ; viseur entierement en dessous
2113   1783             ceo_y2:
2114   1783 8A C4 07            lda     @cur_y
2115   1786 28 10               add     %CUR_H_LINES,A
2116   1788 D0 14               mov     A,TEMP4
2117   178A 8A C4 C1            lda     @cur_lem
2118   178D C0                  mov     A,B
2119   178E AA C5 2A            lda     @lem_y(B)
2120   1791 1D 14               cmp     TEMP4,A
2121   1793 E7 01               jnc     @ceo_draw
2122   1795 0A                  rets                            ; viseur entierement au-dessus
2123   1796             ceo_draw:
2124   1796 8E 1D 72            call    @lem_draw               ; ils se touchent : on le remet
2125   1799 0A                  rets
2126   179A             
2127   179A             ; --- dessine le viseur par-dessus l'ecran actuel --------------------------
2128   179A             ; Une ligne du viseur = 2 segments x 3 plans = 6 octets, lus, composes et
2129   179A             ; reecrits un par un en alternance (voir cd_line) : un seul positionnement
2130   179A             ; des pointeurs VDP par ligne, et aucun tampon intermediaire.
2131   179A             cur_draw:
2132   179A B5                  clr     A
2133   179B 8B C4 0B            sta     @cl_ctr
2134   179E             cd_line:
2135   179E                     ; UNE seule programmation de pointeur par ligne, au lieu de deux.
2136   179E                     ; setRWxy arme la lecture ET l'ecriture sur la meme adresse ; les
2137   179E                     ; deux pointeurs avancent ensuite en parallele, donc la reecriture
2138   179E                     ; ci-dessous tombe pile sur les octets qu'on vient de lire, sans
2139   179E                     ; avoir a se repositionner. C'est le pattern documente pour le
2140   179E                     ; lire-modifier-reecrire sur les trois plans (quickref VDP 5.1.1).
2141   179E                     ; Sur les 16 lignes du viseur : 16 programmations au lieu de 32.
2142   179E 8E 16 D1            call    @cur_addr               ; tv = debut de la ligne du viseur
2143   17A1 8A C4 05            lda     @tv_lo
2144   17A4 C0                  mov     A,B
2145   17A5 8A C4 04            lda     @tv_hi
2146   17A8 8E 14 F5            call    @setRWxy
2147   17AB             
2148   17AB                     ; --- lire-composer-reecrire ENTRELACE, sans tampon : LVDP lit un
2149   17AB                     ; octet (pointeur lecture), on y ajoute le motif, MOVP A,P46 le
2150   17AB                     ; reecrit a la meme adresse (pointeur ecriture) ; les deux pointeurs
2151   17AB                     ; avancent en parallele. C'est le motif de la routine ROM $F932
2152   17AB                     ; (quickref VDP 5.1.1, et commentaire de setRWxy ci-dessus).
2153   17AB                     ; L'ancienne version lisait d'abord les 6 octets dans cur_ln (index
2154   17AB                     ; tenu en SRAM), puis les relisait pour les reecrire : ~1330 cycles
2155   17AB                     ; par ligne, soit ~8,7 ms pour les 16 lignes -- presque un tick
2156   17AB                     ; entier a chaque dessin du viseur. Ici, deroule : ~360 par ligne.
2157   17AB 8A C4 0B            lda     @cl_ctr                 ; --- motifs de cette ligne
2158   17AE C0                  mov     A,B
2159   17AF AA 17 F1            lda     @cur_bmp_l(B)
2160   17B2 D0 1A               mov     A,TEMP7                 ; segment gauche
2161   17B4 AA 18 01            lda     @cur_bmp_r(B)
2162   17B7 D0 1C               mov     A,TEMP8                 ; segment droit
2163   17B9             
2164   17B9 D7 24               lvdp                            ; segment gauche : plan Bleu
2165   17BB 14 1A               or      TEMP7,A
2166   17BD 82 2E               movp    A,P46
2167   17BF D7 24               lvdp                            ; plan Vert
2168   17C1 14 1A               or      TEMP7,A
2169   17C3 82 2E               movp    A,P46
2170   17C5 D7 24               lvdp                            ; plan Rouge
2171   17C7 14 1A               or      TEMP7,A
2172   17C9 82 2E               movp    A,P46
2173   17CB D7 24               lvdp                            ; segment droit : plan Bleu
2174   17CD 14 1C               or      TEMP8,A
2175   17CF 82 2E               movp    A,P46
2176   17D1 D7 24               lvdp                            ; plan Vert
2177   17D3 14 1C               or      TEMP8,A
