3578   232C C0                  mov     A,B
3579   232D AA C5 20            lda     @lem_xseg(B)
3580   2330 8D C6 B6            cmpa    @blk_col
3581   2333 E6 27               jne     @ba_next                ; pas dans la colonne visee
3582   2335                     ; recouvrement vertical : les deux sprites font LEM_HLINES de haut
3583   2335 8A C6 BA            lda     @blk_i
3584   2338 C0                  mov     A,B
3585   2339 AA C5 2A            lda     @lem_y(B)
3586   233C 28 0A               add     %LEM_HLINES,A
3587   233E D0 14               mov     A,TEMP4
3588   2340 8A C6 B9            lda     @blk_y
3589   2343 1D 14               cmp     TEMP4,A
3590   2345 E3 15               jc      @ba_next                ; marcheur entierement en dessous
3591   2347 8A C6 B9            lda     @blk_y
3592   234A 28 0A               add     %LEM_HLINES,A
3593   234C D0 14               mov     A,TEMP4
3594   234E 8A C6 BA            lda     @blk_i
3595   2351 C0                  mov     A,B
3596   2352 AA C5 2A            lda     @lem_y(B)
3597   2355 1D 14               cmp     TEMP4,A
3598   2357 E3 03               jc      @ba_next                ; entierement au-dessus
3599   2359 22 01               mov     %1,A
3600   235B 0A                  rets                            ; bloque
3601   235C             ba_next:
