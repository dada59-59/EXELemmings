1123   123A             ml_chk_dig:
1124   123A                     ; --- touches de pouvoir (C D H B F E), cherchees dans skill_key_uc/lc,
1125   123A                     ; dans l'ordre du panneau. Une touche directe SELECTIONNE le pouvoir
1126   123A                     ; (surbrillance) ET l'attribue aussitot au lemming sous le viseur,
1127   123A                     ; comme avant. Pas de repetition : maintenir la touche redesignerait
1128   123A                     ; un lemming a chaque tick. cmpa ne touche pas A : la touche reste
1129   123A                     ; disponible pour les tests suivants.
1130   123A 52 08               mov     %NUM_SKILLS,B
1131   123C             mcs_loop:
1132   123C AD 3A 1F            cmpa    @skill_key_uc-1(B)
1133   123F E2 0A               jeq     @mcs_hit
1134   1241 AD 3A 27            cmpa    @skill_key_lc-1(B)
1135   1244 E2 05               jeq     @mcs_hit
1136   1246 CA F4               djnz    B,@mcs_loop
1137   1248 8C 12 5E            br      @ml_chk_tab
1138   124B             mcs_hit:
1139   124B 8A C5 17            lda     @rpt_flag
1140   124E E2 03               jeq     @mcs_go
1141   1250 8C 12 CF            br      @ml_next
1142   1253             mcs_go:
1143   1253 C2                  dec     B                       ; index 0..5
1144   1254 62                  mov     B,A
1145   1255 8E 34 7D            call    @skill_select
1146   1258 8E 34 05            call    @skill_use
1147   125B 8C 12 CF            br      @ml_next
1148   125E             
