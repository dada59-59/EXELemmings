0959   115B             ; BOUCLE : une seule touche testee, R, pour redessiner tout le decor et
0960   115B             ; observer la vitesse a l'oeil (ou au chronometre, sur machine reelle).
0961   115B             ; ============================================================================
0962   115B             main_loop:
0963   115B                     ; --- attend le PROCHAIN tick de l'horloge materielle.
0964   115B                     ; Le temps ecoule ne depend plus du travail effectue : si une image
0965   115B                     ; a demande beaucoup de dessin, l'attente est simplement plus
0966   115B                     ; courte, et la cadence reste la meme. C'est ce qui empeche le
0967   115B                     ; lemming de ralentir quand on deplace le viseur.
0968   115B             ml_wait:
0969   115B 8A C5 18            lda     @tick_cnt
0970   115E 8D C5 19            cmpa    @tick_seen
0971   1161 E2 F8               jeq     @ml_wait                ; rien de nouveau : on patiente
0972   1163             
0973   1163                     ; --- souris : lue ICI, UNE SEULE FOIS par passage reel dans
0974   1163                     ; main_loop -- surtout PAS depuis mc_key, qui est rÃ©-exÃ©cutÃ© Ã 
0975   1163                     ; chaque tour de la boucle de rattrapage ci-dessous. Le protocole
0976   1163                     ; P49/P50 (voir read_mouse) coute plusieurs ticks a lui seul ; le
0977   1163                     ; appeler depuis mc_key faisait avancer tick_cnt PENDANT le
0978   1163                     ; rattrapage lui-meme, qui ne finissait donc jamais -- lem_step_all
0979   1163                     ; (dans la section "rendu" plus bas) n'etait plus jamais atteint
0980   1163                     ; tant que la souris bougeait : les lemmings restaient figes.
0981   1163                     ; Ici, le cout est paye UNE fois par passage, puis absorbe comme
0982   1163                     ; n'importe quel autre tick ecoule -- rien n'est perdu, exactement
0983   1163                     ; le principe deja explique ci-dessous pour le viseur au clavier.
0984   1163 8A C7 E3            lda     @mouse_enabled
0985   1166 E2 03               jeq     @ml_consume
0986   1168 8E 14 1F            call    @check_mouse
0987   116B             
0988   116B                     ; --- On consomme les ticks ecoules UN PAR UN, et cette boucle ne
0989   116B                     ; dessine rien : elle ne fait qu'avancer des compteurs.
0990   116B                     ; L'ancienne version recopiait tick_cnt dans tick_seen d'un seul
0991   116B                     ; coup ; si un deplacement du viseur avait dure trois ticks, deux
0992   116B                     ; etaient purement PERDUS et le lemming ne comptait qu'un pas --
0993   116B                     ; d'ou le ralentissement. Ici rien ne se perd : le temps de jeu
0994   116B                     ; suit le temps reel, quel que soit le cout du dessin.
0995   116B             ml_consume:
0996   116B 8A C5 19            lda     @tick_seen
0997   116E B3                  inc     A
0998   116F 8B C5 19            sta     @tick_seen
0999   1172 8A C7 E7            lda     @pass_ticks             ; duree de CE passage, en ticks :
1000   1175 B3                  inc     A                       ; sert a faire avancer le viseur au
1001   1176 8B C7 E7            sta     @pass_ticks             ; rythme du temps reel (cur_arrow_steps)
1002   1179             
1003   1179                     ; Chaque lemming a SON PROPRE compteur (voir la note a la
1004   1179                     ; declaration de lem_tick) : celui qui atteint LEM_STEP_DELAY est
1005   1179                     ; marque pending, les autres continuent d'accumuler sans etre
1006   1179                     ; concernes -- c'est ce qui les etale dans le temps.
1007   1179 B5                  clr     A
1008   117A 8B C7 CD            sta     @tk_i
1009   117D             tk_loop:
1010   117D 8A C7 CD            lda     @tk_i
1011   1180 C0                  mov     A,B
1012   1181 AA C7 B9            lda     @lem_tick(B)
1013   1184 B3                  inc     A
1014   1185 2D 10               cmp     %LEM_STEP_DELAY,A
1015   1187 E6 0C               jne     @tk_no
1016   1189 B5                  clr     A
1017   118A AB C7 B9            sta     @lem_tick(B)
1018   118D 22 01               mov     %1,A
1019   118F AB C7 C3            sta     @lem_pending(B)         ; son pas sera fait apres la boucle
1020   1192 8C 11 98            br      @tk_next
1021   1195             tk_no:
1022   1195 AB C7 B9            sta     @lem_tick(B)
1023   1198             tk_next:
1024   1198 8A C7 CD            lda     @tk_i
1025   119B B3                  inc     A
1026   119C 8B C7 CD            sta     @tk_i
1027   119F 2D 0A               cmp     %NUM_LEM,A
1028   11A1 E6 DA               jne     @tk_loop
1029   11A3             mc_spawn:
1030   11A3 8A C4 C2            lda     @spawn_timer            ; naissance d'un lemming toutes les
1031   11A6 E2 10               jeq     @mc_key                 ; SPAWN_TICKS (2 s)
1032   11A8 B2                  dec     A
1033   11A9 8B C4 C2            sta     @spawn_timer
1034   11AC E6 0A               jne     @mc_key
1035   11AE 22 01               mov     %1,A
1036   11B0 8B C5 1B            sta     @spawn_pending          ; a traiter apres la boucle, comme
1037   11B3 22 C8               mov     %SPAWN_TICKS,A          ; le pas de marche : la boucle de
1038   11B5 8B C4 C2            sta     @spawn_timer            ; ticks ne dessine jamais
1039   11B8             mc_key:
1040   11B8 8A C5 16            lda     @key_rpt                ; le delai de repetition clavier se
1041   11BB E2 04               jeq     @mc_next                ; decompte lui aussi en temps reel
1042   11BD B2                  dec     A
1043   11BE 8B C5 16            sta     @key_rpt
1044   11C1             mc_next:
1045   11C1 8A C5 18            lda     @tick_cnt
1046   11C4 8D C5 19            cmpa    @tick_seen
1047   11C7 E6 A2               jne     @ml_consume             ; encore du retard : on rattrape
1048   11C9             
1049   11C9                     ; --- rendu : une seule fois, meme si plusieurs ticks ont ete
1050   11C9                     ; consommes. Un lemming en retard ne fait pas plusieurs pas d'un
1051   11C9                     ; coup : il avance d'un cran par passage, mais son horloge, elle,
1052   11C9                     ; n'a rien perdu.
1053   11C9 8A C5 1B            lda     @spawn_pending
1054   11CC E2 07               jeq     @mr_step
1055   11CE B5                  clr     A
1056   11CF 8B C5 1B            sta     @spawn_pending
1057   11D2 8E 33 87            call    @lem_spawn
1058   11D5             mr_step:
1059   11D5 8A C7 FC            lda     @mouse_act              ; boutons de la souris : traites ici,
1060   11D8 E2 03               jeq     @ml_key                 ; comme une touche
1061   11DA 8E 34 A5            call    @mouse_actions
1062   11DD                     ; Le pas des lemmings (lem_step_all) n'est plus fait ICI mais a
1063   11DD                     ; ml_next, APRES le clavier : voir la note a cet endroit.
1064   11DD             ml_key:
1065   11DD 12 03               mov     VALUE0,A
1066   11DF 8B C4 02            sta     @key_cur
1067   11E2 8D C4 03            cmpa    @key_last
1068   11E5 E6 15               jne     @ml_newkey              ; touche differente : on agit tout
1069   11E7                                                     ; de suite
1070   11E7                     ; Meme touche que l'image precedente : on ne rejoue l'action que
1071   11E7                     ; lorsque le compteur de repetition arrive a zero. C'est ce qui
1072   11E7                     ; permet de GARDER la touche enfoncee.
1073   11E7 8A C5 16            lda     @key_rpt                ; decompte par la boucle de ticks
1074   11EA E2 03               jeq     @ml_rpt_now             ; ci-dessus, plus ici
1075   11EC 8C 12 CF            br      @ml_next
1076   11EF             ml_rpt_now:
1077   11EF 22 01               mov     %KEY_RPT_NEXT,A
1078   11F1 8B C5 16            sta     @key_rpt
1079   11F4 22 01               mov     %1,A
1080   11F6 8B C5 17            sta     @rpt_flag
1081   11F9 8C 12 05            br      @ml_edge
1082   11FC             ml_newkey:
