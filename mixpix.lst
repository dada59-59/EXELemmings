3543   22E9             ; blocker_at -- un BLOQUEUR occupe-t-il la colonne blk_col, sur le meme
3544   22E9             ; ecran et a la meme hauteur que le lemming cur_lem ?
3545   22E9             ; Sortie : A != 0 si oui.
3546   22E9             ; Le lemming qui pose la question est evidemment exclu de la recherche.
3547   22E9             ; ============================================================================
3548   22E9             blocker_at:
3549   22E9 8A C4 C1            lda     @cur_lem
3550   22EC 8B C6 B7            sta     @blk_self
3551   22EF C0                  mov     A,B
3552   22F0 AA C5 3E            lda     @lem_screen(B)
3553   22F3 8B C6 B8            sta     @blk_scr
