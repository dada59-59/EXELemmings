0808   1049 88 37 3B 12         movd    %font_chr,TEMP3         ; codes $20..$60 : espace (vide),
0809   104D 88 68 00 10         movd    %FONT_BAGC3,TEMP2       ; ponctuation, chiffres, majuscules,
