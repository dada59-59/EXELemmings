0354+  0000             ; Keyboard / Joystick 1
0355+  0000             KEYUP					.EQU 128
0356+  0000             KEYRI					.EQU 129
0357+  0000             KEYDW					.EQU 130
0358+  0000             KEYLF					.EQU 131
0359+  0000             KEYUPRI				.EQU 79
0360+  0000             KEYDWRI				.EQU 72
0361+  0000             KEYUPLF				.EQU 84
0362+  0000             KEYDWLF				.EQU 60
0363+  0000             FIRE					.EQU 32
0364+  0000             FIRE2					.EQU 95
0365+  0000             FIRE3					.EQU 71
0366+  0000             FIRE4					.EQU 78
0367+  0000             HOME					.EQU 133
0368+  0000             SHIFT					.EQU 134
0369+  0000             CAPSLOCK			.EQU 135
0370+  0000             FNCT					.EQU 136
0371+  0000             CTRL					.EQU 137
0372+  0000             TAB						.EQU 9
0373+  0000             DELETE				.EQU 8
0374+  0000             ESC						.EQU 27
0375+  0000             RETURN				.EQU 13
0376+  0000             
0377+  0000             #endif0088   0000             #include "3556.equ"
0001+  0000             #ifndef VDP3556
0002+  0000             #define VDP3556
0003+  0000             
0004+  0000             ; Foreground colors for character generator
0005+  0000             FBLACK		.EQU 00000000b
0006+  0000             FRED			.EQU 00100000b
0007+  0000             FGREEN		.EQU 01000000b
0008+  0000             FYELLOW		.EQU 01100000b
0009+  0000             FBLUE			.EQU 10000000b
0010+  0000             FMAGENTA	.EQU 10100000b
0011+  0000             FCYAN			.EQU 11000000b
0012+  0000             FWHITE		.EQU 11100000b
0013+  0000             ; Background colors for Alphamosaic character generator
0014+  0000             BBLACK		.EQU 00000000b
0015+  0000             BRED			.EQU 00000001b
0016+  0000             BGREEN		.EQU 00000010b
0017+  0000             BYELLOW		.EQU 00000011b
0018+  0000             BBLUE			.EQU 00000100b
0019+  0000             BMAGENTA	.EQU 00000101b
0020+  0000             BCYAN			.EQU 00000110b
0021+  0000             BWHITE		.EQU 00000111b
0022+  0000             ; Character generator selector
0023+  0000             BAGC0			.EQU 00000000b
0024+  0000             BAGC1			.EQU 00010000b
0025+  0000             BAGC2			.EQU 00001000b
0026+  0000             BAGC3			.EQU 00011000b
0027+  0000             ; Flashing mode for character
0028+  0000             FLS				.EQU 10000000b
0029+  0000             NOFLS			.EQU 00000000b
0030+  0000             ; Character attribute for Alphamosaic generator
0031+  0000             INVERSE		.EQU 00000100b
0032+  0000             NOINVERSE	.EQU 00000000b
0033+  0000             NSIZE			.EQU 00000000b
0034+  0000             DWSIZE		.EQU 00000001b
0035+  0000             DHSIZE		.EQU 00000010b
0036+  0000             DHWSIZE		.EQU 00000011b
0037+  0000             ; Marge colors for mapping and mixte mode
0038+  0000             MBLACK		.EQU 00000000b
0039+  0000             MRED			.EQU 00100000b
0040+  0000             MGREEN		.EQU 01000000b
0041+  0000             MYELLOW		.EQU 01100000b
0042+  0000             MBLUE			.EQU 10000000b
0043+  0000             MMAGENTA	.EQU 10100000b
0044+  0000             MCYAN			.EQU 11000000b
0045+  0000             MWHITHE		.EQU 11100000b
0046+  0000             ; Background color of the next text line in mixte mode
0047+  0000             BNEXTL		.EQU 00000100b
0048+  0000             NOBNEXTL	.EQU 00000000b
0049+  0000             ; Line length
0050+  0000             TEXTLEN		.EQU 80
0051+  0000             MIXTLEN		.EQU 82
0052+  0000             MAPPLEN		.EQU 122
0053+  0000             
0054+  0000             ; VDP 8 bits register numbers
0055+  0000             POINTER		.EQU 0
0056+  0000             COL				.EQU 1
0057+  0000             ROW				.EQU 2
0058+  0000             VDPSTATUS	.EQU 3
0059+  0000             TIMEBASE	.EQU 4
0060+  0000             DECODER		.EQU 5
0061+  0000             SCRMODE		.EQU 6
0062+  0000             BORDER		.EQU 7
0063+  0000             ; VDP 16 bits usefull register numbers
0064+  0000             REGBAMT			.EQU 8
0065+  0000             REGBAMP			.EQU 9
0066+  0000             REGBAPA			.EQU 10
0067+  0000             REGBAGC0		.EQU 11
0068+  0000             BEGBAGC1		.EQU 12
0069+  0000             REGBAGC2		.EQU 13
0070+  0000             REGBAGC3		.EQU 14
0071+  0000             REGBAMTF		.EQU 15
0072+  0000             
0073+  0000             ; Status register bits
0074+  0000             FRAMESYNC	.EQU 01000000b
0075+  0000             VERTSYNC	.EQU 00100000b
0076+  0000             HORSYNC		.EQU 00000100b
0077+  0000             ; CM1 Time Base register for Exl100
0078+  0000             CM1MASK		.EQU 00010000b
0079+  0000             
0080+  0000             ; CM2 Decoder register bits
0081+  0000             CM2MASK			.EQU 10000000b
0082+  0000             LINEZERO		.EQU 01000000b
0083+  0000             BAGC3MOSAIC	.EQU 00001000b
0084+  0000             BAGC3ALPHA	.EQU 00000000b
0085+  0000             
0086+  0000             ; CM3 Screen Mode register bits
0087+  0000             CM3MASK			.EQU 00001000b
0088+  0000             NODISPLAY		.EQU 00000000b
0089+  0000             TEXTMODE		.EQU 01000000b
0090+  0000             MAPPMODE		.EQU 10000000b
0091+  0000             MIXTMODE		.EQU 11000000b
0092+  0000             
